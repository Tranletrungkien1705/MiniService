@{
    string Nav(string c) => (ViewContext.RouteData.Values["controller"]?.ToString() == c) ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — MiniService</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root { --accent:#1d4ed8; --accent2:#1e40af; --sidebar:#0b1531; }
        body { font-size:14px; background:#f2f5fb; font-family:"Be Vietnam Pro",sans-serif; -webkit-font-smoothing:antialiased; }
        .sidebar { width:232px; min-height:100vh; background:var(--sidebar); flex-shrink:0; }
        .sidebar .brand { color:#fff; font-weight:800; font-size:18px; padding:20px 18px 12px; display:flex; align-items:center; gap:9px; }
        .sidebar .brand span { color:#93c5fd; }
        .sidebar .nav-link { color:#97a4c4; padding:9px 18px; display:flex; align-items:center; gap:10px; font-size:14px; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { color:#fff; background:rgba(29,78,216,.32); border-left:3px solid var(--accent); }
        .sidebar .nav-section { font-size:10px; letter-spacing:2px; text-transform:uppercase; color:#4a5578; padding:14px 18px 4px; }
        .topbar { background:#fff; border-bottom:1px solid #e4e8f2; padding:11px 24px; }
        .content-area { padding:24px; }
        .card { border:none; box-shadow:0 1px 4px rgba(2,10,40,.07); border-radius:13px; }
        .btn-primary { background:var(--accent); border-color:var(--accent); } .btn-primary:hover { background:var(--accent2); border-color:var(--accent2); }
        .btn-outline-primary { color:var(--accent); border-color:var(--accent); } .btn-outline-primary:hover { background:var(--accent); color:#fff; }
        a { color:var(--accent2); }
        table th { font-size:11.5px; text-transform:uppercase; letter-spacing:.4px; color:#6b7280; border-bottom:2px solid #e5e7eb; }
        .stat-num { font-size:26px; font-weight:800; }
        .step { display:flex; align-items:center; gap:6px; }
    </style>
</head>
<body>
<div class="d-flex">
    <nav class="sidebar d-flex flex-column">
        <div class="brand"><i class="bi bi-tools"></i> Mini<span>Service</span></div>
        <div class="mt-1">
            <div class="nav-section">Tổng quan</div>
            <a class="nav-link @(Nav("Home"))" href="/"><i class="bi bi-speedometer2"></i> Bảng điều khiển</a>
            <div class="nav-section">Xưởng dịch vụ</div>
            <a class="nav-link @(Nav("Appointment"))" href="/Appointment"><i class="bi bi-calendar2-check"></i> Đặt lịch hẹn</a>
            <a class="nav-link @(Nav("Reception"))" href="/Reception"><i class="bi bi-card-checklist"></i> Tiếp nhận xe (Reception)</a>
            <a class="nav-link @(Nav("Cavity"))" href="/Cavity"><i class="bi bi-grid-3x3-gap"></i> Khoang sửa chữa (Bays)</a>
            <a class="nav-link @(Nav("AssignmentWork"))" href="/AssignmentWork"><i class="bi bi-person-gear"></i> Phân công thợ (Assignments)</a>
            <a class="nav-link @(Nav("RO"))" href="/RO"><i class="bi bi-clipboard2-pulse"></i> Lệnh sửa chữa (RO)</a>
            <a class="nav-link" href="/RO/Create"><i class="bi bi-plus-square"></i> Tiếp nhận xe</a>
            <a class="nav-link @(Nav("ServiceItem"))" href="/ServiceItem"><i class="bi bi-wrench-adjustable"></i> Định mức công việc (Labor Ops)</a>
            <a class="nav-link @(Nav("ServicePackage"))" href="/ServicePackage"><i class="bi bi-collection"></i> Gói bảo dưỡng (Packages)</a>
            <a class="nav-link @(Nav("Quote"))" href="/Quote"><i class="bi bi-file-earmark-text"></i> Báo giá (Quote)</a>
            <a class="nav-link @(Nav("Payment"))" href="/Payment"><i class="bi bi-cash-coin"></i> Phiếu thu (Payment)</a>
            <a class="nav-link @(Nav("CusDebit"))" href="/CusDebit"><i class="bi bi-wallet2"></i> Công nợ khách hàng (Debits)</a>
            <a class="nav-link @(Nav("SupplierDebit"))" href="/SupplierDebit"><i class="bi bi-cash-stack"></i> Công nợ NCC (Payables)</a>
            <a class="nav-link @(Nav("InsuranceDebit"))" href="/InsuranceDebit"><i class="bi bi-shield-shaded"></i> Công nợ Bảo hiểm (Ins. Debits)</a>
            <a class="nav-link @(Nav("Campaign"))" href="/Campaign"><i class="bi bi-megaphone"></i> Chiến dịch CSKH (Campaigns)</a>
            <a class="nav-link @(Nav("CustomerCare"))" href="/CustomerCare"><i class="bi bi-headset"></i> CSKH 24h (Customer Care)</a>
            <a class="nav-link @(Nav("CareMace"))" href="/CareMace"><i class="bi bi-bell"></i> Nhắc bảo dưỡng (Care Mace)</a>
            <a class="nav-link @(Nav("Warranty"))" href="/Warranty"><i class="bi bi-shield-check"></i> Bảo hành (Warranty)</a>
            <a class="nav-link @(Nav("Bulletin"))" href="/Bulletin"><i class="bi bi-file-earmark-check"></i> Bản tin kỹ thuật (TSB)</a>
            <a class="nav-link @(Nav("TechnicalLibrary"))" href="/TechnicalLibrary"><i class="bi bi-journal-bookmark"></i> Thư viện kỹ thuật (Tech Lib)</a>
            <a class="nav-link @(Nav("Pdi"))" href="/Pdi"><i class="bi bi-car-front-fill"></i> Kiểm tra PDI (Pre-Delivery)</a>
            <a class="nav-link @(Nav("Insurance"))" href="/Insurance"><i class="bi bi-shield-shaded"></i> Hồ sơ bảo hiểm (Insurance)</a>
            <div class="nav-section">Kho phụ tùng</div>
            <a class="nav-link @(Nav("Part"))" href="/Part"><i class="bi bi-box-seam"></i> Danh mục &amp; Tồn kho</a>
            <a class="nav-link @(Nav("PartOO"))" href="/PartOO"><i class="bi bi-clock-history"></i> Phụ tùng nợ khách (Part OO)</a>
            <a class="nav-link @(Nav("OrderPart"))" href="/OrderPart"><i class="bi bi-cart-check"></i> Đặt hàng phụ tùng</a>
            <a class="nav-link @(Nav("PartPriceRequest"))" href="/PartPriceRequest"><i class="bi bi-tag"></i> Đề nghị báo giá NCC (Req Price)</a>
            <a class="nav-link @(Nav("OrderComplain"))" href="/OrderComplain"><i class="bi bi-exclamation-octagon"></i> Khiếu nại phụ tùng NCC</a>
            <a class="nav-link @(Nav("StockIn"))" href="/StockIn"><i class="bi bi-box-arrow-in-down"></i> Nhập kho phụ tùng</a>
            <a class="nav-link @(Nav("StockOutOrder"))" href="/StockOutOrder"><i class="bi bi-file-earmark-arrow-up"></i> Yêu cầu xuất kho (SOO)</a>
            <a class="nav-link @(Nav("StockOut"))" href="/StockOut"><i class="bi bi-box-arrow-up-right"></i> Xuất kho phụ tùng</a>
            <a class="nav-link @(Nav("SupplierPayment"))" href="/SupplierPayment"><i class="bi bi-box-arrow-left"></i> Xuất trả NCC (Return)</a>
            <a class="nav-link @(Nav("StockAdj"))" href="/StockAdj"><i class="bi bi-clipboard-check"></i> Kiểm kê &amp; Điều chuyển</a>
            <div class="nav-section">Khách hàng &amp; Xe</div>
            <a class="nav-link @(Nav("DealerHistory"))" href="/DealerHistory"><i class="bi bi-clock-history"></i> Lịch sử sửa chữa (Dealer History)</a>
            <a class="nav-link @(Nav("CustomerGroup"))" href="/CustomerGroup"><i class="bi bi-buildings"></i> Quản lý khách đoàn (Fleet)</a>
            <a class="nav-link @(Nav("Customer"))" href="/Customer"><i class="bi bi-people"></i> Khách hàng</a>
            <a class="nav-link @(Nav("Car"))" href="/Car"><i class="bi bi-car-front"></i> Xe</a>
            <div class="nav-section">Hệ thống</div>
            <a class="nav-link @(Nav("Org"))" href="/Org"><i class="bi bi-building"></i> Đại lý</a>
        </div>
        <div class="mt-auto p-3" style="color:#4a5578;font-size:11px">Repair Order · state machine · demo</div>
    </nav>
    <div class="main-content flex-fill" style="overflow-x:hidden">
        <div class="topbar d-flex align-items-center justify-content-between">
            <h6 class="mb-0 fw-bold">@ViewData["Title"]</h6>
            <a href="/Org" class="text-muted small text-decoration-none"><i class="bi bi-building me-1"></i>@(Context.Request.Cookies["org_name"] ?? "Demo Service")</a>
        </div>
        <div class="content-area">
            @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]<button class="btn-close" data-bs-dismiss="alert"></button></div> }
            @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]<button class="btn-close" data-bs-dismiss="alert"></button></div> }
            @RenderBody()
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
