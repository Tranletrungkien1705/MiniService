@model List<Customer>
@{ ViewData["Title"] = "Khách hàng"; }
<div class="row g-3">
    <div class="col-lg-5"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Thêm khách hàng + xe</h6>
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-2"><input name="name" class="form-control" placeholder="Tên khách hàng *" required /></div>
            <div class="row g-2 mb-2">
                <div class="col-6"><input name="phone" class="form-control" placeholder="SĐT" /></div>
                <div class="col-6"><input name="email" type="email" class="form-control" placeholder="Email" /></div>
            </div>
            <hr class="my-2" /><div class="small text-muted mb-2">Xe (tùy chọn)</div>
            <div class="row g-2 mb-2">
                <div class="col-6"><input name="plate" class="form-control" placeholder="Biển số" /></div>
                <div class="col-6"><input name="year" type="number" class="form-control" placeholder="Năm SX" /></div>
            </div>
            <div class="row g-2 mb-3">
                <div class="col-7"><input name="model" class="form-control" placeholder="Mẫu xe (Hyundai...)" /></div>
                <div class="col-5"><input name="vin" class="form-control" placeholder="VIN" /></div>
            </div>
            <button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Lưu</button>
        </form>
    </div></div></div>
    <div class="col-lg-7"><div class="card"><div class="card-body">
        <form method="get" class="mb-3"><input name="q" value="@ViewBag.Q" class="form-control form-control-sm" placeholder="Tìm tên / SĐT..." /></form>
        <table class="table table-hover align-middle">
            <thead><tr><th>Mã</th><th>Khách hàng</th><th>SĐT</th><th>Xe</th></tr></thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr><td class="fw-semibold">@c.Code</td><td>@c.Name</td><td class="small">@c.Phone</td>
                    <td class="small text-muted">@string.Join(", ", c.Cars.Select(x => x.Plate))</td></tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-4">Chưa có khách hàng.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
</div>
