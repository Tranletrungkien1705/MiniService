@model PartOO
@{
    Layout = null;
    var part = Model.Part;
    var (stText, stCode, _) = Ui.PartOOStatus(Model.Status);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>In Phiếu Nợ Phụ Tùng - @Model.OONo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { font-family: "Segoe UI", Arial, sans-serif; font-size: 13.5px; color: #111; background: #f8f9fa; }
        .print-container { max-width: 820px; margin: 20px auto; background: #fff; padding: 35px 40px; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
        .voucher-title { font-size: 20px; font-weight: 800; letter-spacing: 0.5px; }
        .meta-box { background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 6px; padding: 12px 16px; }
        .table-bordered th, .table-bordered td { border-color: #333 !important; }
        .sig-block { min-height: 80px; }
        @@media print {
            body { background: #fff; margin: 0; }
            .print-container { box-shadow: none; padding: 0; margin: 0; max-width: 100%; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body>
    <div class="no-print text-center py-3 bg-dark text-white d-flex justify-content-center gap-3">
        <button onclick="window.print()" class="btn btn-primary btn-sm px-4 fw-bold">
            <i class="bi bi-printer"></i> In phiếu ngay
        </button>
        <button onclick="window.close()" class="btn btn-secondary btn-sm px-3">
            Đóng cửa sổ
        </button>
    </div>

    <div class="print-container">
        <!-- Header Đại lý -->
        <div class="row align-items-center mb-3 pb-3 border-bottom border-2 border-dark">
            <div class="col-7">
                <div class="fw-bold fs-6 text-uppercase">TRUNG TÂM DỊCH VỤ Ô TÔ HYUNDAI CHÍNH HÃNG</div>
                <div class="small text-muted">Đại lý Ủy quyền Hyundai Thành Công Việt Nam (HTC)</div>
                <div class="small">Địa chỉ: Km 10, Quốc lộ 1A, Giải Phóng, Hà Nội</div>
                <div class="small">Hotline xưởng dịch vụ: <strong>024.3826.2614</strong> · CSKH: <strong>1900.561.212</strong></div>
            </div>
            <div class="col-5 text-end">
                <div class="fw-bold">Số phiếu: <span class="text-primary fs-6">@Model.OONo</span></div>
                <div class="small text-muted">Ngày lập: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                <div class="small">Trạng thái: <strong>[@stCode] @stText</strong></div>
                @if (Model.ROId.HasValue)
                {
                    <div class="small">Lệnh RO: <strong>@Model.RO?.Code</strong></div>
                }
            </div>
        </div>

        <!-- Tiêu đề chứng từ -->
        <div class="text-center my-4">
            <h4 class="voucher-title text-uppercase mb-1">PHIẾU BIÊN NHẬN NỢ PHỤ TÙNG &amp; GIẤY HẸN TRẢ VẬT TƯ</h4>
            <div class="fst-italic text-muted small">(Chứng từ theo dõi phụ tùng hết hàng / nợ khách hàng theo quy chuẩn dịch vụ Hyundai)</div>
        </div>

        <!-- Thông tin Khách hàng & Xe -->
        <div class="meta-box mb-4">
            <div class="row g-2">
                <div class="col-6">
                    <div>Chủ xe / Khách hàng: <strong>@(Model.Customer?.Name ?? "Khách hàng dịch vụ")</strong></div>
                    <div>Số điện thoại: <strong>@(Model.Customer?.Phone ?? "—")</strong></div>
                    <div>Biển số xe: <strong class="fs-6 border px-2 py-0 bg-white">@Model.OOPlateNo</strong></div>
                </div>
                <div class="col-6">
                    <div>Dòng xe / Model: <strong>@(Model.Model ?? "Hyundai")</strong></div>
                    <div>Cố vấn dịch vụ phụ trách: <strong>@(Model.CVDV ?? "CVDV xưởng")</strong></div>
                    <div>Ngày hẹn trả khách: <strong class="text-danger fs-6">@(Model.NgayHenTra?.ToString("dd/MM/yyyy") ?? "Chờ thông báo")</strong></div>
                </div>
            </div>
        </div>

        <!-- Bảng chi tiết phụ tùng nợ -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered table-sm align-middle text-center mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 40px;">STT</th>
                        <th style="width: 140px;">Mã phụ tùng</th>
                        <th class="text-start">Tên phụ tùng / Vật tư chính hãng</th>
                        <th style="width: 60px;">ĐVT</th>
                        <th style="width: 70px;">SL nợ</th>
                        <th style="width: 70px;">Đã trả</th>
                        <th style="width: 80px;">Còn nợ</th>
                        <th style="width: 110px;">Đơn giá</th>
                        <th style="width: 120px;">Thành tiền nợ</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td><code>@Model.PartCode</code></td>
                        <td class="text-start fw-semibold">@Model.PartName</td>
                        <td>@(part?.Unit ?? "Cái")</td>
                        <td class="fw-bold">@Model.SoLuongNo.ToString("N0")</td>
                        <td class="text-success">@Model.SoLuongTra.ToString("N0")</td>
                        <td class="fw-bold text-danger">@Model.SoLuongConNo.ToString("N0")</td>
                        <td class="text-end">@(part?.SalePrice.ToString("N0") ?? "0") đ</td>
                        <td class="text-end fw-bold">@Model.RemainingAmount.ToString("N0") đ</td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="6" class="text-end">Tổng số lượng phụ tùng còn nợ khách:</th>
                        <th class="text-danger">@Model.SoLuongConNo.ToString("N0")</th>
                        <th class="text-end">Tổng tiền nợ:</th>
                        <th class="text-end text-danger">@Model.RemainingAmount.ToString("N0") đ</th>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Cam kết & Thỏa thuận dịch vụ -->
        <div class="border rounded p-3 mb-4 bg-light">
            <h6 class="fw-bold text-dark mb-2"><i class="bi bi-shield-check me-1"></i>CAM KẾT DỊCH VỤ ĐẠI LÝ HYUNDAI:</h6>
            <ol class="small mb-0 ps-3">
                <li>Đại lý cam kết toàn bộ phụ tùng thay thế bù là phụ tùng chính hãng 100% do Hyundai Motor / Mobis cung cấp.</li>
                <li>Khách hàng được <strong>miễn phí 100% tiền công thợ</strong> khi mang xe vào xưởng để lắp ráp phụ tùng còn nợ theo phiếu này.</li>
                <li>Ngay khi phụ tùng về đến kho đại lý, Cố vấn dịch vụ sẽ trực tiếp gọi điện thông báo để Quý khách chủ động sắp xếp thời gian.</li>
                <li>Khi mang xe đến lắp phụ tùng, Quý khách vui lòng xuất trình phiếu hẹn này cho Cố vấn dịch vụ tiếp nhận.</li>
            </ol>
            @if (!string.IsNullOrWhiteSpace(Model.GhiChu))
            {
                <div class="small mt-2 pt-2 border-top">
                    <strong>Ghi chú bổ sung:</strong> @Model.GhiChu
                </div>
            }
        </div>

        <!-- Chữ ký các bên -->
        <div class="row text-center mt-5">
            <div class="col-4">
                <div class="fw-bold">KHÁCH HÀNG NHẬN PHIẾU</div>
                <div class="small text-muted fst-italic">(Ký và ghi rõ họ tên)</div>
                <div class="sig-block"></div>
                <div class="fw-semibold">@(Model.Customer?.Name ?? "")</div>
            </div>
            <div class="col-4">
                <div class="fw-bold">THỦ KHO PHỤ TÙNG</div>
                <div class="small text-muted fst-italic">(Ký và ghi rõ họ tên)</div>
                <div class="sig-block"></div>
                <div class="fw-semibold">Thủ kho Tuấn</div>
            </div>
            <div class="col-4">
                <div class="fw-bold">CỐ VẤN DỊCH VỤ</div>
                <div class="small text-muted fst-italic">(Ký và ghi rõ họ tên)</div>
                <div class="sig-block"></div>
                <div class="fw-semibold">@(Model.CVDV ?? "CVDV Tiếp nhận")</div>
            </div>
        </div>

        <div class="text-center text-muted small mt-5 pt-3 border-top fst-italic">
            Cảm ơn Quý khách đã tin tưởng và sử dụng Dịch vụ sửa chữa &amp; Bảo dưỡng chính hãng Hyundai!
        </div>
    </div>
</body>
</html>
