@{
    ViewData["Title"] = "Thêm Tham số hệ thống (System Parameter)";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a href="/SystemParam" class="text-decoration-none small text-muted"><i class="bi bi-arrow-left me-1"></i>Tham số hệ thống</a>
        <h5 class="mb-0 fw-bold mt-1"><i class="bi bi-sliders me-2 text-primary"></i>Thêm Tham số Mới (Mst_Param)</h5>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Mã tham số (ParamCode) <span class="text-danger">*</span></label>
                            <input name="paramCode" class="form-control font-monospace" placeholder="VD: PARAM_MAILFROM" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Mã đại lý (DealerCode) <span class="text-danger">*</span></label>
                            <input name="dealerCode" class="form-control font-monospace" placeholder="VD: VS058" style="text-transform:uppercase" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Nhóm tham số (ParamType) <span class="text-danger">*</span></label>
                            <select name="type" class="form-select">
                                @foreach (SystemParamType t in Enum.GetValues<SystemParamType>())
                                {
                                    <option value="@((int)t)">@Ui.SystemParamType(t).text</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Giá trị tham số (ParamValue)</label>
                            <textarea name="paramValue" class="form-control font-monospace" rows="3" placeholder="VD: no-reply@hyundai-vs058.vn"></textarea>
                        </div>
                    </div>
                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu tham số</button>
                        <a href="/SystemParam" class="btn btn-outline-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card shadow-sm border-0 bg-light">
            <div class="card-body">
                <div class="fw-semibold mb-2"><i class="bi bi-info-circle me-1 text-primary"></i>Nghiệp vụ nguồn</div>
                <ul class="small text-muted mb-0 ps-3">
                    <li>Bảng <span class="font-monospace">Mst_Param</span> lưu cấu hình hệ thống theo đại lý.</li>
                    <li>Khóa nghiệp vụ là cặp <span class="font-monospace">(DealerCode, ParamType)</span>.</li>
                    <li>Nguồn lưu ở CSDL trung tâm (CmCenter) và đồng bộ sang kho (WH) / đại lý (Dealer).</li>
                    <li>Nếu cặp khóa đã tồn tại, hệ thống cập nhật giá trị (upsert) thay vì tạo trùng.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
