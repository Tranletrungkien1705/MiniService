@model List<SystemParam>
@{
    ViewData["Title"] = "Tham số hệ thống (System Parameters)";
    var summary = ViewBag.Summary as SystemParamSummaryDto ?? new SystemParamSummaryDto();
    var dealers = ViewBag.Dealers as List<string> ?? [];
    var type = ViewBag.Type as SystemParamType?;
}
@functions {
    string TypeBadge(SystemParamType t)
    {
        var (text, code, css) = Ui.SystemParamType(t);
        return $"<span class=\"badge bg-{css}-subtle text-{css} border-{css}-subtle\">{text}</span>";
    }
}

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Tổng số tham số</div>
                <div class="stat-num text-primary">@summary.TotalParams</div>
                <div class="text-muted" style="font-size:11.5px">Bảng Mst_Param</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Đại lý áp dụng</div>
                <div class="stat-num text-success">@summary.DealerCount</div>
                <div class="text-muted" style="font-size:11.5px">Số đại lý (DealerCode)</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Nhóm tham số</div>
                <div class="stat-num text-warning">@summary.TypeCount</div>
                <div class="text-muted" style="font-size:11.5px">Số nhóm (ParamType)</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Chưa có giá trị</div>
                <div class="stat-num text-danger">@summary.EmptyValueCount</div>
                <div class="text-muted" style="font-size:11.5px">ParamValue rỗng</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <form method="get" class="d-flex align-items-center gap-2 flex-wrap">
                <div class="input-group input-group-sm" style="max-width:280px">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Mã tham số / giá trị..." />
                </div>
                <select name="dealerCode" class="form-select form-select-sm" style="width:180px" onchange="this.form.submit()">
                    <option value="">-- Đại lý --</option>
                    @foreach (var dc in dealers)
                    {
                        <option value="@dc" selected="@(ViewBag.DealerCode == dc)">@dc</option>
                    }
                </select>
                <select name="type" class="form-select form-select-sm" style="width:200px" onchange="this.form.submit()">
                    <option value="">-- Nhóm tham số --</option>
                    @foreach (SystemParamType t in Enum.GetValues<SystemParamType>())
                    {
                        <option value="@((int)t)" selected="@(type == t)">@Ui.SystemParamType(t).text</option>
                    }
                </select>
                <button type="submit" class="btn btn-sm btn-outline-secondary">Lọc</button>
                @if (!string.IsNullOrEmpty(ViewBag.Q as string) || !string.IsNullOrEmpty(ViewBag.DealerCode as string) || type.HasValue)
                {
                    <a href="/SystemParam" class="btn btn-sm btn-link text-decoration-none">Xóa lọc</a>
                }
            </form>
            <a href="/SystemParam/Create" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1"></i>Thêm tham số</a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:70px">ID</th>
                        <th>Mã tham số (ParamCode)</th>
                        <th style="width:200px">Nhóm (ParamType)</th>
                        <th>Giá trị (ParamValue)</th>
                        <th style="width:130px">Đại lý</th>
                        <th class="text-end" style="width:90px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block mb-1 text-secondary"></i>
                                Không tìm thấy tham số nào phù hợp điều kiện lọc.
                            </td>
                        </tr>
                    }
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="font-monospace text-secondary">@p.Id</td>
                            <td>
                                <a asp-action="Detail" asp-route-id="@p.Id" class="fw-semibold text-dark text-decoration-none font-monospace">
                                    @p.ParamCode
                                </a>
                            </td>
                            <td>@Html.Raw(TypeBadge(p.ParamType))</td>
                            <td class="text-truncate" style="max-width:320px">
                                @if (string.IsNullOrWhiteSpace(p.ParamValue))
                                {
                                    <span class="text-muted small fst-italic">(chưa có giá trị)</span>
                                }
                                else
                                {
                                    <span class="font-monospace small">@p.ParamValue</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(p.DealerCode))
                                {
                                    <span class="badge bg-light text-dark border font-monospace">@p.DealerCode</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Detail" asp-route-id="@p.Id" class="btn btn-outline-secondary" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
