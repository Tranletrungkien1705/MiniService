@model OrderPart
@{
    Layout = null;
    var (stText, stCode, _) = Ui.OrderPartStatus(Model.Status);
    var (dfText, _) = Ui.OrderPartDeliveryForm(Model.DeliveryForm);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đơn đặt hàng @Model.OrderPartNo — MiniService</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        body { font-family: "Be Vietnam Pro", sans-serif; font-size: 13px; color: #1e293b; background: #fff; }
        .print-container { max-width: 880px; margin: 0 auto; padding: 32px 24px; }
        .po-header { border-bottom: 2px solid #0f172a; padding-bottom: 16px; margin-bottom: 20px; }
        .po-title { font-size: 22px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: #0f172a; }
        .table-po th { background: #f1f5f9 !important; font-size: 12px; text-transform: uppercase; font-weight: 700; }
        .table-po td, .table-po th { padding: 8px 10px; border-color: #cbd5e1; }
        .sign-box { height: 95px; }
        @@media print {
            .no-print { display: none !important; }
            body { padding: 0; background: #fff; }
            .print-container { max-width: 100%; padding: 0; }
            @@page { margin: 1.5cm; size: A4; }
        }
    </style>
</head>
<body>
    <div class="print-container">
        <!-- Floating Print Action -->
        <div class="no-print d-flex justify-content-between align-items-center bg-light p-3 rounded mb-4 border">
            <div>
                <a href="/OrderPart/Detail/@Model.Id" class="btn btn-sm btn-outline-secondary me-2"><i class="bi bi-arrow-left me-1"></i>Quay lại chi tiết</a>
                <span class="text-muted small">Xem trước bản in Đơn đặt hàng phụ tùng chuẩn đại lý ô tô Hyundai.</span>
            </div>
            <button onclick="window.print()" class="btn btn-sm btn-primary px-4"><i class="bi bi-printer me-1"></i>In đơn hàng (Ctrl + P)</button>
        </div>

        <!-- Dealership Header -->
        <div class="po-header">
            <div class="row align-items-center">
                <div class="col-8">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="bi bi-tools fs-3 text-primary"></i>
                        <span class="fs-5 fw-bold text-uppercase">TRUNG TÂM DỊCH VỤ Ô TÔ — HYUNDAI SERVICE</span>
                    </div>
                    <div class="text-muted small">Địa chỉ: Km 10, Quốc lộ 1A, TP. Hà Nội · Phòng Phụ tùng &amp; Vật tư: 024.3888.9999</div>
                    <div class="text-muted small">Email: parts@hyundai-service.vn · MST: 0101234567</div>
                </div>
                <div class="col-4 text-end">
                    <div class="fw-bold fs-5 text-primary font-monospace">@Model.OrderPartNo</div>
                    <div class="small text-muted">Ngày đặt: @Model.OrderDate.ToString("dd/MM/yyyy")</div>
                    @if (Model.EstimatedDeliverDate.HasValue)
                    {
                        <div class="small text-danger">Hạn giao: @Model.EstimatedDeliverDate.Value.ToString("dd/MM/yyyy")</div>
                    }
                    <div class="small text-muted">Trạng thái: <b>@stText</b></div>
                </div>
            </div>
        </div>

        <!-- Document Title -->
        <div class="text-center mb-4">
            <h4 class="po-title mb-1">ĐƠN ĐẶT HÀNG PHỤ TÙNG CHÍNH HÃNG</h4>
            <div class="text-muted small text-uppercase fw-semibold" style="letter-spacing:1px">(PURCHASE ORDER)</div>
        </div>

        <!-- Order Information Grid -->
        <div class="row g-3 mb-4">
            <div class="col-6">
                <div class="p-3 border rounded bg-light h-100">
                    <h6 class="fw-bold text-uppercase small text-muted mb-2">Đơn vị cung cấp (Nhà cung ứng):</h6>
                    <div class="fw-bold fs-6 mb-1">@Model.SupplierName</div>
                    <div class="small text-muted mb-1"><i class="bi bi-tag me-1"></i>Hình thức đặt: <b>@dfText</b></div>
                    <div class="small text-muted"><i class="bi bi-geo-alt me-1"></i>Địa điểm giao hàng: <b>@Model.DeliveryLocation</b></div>
                    @if (!string.IsNullOrEmpty(Model.OrderSuppierNo))
                    {
                        <div class="small text-muted mt-1"><i class="bi bi-hash me-1"></i>Mã tham chiếu NCC: <b>@Model.OrderSuppierNo</b></div>
                    }
                </div>
            </div>
            <div class="col-6">
                <div class="p-3 border rounded bg-light h-100">
                    <h6 class="fw-bold text-uppercase small text-muted mb-2">Mục đích đặt hàng &amp; Phương tiện:</h6>
                    @if (Model.RO != null)
                    {
                        <div class="small mb-1">Theo Lệnh sửa chữa: <b>@Model.RO.Code</b></div>
                        <div class="small mb-1">Xe phục vụ: <b>@(Model.RO.Car?.Plate ?? "—")</b> (@(Model.RO.Car?.Model ?? "—"))</div>
                        <div class="small mb-1">Khách hàng: <b>@(Model.RO.Customer?.Name ?? "—")</b></div>
                    }
                    else
                    {
                        <div class="small mb-1">Mục đích: <b>Bổ sung lượng tồn kho tối thiểu đại lý</b></div>
                    }
                    @if (!string.IsNullOrEmpty(Model.VIN))
                    {
                        <div class="small font-monospace">Số khung (VIN): <b>@Model.VIN</b></div>
                    }
                </div>
            </div>
        </div>

        <!-- Items Table -->
        <table class="table table-bordered table-po align-middle mb-3">
            <thead>
                <tr>
                    <th style="width:40px" class="text-center">STT</th>
                    <th style="width:140px">Mã phụ tùng</th>
                    <th>Tên phụ tùng &amp; Quy cách</th>
                    <th style="width:65px" class="text-center">ĐVT</th>
                    <th style="width:75px" class="text-end">SL đặt</th>
                    <th style="width:115px" class="text-end">Đơn giá net</th>
                    <th style="width:65px" class="text-end">CK (%)</th>
                    <th style="width:65px" class="text-end">VAT</th>
                    <th style="width:125px" class="text-end">Thành tiền (VNĐ)</th>
                </tr>
            </thead>
            <tbody>
            @{ int count = 1; }
            @foreach (var l in Model.Lines)
            {
                <tr>
                    <td class="text-center">@(count++)</td>
                    <td><code class="fw-bold text-dark font-monospace">@l.PartCode</code></td>
                    <td>
                        <span class="fw-semibold">@l.PartName</span>
                        @if (!string.IsNullOrEmpty(l.Note))
                        {
                            <div class="small text-muted font-monospace" style="font-size:11px">Ghi chú: @l.Note</div>
                        }
                    </td>
                    <td class="text-center">@l.Unit</td>
                    <td class="text-end fw-bold">@l.Quantity.ToString("0.##")</td>
                    <td class="text-end">@l.UnitPrice.ToString("N0")đ</td>
                    <td class="text-end">@(l.DiscountRate > 0 ? $"{l.DiscountRate:0.##}%" : "0%")</td>
                    <td class="text-end">@l.VatPercent.ToString("0.##")%</td>
                    <td class="text-end fw-bold">@l.Amount.ToString("N0")đ</td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="8" class="text-end fw-semibold">Tổng tiền hàng trước chiết khấu:</td>
                    <td class="text-end fw-semibold">@Model.SubTotalBeforeDiscount.ToString("N0")đ</td>
                </tr>
                @if (Model.TotalDiscount > 0)
                {
                    <tr>
                        <td colspan="8" class="text-end text-danger">Tổng chiết khấu thương mại:</td>
                        <td class="text-end text-danger fw-semibold">-@Model.TotalDiscount.ToString("N0")đ</td>
                    </tr>
                }
                <tr>
                    <td colspan="8" class="text-end text-muted">Tiền thuế GTGT (VAT):</td>
                    <td class="text-end text-muted">@Model.TotalVat.ToString("N0")đ</td>
                </tr>
                <tr class="fw-bold fs-6">
                    <td colspan="8" class="text-end text-uppercase text-primary">TỔNG GIÁ TRỊ ĐƠN ĐẶT HÀNG:</td>
                    <td class="text-end text-primary">@Model.Total.ToString("N0")đ</td>
                </tr>
            </tfoot>
        </table>

        <!-- Amount In Words -->
        <div class="p-2 border rounded bg-light mb-4">
            <span class="fst-italic text-muted">Số tiền bằng chữ: </span>
            <span class="fw-bold text-dark">@Ui.MoneyToWords(Model.Total)</span>
        </div>

        @if (!string.IsNullOrEmpty(Model.Remark))
        {
            <div class="mb-4 small">
                <span class="fw-bold">Ghi chú &amp; Điều khoản: </span>
                <span class="text-muted">@Model.Remark</span>
            </div>
        }

        <!-- Signatures -->
        <div class="row text-center mt-4">
            <div class="col-4">
                <div class="fw-bold">NGƯỜI LẬP ĐƠN</div>
                <div class="text-muted small fst-italic">(Ký, ghi rõ họ tên)</div>
                <div class="sign-box"></div>
                <div class="fw-semibold">@Model.CreatedBy</div>
            </div>
            <div class="col-4">
                <div class="fw-bold">QUẢN LÝ PHỤ TÙNG / KHO</div>
                <div class="text-muted small fst-italic">(Ký, ghi rõ họ tên)</div>
                <div class="sign-box"></div>
                <div class="fw-semibold">Thủ kho trưởng</div>
            </div>
            <div class="col-4">
                <div class="fw-bold">GIÁM ĐỐC DỊCH VỤ DUYỆT</div>
                <div class="text-muted small fst-italic">(Ký, đóng dấu)</div>
                <div class="sign-box"></div>
                <div class="fw-semibold">Phê duyệt PO</div>
            </div>
        </div>
    </div>
</body>
</html>
