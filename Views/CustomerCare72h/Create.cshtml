@{
    ViewData["Title"] = "Lập phiếu CSKH 72h sau dịch vụ";
    var ros = (List<RepairOrder>?)ViewBag.ROs ?? new List<RepairOrder>();
    var selectedRoId = (int?)ViewBag.SelectedROId;
}

<div class="card shadow-sm" style="max-width:800px;margin:0 auto">
    <div class="card-header bg-white py-3 border-bottom">
        <h5 class="fw-bold mb-0 text-primary">
            <i class="bi bi-headset-vr me-2"></i>Lập phiếu Chăm sóc khách hàng 72h (Ser_CustomerCare72h)
        </h5>
        <div class="text-muted small mt-1">
            Quy trình khảo sát chất lượng kỹ thuật xe sau 3 ngày lăn bánh thực tế trên đường theo tiêu chuẩn Hyundai Car Services.
        </div>
    </div>
    <div class="card-body">
        <form method="post" action="/CustomerCare72h/Create">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-bold">Chọn Lệnh sửa chữa hoàn tất (RO) cần khảo sát 72h <span class="text-danger">*</span></label>
                @if (ros.Count == 0)
                {
                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-info-circle me-1"></i>Hiện không có Lệnh sửa chữa hoàn tất nào đang chờ lập phiếu CSKH 72h.
                    </div>
                }
                else
                {
                    <select name="roId" class="form-select" required>
                        <option value="">— Chọn Lệnh sửa chữa hoàn tất —</option>
                        @foreach (var r in ros)
                        {
                            var sel = selectedRoId == r.Id;
                            <option value="@r.Id" selected="@sel">
                                @r.Code — Xe @r.Car.Plate (@r.Car.Model) — KH: @r.Customer.Name (@(r.Customer.Phone ?? "—")) — Giao xe: @(r.FinishedAt?.ToString("dd/MM/yyyy") ?? r.CreatedAt.ToString("dd/MM/yyyy"))
                            </option>
                        }
                    </select>
                }
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Ghi chú nội bộ ban đầu</label>
                <textarea name="internalNote" class="form-control" rows="3" placeholder="Nhập lưu ý hoặc dặn dò đặc biệt cho nhân viên CSKH khi gọi điện sau 72h..."></textarea>
            </div>

            <div class="alert alert-info d-flex align-items-center">
                <i class="bi bi-clock-history fs-3 me-3 text-info"></i>
                <div class="small">
                    <b>Cơ chế kích hoạt 72h tự động:</b> Sau khi phiếu được tạo, hệ thống sẽ tự động tính ngày hẹn gọi <code>ScheduledDate = Ngày giao xe + 3 ngày</code>. Nếu xe chạy thử phát sinh sự cố, hệ thống sẽ bật cảnh báo <b>Báo động Phản tu (Re-Repair Alert)</b> để đón tiếp xử lý miễn phí cho khách hàng.
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a href="/CustomerCare72h" class="btn btn-outline-secondary">Hủy bỏ</a>
                <button type="submit" class="btn btn-primary" @(ros.Count == 0 ? "disabled" : "")>
                    <i class="bi bi-check-lg me-1"></i>Tạo phiếu CSKH 72h
                </button>
            </div>
        </form>
    </div>
</div>
