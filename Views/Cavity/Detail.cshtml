@model MiniService.Models.Cavity
@{
    ViewData["Title"] = $"Khoang {Model.CavityNo} — {Model.CavityName}";
    var (stTxt, stCode, stCss) = MiniService.Services.Ui.CavityStatus(Model.Status);
    var (tpTxt, tpCode, tpIcon, tpCss) = MiniService.Services.Ui.CavityType(Model.CavityType);
    var isOccupied = Model.Status == MiniService.Models.CavityStatus.Occupied;
    var isMaint = Model.Status == MiniService.Models.CavityStatus.Maintenance;
    var eligibleROs = (List<MiniService.Models.RepairOrder>)(ViewBag.EligibleROs ?? new List<MiniService.Models.RepairOrder>());
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
        <li class="breadcrumb-item"><a href="/Cavity">Khoang sửa chữa (Bays)</a></li>
        <li class="breadcrumb-item active">@Model.CavityNo</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-primary fs-6 px-3 py-2">@Model.CavityNo</span>
        <div>
            <h5 class="fw-bold mb-0">@Model.CavityName</h5>
            <div class="text-muted small">
                <span class="badge bg-light text-dark border me-1"><i class="bi @tpIcon me-1 text-@tpCss"></i>@tpTxt</span>
                <span class="badge bg-@stCss">@stTxt</span>
            </div>
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (isOccupied)
        {
            <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#releaseModal">
                <i class="bi bi-box-arrow-right me-1"></i>Giải phóng khoang
            </button>
        }
        else if (isMaint)
        {
            <form method="post" action="/Cavity/ChangeStatus" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="cavityId" value="@Model.Id" />
                <input type="hidden" name="status" value="@((int)MiniService.Models.CavityStatus.Available)" />
                <button type="submit" class="btn btn-success btn-sm">
                    <i class="bi bi-check2-circle me-1"></i>Hoàn tất bảo trì
                </button>
            </form>
        }
        else
        {
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#assignModal">
                <i class="bi bi-box-arrow-in-down me-1"></i>Điều phối xe vào
            </button>
            <form method="post" action="/Cavity/ChangeStatus" class="d-inline" onsubmit="return confirm('Chuyển cầu nâng sang chế độ bảo trì?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="cavityId" value="@Model.Id" />
                <input type="hidden" name="status" value="@((int)MiniService.Models.CavityStatus.Maintenance)" />
                <button type="submit" class="btn btn-outline-warning btn-sm">
                    <i class="bi bi-wrench me-1"></i>Bảo trì thiết bị
                </button>
            </form>
        }
        <a href="/Cavity" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
    </div>
</div>

<div class="row g-3">
    <!-- Left Column: Thông số kỹ thuật & Cấu hình -->
    <div class="col-lg-5">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white py-2">
                <h6 class="fw-bold mb-0"><i class="bi bi-info-circle me-1 text-primary"></i>Thông số khoang kỹ thuật</h6>
            </div>
            <div class="card-body">
                <table class="table table-sm table-borderless mb-0">
                    <tr><td class="text-muted" style="width:140px">Mã khoang:</td><td class="fw-bold text-primary">@Model.CavityNo</td></tr>
                    <tr><td class="text-muted">Tên khoang:</td><td class="fw-semibold">@Model.CavityName</td></tr>
                    <tr><td class="text-muted">Phân loại:</td><td><span class="badge bg-light text-dark border">@tpTxt</span></td></tr>
                    <tr><td class="text-muted">Trạng thái:</td><td><span class="badge bg-@stCss">@stTxt</span></td></tr>
                    <tr><td class="text-muted">Cầu nâng / Thiết bị:</td><td>@(Model.LiftEquipment ?? "—")</td></tr>
                    <tr><td class="text-muted">Phân xưởng / Vị trí:</td><td>@(Model.AreaZone ?? "—")</td></tr>
                    <tr><td class="text-muted">Lần giải phóng gần nhất:</td><td>@(Model.FinishUseDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td></tr>
                    <tr><td class="text-muted">Ghi chú:</td><td>@(Model.Note ?? "—")</td></tr>
                    <tr><td class="text-muted">Ngày khởi tạo:</td><td>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td></tr>
                </table>
            </div>
        </div>

        <!-- Chỉnh sửa cấu hình khoang -->
        <div class="card shadow-sm">
            <div class="card-header bg-white py-2">
                <h6 class="fw-bold mb-0"><i class="bi bi-pencil-square me-1 text-secondary"></i>Chỉnh sửa thông tin khoang</h6>
            </div>
            <div class="card-body">
                <form method="post" action="/Cavity/Update">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Tên khoang sửa chữa: *</label>
                        <input type="text" name="cavityName" class="form-control form-control-sm" value="@Model.CavityName" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Phân loại khoang: *</label>
                        <select name="type" class="form-select form-select-sm">
                            @foreach (MiniService.Models.CavityType t in Enum.GetValues(typeof(MiniService.Models.CavityType)))
                            {
                                var (tText, _, _, _) = MiniService.Services.Ui.CavityType(t);
                                <!option value="@((int)t)" @(Model.CavityType == t ? "selected" : "")>@tText</!option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Cầu nâng / Thiết bị:</label>
                        <input type="text" name="liftEquipment" class="form-control form-control-sm" value="@Model.LiftEquipment" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Phân xưởng / Khu vực:</label>
                        <input type="text" name="areaZone" class="form-control form-control-sm" value="@Model.AreaZone" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Ghi chú kỹ thuật:</label>
                        <textarea name="note" rows="2" class="form-control form-control-sm">@Model.Note</textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-save me-1"></i>Cập nhật thông tin</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Right Column: Thông tin Xe & Lệnh sửa chữa đang hoạt động -->
    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-car-front me-1 text-danger"></i>Hoạt động sửa chữa trên khoang</h6>
                @if (isOccupied)
                {
                    <span class="badge bg-danger"><i class="bi bi-record-fill me-1"></i>Đang có xe sửa chữa</span>
                }
            </div>
            <div class="card-body">
                @if (isOccupied)
                {
                    <div class="p-3 rounded bg-light border border-danger-subtle mb-3">
                        <div class="row align-items-center">
                            <div class="col-md-7">
                                <span class="badge bg-danger fs-5 px-3 py-1 mb-1"><i class="bi bi-car-front-fill me-1"></i>@Model.CurrentCarPlate</span>
                                <h6 class="fw-bold text-dark mb-1">@Model.CurrentCarModel</h6>
                                @if (Model.CurrentRO?.Customer != null)
                                {
                                    <div class="text-muted small">
                                        <i class="bi bi-person me-1"></i>Chủ xe: <strong>@Model.CurrentRO.Customer.Name</strong>
                                        @if (!string.IsNullOrWhiteSpace(Model.CurrentRO.Customer.Phone))
                                        {
                                            <span class="ms-1">· <i class="bi bi-telephone me-1"></i>@Model.CurrentRO.Customer.Phone</span>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="col-md-5 text-md-end mt-2 mt-md-0">
                                @if (Model.CurrentRO != null)
                                {
                                    <div class="mb-1">
                                        <a href="/RO/Detail/@Model.CurrentROId" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-clipboard2-pulse me-1"></i>Xem RO: @Model.CurrentRO.Code
                                        </a>
                                    </div>
                                    <span class="badge bg-primary">Trạng thái RO: @MiniService.Services.Ui.Status(Model.CurrentRO.Status).text</span>
                                }
                            </div>
                        </div>

                        <hr class="my-2" />

                        <div class="row g-2 text-muted small">
                            <div class="col-6 col-md-3">
                                <div>KTV phụ trách:</div>
                                <strong class="text-dark">@(Model.CurrentTechnician ?? "—")</strong>
                            </div>
                            <div class="col-6 col-md-3">
                                <div>Thời gian vào:</div>
                                <strong class="text-dark">@(Model.StartUseDate?.ToString("HH:mm - dd/MM") ?? "—")</strong>
                            </div>
                            <div class="col-6 col-md-3">
                                <div>Dự kiến hoàn tất:</div>
                                <strong class="text-dark">@(Model.ExpectedFinishDate?.ToString("HH:mm - dd/MM") ?? "—")</strong>
                            </div>
                            <div class="col-6 col-md-3">
                                <div>Đã trên khoang:</div>
                                @if (Model.ElapsedTime.HasValue)
                                {
                                    <strong class="text-danger">@((int)Model.ElapsedTime.Value.TotalHours)h @(Model.ElapsedTime.Value.Minutes)m</strong>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </div>
                        </div>
                    </div>

                    @if (Model.CurrentRO?.Lines.Count > 0)
                    {
                        <h6 class="fw-bold small text-muted text-uppercase mb-2">Hạng mục công việc &amp; Phụ tùng theo lệnh RO</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Loại</th>
                                        <th>Nội dung công việc / Phụ tùng</th>
                                        <th class="text-end">SL</th>
                                        <th class="text-end">Đơn giá</th>
                                        <th class="text-end">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var l in Model.CurrentRO.Lines)
                                    {
                                        <tr>
                                            <td><span class="badge bg-light text-dark border">@MiniService.Services.Ui.Line(l.Type)</span></td>
                                            <td class="fw-semibold">@l.Name</td>
                                            <td class="text-end">@l.Quantity</td>
                                            <td class="text-end">@l.UnitPrice.ToString("N0")đ</td>
                                            <td class="text-end fw-bold">@l.Amount.ToString("N0")đ</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <td colspan="4" class="text-end fw-bold">Tổng chi phí RO:</td>
                                        <td class="text-end fw-bold text-primary">@Model.CurrentRO.Total.ToString("N0")đ</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                }
                else if (isMaint)
                {
                    <div class="p-4 text-center">
                        <i class="bi bi-wrench-adjustable-circle text-warning fs-1 d-block mb-2"></i>
                        <h6 class="fw-bold text-dark">Cầu nâng / Thiết bị đang được bảo trì</h6>
                        <p class="text-muted small mb-3">Khoang kỹ thuật tạm thời khóa tiếp nhận xe để đảm bảo tiêu chuẩn an toàn lao động xưởng.</p>
                        <form method="post" action="/Cavity/ChangeStatus">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="cavityId" value="@Model.Id" />
                            <input type="hidden" name="status" value="@((int)MiniService.Models.CavityStatus.Available)" />
                            <button type="submit" class="btn btn-success btn-sm">
                                <i class="bi bi-check2-circle me-1"></i>Xác nhận hoàn tất bảo trì, mở khoang
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center">
                        <i class="bi bi-check-circle text-success fs-1 d-block mb-2"></i>
                        <h6 class="fw-bold text-dark">Khoang sửa chữa đang trống</h6>
                        <p class="text-muted small mb-3">Sẵn sàng nhận xe vào làm dịch vụ bảo dưỡng, sửa chữa chung hoặc đồng sơn.</p>
                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#assignModal">
                            <i class="bi bi-box-arrow-in-down me-1"></i>Điều phối xe vào khoang này ngay
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal Release Cavity -->
@if (isOccupied)
{
    <div class="modal fade" id="releaseModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" action="/Cavity/Release">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="cavityId" value="@Model.Id" />
                    <div class="modal-header bg-danger text-white">
                        <h6 class="modal-title fw-bold"><i class="bi bi-box-arrow-right me-1"></i>Giải phóng khoang @Model.CavityNo</h6>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-info py-2 small">
                            Xe <strong>@Model.CurrentCarPlate</strong> (@Model.CurrentCarModel) sẽ được chuyển rời khỏi khoang để nhường chỗ cho xe khác.
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Cập nhật trạng thái Lệnh sửa chữa (RO: @(Model.CurrentRO?.Code)):</label>
                            <select name="nextRoStatus" class="form-select">
                                <option value="@((int)MiniService.Models.ROStatus.Repaired)">RPRD — Đã sửa xong (chuyển sang chờ KCS kiểm tra)</option>
                                <option value="@((int)MiniService.Models.ROStatus.CheckEnd)">CEND — Đã kiểm tra chất lượng xong</option>
                                <option value="@((int)MiniService.Models.ROStatus.Wait4Part)">W4P — Đợi phụ tùng bổ sung</option>
                                <option value="@((int)MiniService.Models.ROStatus.InGarage)">INGA — Giữ nguyên trạng thái (chuyển khoang khác sau)</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-check-lg me-1"></i>Xác nhận giải phóng</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Modal Assign Car To Cavity -->
@if (!isOccupied && !isMaint)
{
    <div class="modal fade" id="assignModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" action="/Cavity/Assign">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="cavityId" value="@Model.Id" />
                    <div class="modal-header bg-primary text-white">
                        <h6 class="modal-title fw-bold"><i class="bi bi-box-arrow-in-down me-1"></i>Điều phối xe vào @Model.CavityNo</h6>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Chọn Lệnh sửa chữa (RO) cần đưa vào khoang: *</label>
                            @if (eligibleROs.Count > 0)
                            {
                                <select name="roId" class="form-select" required>
                                    @foreach (var ro in eligibleROs)
                                    {
                                        var (rTxt, rCode, rCss) = MiniService.Services.Ui.Status(ro.Status);
                                        <option value="@ro.Id">@ro.Code — Xe @ro.Car?.Plate (@ro.Car?.Model) · KH: @ro.Customer?.Name [@rCode - @rTxt]</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <div class="alert alert-warning py-2 small mb-0">
                                    Hiện không có Lệnh sửa chữa nào đang chờ vào khoang.
                                </div>
                            }
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Kỹ thuật viên phụ trách:</label>
                            <input type="text" name="technician" class="form-control" placeholder="VD: Thợ Hùng / KTV Tuấn..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Dự kiến hoàn thành trên khoang:</label>
                            <input type="datetime-local" name="expectedFinish" class="form-control" value="@DateTime.Now.AddHours(2).ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                        @if (eligibleROs.Count > 0)
                        {
                            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check-lg me-1"></i>Đưa xe vào khoang</button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
}
