@model List<WarehouseLocation>
@{
    ViewData["Title"] = "Quản lý vị trí kệ/kho phụ tùng";
    var summary = ViewBag.Summary as WarehouseLocationSummaryDto ?? new WarehouseLocationSummaryDto();
}
<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Tổng số vị trí</div>
                <div class="stat-num text-primary">@summary.TotalLocations</div>
                <div class="text-muted" style="font-size:11.5px">Vị trí kệ/kho phụ tùng</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Đang sử dụng</div>
                <div class="stat-num text-success">@summary.ActiveLocations</div>
                <div class="text-muted" style="font-size:11.5px">Vị trí có hiệu lực hoạt động</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Số đại lý</div>
                <div class="stat-num text-info">@summary.DealerCount</div>
                <div class="text-muted" style="font-size:11.5px">Đại lý có khai báo vị trí</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Số kho (StockNo)</div>
                <div class="stat-num" style="color:#0f766e">@summary.StockCount</div>
                <div class="text-muted" style="font-size:11.5px">Kho khác nhau có vị trí</div>
            </div>
        </div>
    </div>
</div>
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <form method="get" class="d-flex align-items-center gap-2 flex-wrap">
                <div class="input-group input-group-sm" style="max-width:280px">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Mã vị trí, tên vị trí, kho..." />
                </div>
                <input name="dealerCode" value="@ViewBag.DealerCode" class="form-control form-control-sm" style="width:150px" placeholder="Mã đại lý" />
                <select name="type" class="form-select form-select-sm" style="width:160px" onchange="this.form.submit()">
                    <option value="">-- Loại vị trí --</option>
                    @foreach (var t in Enum.GetValues<LocationType>())
                    {
                        <option value="@t" selected="@(ViewBag.Type as LocationType? == t)">@Ui.LocationTypeLabel(t).text</option>
                    }
                </select>
                <select name="isActive" class="form-select form-select-sm" style="width:150px" onchange="this.form.submit()">
                    <option value="">-- Trạng thái --</option>
                    <option value="true" selected="@(ViewBag.IsActive == true)">Đang sử dụng</option>
                    <option value="false" selected="@(ViewBag.IsActive == false)">Ngừng sử dụng</option>
                </select>
                <button type="submit" class="btn btn-sm btn-outline-secondary">Lọc</button>
                @if (!string.IsNullOrEmpty(ViewBag.Q as string) || ViewBag.IsActive != null || ViewBag.Type != null || !string.IsNullOrEmpty(ViewBag.DealerCode as string))
                {
                    <a href="/WarehouseLocation" class="btn btn-sm btn-link text-decoration-none">Xóa lọc</a>
                }
            </form>
            <div class="d-flex align-items-center gap-2">
                <a href="/Part" class="btn btn-sm btn-outline-secondary"><i class="bi bi-box-seam me-1"></i>Danh mục phụ tùng</a>
                <a href="/WarehouseLocation/Create" class="btn btn-sm btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>Thêm vị trí kho
                </a>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:150px">Mã vị trí</th>
                        <th>Tên vị trí</th>
                        <th style="width:120px">Đại lý</th>
                        <th style="width:130px">Kho (StockNo)</th>
                        <th style="width:130px">Loại vị trí</th>
                        <th class="text-center" style="width:120px">Trạng thái</th>
                        <th class="text-end" style="width:100px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block mb-1 text-secondary"></i>
                                Không tìm thấy vị trí kho nào phù hợp điều kiện lọc.
                            </td>
                        </tr>
                    }
                    @foreach (var l in Model)
                    {
                        var activeInfo = Ui.LocationActive(l.IsActive);
                        var typeInfo = Ui.LocationTypeLabel(l.Type);
                        <tr>
                            <td>
                                <a asp-action="Detail" asp-route-id="@l.Id" class="fw-bold font-monospace text-decoration-none">
                                    @l.LocationCode
                                </a>
                            </td>
                            <td>
                                <a asp-action="Detail" asp-route-id="@l.Id" class="text-dark text-decoration-none fw-semibold">
                                    @l.LocationName
                                </a>
                                @if (!string.IsNullOrEmpty(l.Surface) || !string.IsNullOrEmpty(l.Height))
                                {
                                    <div class="text-muted small">
                                        @if (!string.IsNullOrEmpty(l.Surface)) { <span>Bề mặt: @l.Surface</span> }
                                        @if (!string.IsNullOrEmpty(l.Height)) { <span class="ms-2">Cao: @l.Height</span> }
                                    </div>
                                }
                            </td>
                            <td class="font-monospace">@l.DealerCode</td>
                            <td>@(string.IsNullOrEmpty(l.StockNo) ? "-" : l.StockNo)</td>
                            <td><span class="badge bg-@typeInfo.css">@typeInfo.text</span></td>
                            <td class="text-center">
                                <span class="badge bg-@activeInfo.css">@activeInfo.text</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Detail" asp-route-id="@l.Id" class="btn btn-outline-secondary" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
