@model WarehouseLocation
@{
    ViewData["Title"] = $"Chi tiết vị trí kho [{Model.LocationCode}]";
    var activeInfo = Ui.LocationActive(Model.IsActive);
    var typeInfo = Ui.LocationTypeLabel(Model.Type);
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a href="/WarehouseLocation" class="text-decoration-none small text-muted"><i class="bi bi-arrow-left me-1"></i>Danh mục vị trí kho</a>
        <h5 class="mb-0 fw-bold mt-1">
            <span class="font-monospace text-primary">@Model.LocationCode</span> - @Model.LocationName
            <span class="badge bg-@activeInfo.css ms-2">@activeInfo.text</span>
        </h5>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editLocationModal">
            <i class="bi bi-pencil me-1"></i>Chỉnh sửa
        </button>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa vị trí kho này?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>Xóa</button>
        </form>
    </div>
</div>
<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-geo-alt me-1 text-primary"></i>Thông tin vị trí</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted small">Mã vị trí (LocationCode)</dt>
                    <dd class="col-sm-7 font-monospace fw-bold">@Model.LocationCode</dd>
                    <dt class="col-sm-5 text-muted small">Tên vị trí (LocationName)</dt>
                    <dd class="col-sm-7">@Model.LocationName</dd>
                    <dt class="col-sm-5 text-muted small">Đại lý (DealerCode)</dt>
                    <dd class="col-sm-7 font-monospace">@Model.DealerCode</dd>
                    <dt class="col-sm-5 text-muted small">Kho (StockNo)</dt>
                    <dd class="col-sm-7">@(string.IsNullOrEmpty(Model.StockNo) ? "-" : Model.StockNo)</dd>
                    <dt class="col-sm-5 text-muted small">Loại vị trí (LocationType)</dt>
                    <dd class="col-sm-7"><span class="badge bg-@typeInfo.css">@typeInfo.text</span></dd>
                    <dt class="col-sm-5 text-muted small">Bề mặt kệ (LocationSurface)</dt>
                    <dd class="col-sm-7">@(string.IsNullOrEmpty(Model.Surface) ? "-" : Model.Surface)</dd>
                    <dt class="col-sm-5 text-muted small">Độ cao kệ (LocationHight)</dt>
                    <dd class="col-sm-7">@(string.IsNullOrEmpty(Model.Height) ? "-" : Model.Height)</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-clock-history me-1 text-secondary"></i>Lịch sử &amp; Trạng thái</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted small">Trạng thái</dt>
                    <dd class="col-sm-7"><span class="badge bg-@activeInfo.css">@activeInfo.text</span></dd>
                    <dt class="col-sm-5 text-muted small">Người tạo (LogLUBy)</dt>
                    <dd class="col-sm-7">@Model.CreatedBy</dd>
                    <dt class="col-sm-5 text-muted small">Ngày tạo</dt>
                    <dd class="col-sm-7">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                    <dt class="col-sm-5 text-muted small">Người cập nhật cuối (LogLUBy)</dt>
                    <dd class="col-sm-7">@(string.IsNullOrEmpty(Model.LogLUBy) ? "-" : Model.LogLUBy)</dd>
                    <dt class="col-sm-5 text-muted small">Cập nhật cuối (LogLUDateTime)</dt>
                    <dd class="col-sm-7">@(Model.LogLUDateTime?.ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white fw-semibold"><i class="bi bi-info-circle me-1 text-primary"></i>Quy tắc nghiệp vụ vị trí kho</div>
    <div class="card-body">
        <ul class="mb-0 small text-muted">
            <li>Mã vị trí (LocationCode) không được trùng trong cùng một đại lý (DealerCode).</li>
            <li>Không thể xóa vị trí khi vẫn còn phụ tùng tồn kho tại vị trí đó (InStockQuantity &gt; 0).</li>
            <li>Không thể xóa vị trí khi còn phiếu nhập/xuất kho chưa hoàn tất tham chiếu vị trí này.</li>
        </ul>
    </div>
</div>
<!-- Modal Chỉnh sửa vị trí kho -->
<div class="modal fade" id="editLocationModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="Update" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2 text-primary"></i>Chỉnh sửa vị trí kho @Model.LocationCode</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Mã vị trí (LocationCode) <span class="text-danger">*</span></label>
                            <input name="locationCode" class="form-control font-monospace" value="@Model.LocationCode" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-semibold">Tên vị trí (LocationName) <span class="text-danger">*</span></label>
                            <input name="locationName" class="form-control" value="@Model.LocationName" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Đại lý (DealerCode) <span class="text-danger">*</span></label>
                            <input name="dealerCode" class="form-control font-monospace" value="@Model.DealerCode" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Kho (StockNo)</label>
                            <input name="stockNo" class="form-control font-monospace" value="@Model.StockNo" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Loại vị trí (LocationType)</label>
                            <select name="type" class="form-select">
                                @foreach (var t in Enum.GetValues<LocationType>())
                                {
                                    <option value="@t" selected="@(Model.Type == t)">@Ui.LocationTypeLabel(t).text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Bề mặt kệ (LocationSurface)</label>
                            <input name="surface" class="form-control" value="@Model.Surface" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Độ cao kệ (LocationHight)</label>
                            <input name="height" class="form-control" value="@Model.Height" />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="isActive" value="true" id="chkActive" @(Model.IsActive ? "checked" : "") />
                                <label class="form-check-label fw-semibold" for="chkActive">Đang sử dụng (IsActive)</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>
