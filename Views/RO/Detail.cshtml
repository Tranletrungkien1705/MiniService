@model RepairOrder
@{
    ViewData["Title"] = $"RO {Model.Code}";
    var (stTxt, stCode, stCss) = Ui.Status(Model.Status);
    var next = (ROStatus[])ViewBag.Next;
    var parts = (List<Part>?)ViewBag.Parts ?? [];
    var serviceItems = (List<ServiceItem>?)ViewBag.ServiceItems ?? [];
    var servicePackages = (List<ServicePackage>?)ViewBag.ServicePackages ?? [];
    var eligibleCampaigns = (List<CampaignMarketing>?)ViewBag.EligibleCampaigns ?? [];
    var pendingBulletins = (List<BulletinVin>?)ViewBag.PendingBulletins ?? [];
    bool editable = Model.Status is not (ROStatus.Finished or ROStatus.Paid or ROStatus.Rejected or ROStatus.NotResponding);
    bool deletable = Model.Status is ROStatus.Created or ROStatus.Printed or ROStatus.Rejected or ROStatus.NotResponding;
}
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3"><div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <h5 class="fw-bold mb-1">@Model.Code <span class="badge bg-@stCss ms-1" title="@stCode">@stTxt</span></h5>
                    <div class="text-muted small"><i class="bi bi-car-front me-1"></i>@Model.Car.Plate · @Model.Car.Model · @Model.Car.Year — <b>@Model.Customer.Name</b> (@Model.Customer.Phone)</div>
                    <div class="small mt-1">Odo: <b>@Model.Odometer.ToString("N0")</b> km · Thợ: <b>@(Model.Technician ?? "—")</b></div>
                    @if (Model.Appointment != null)
                    {
                        <div class="small mt-1 text-primary">
                            <i class="bi bi-calendar2-check me-1"></i>Từ lịch hẹn: <a href="/Appointment/Detail/@Model.Appointment.Id" class="fw-semibold">@Model.Appointment.AppNo</a> (@Model.Appointment.AppointmentDate.ToString("dd/MM/yyyy HH:mm"))
                        </div>
                    }
                    @if (Model.ReceptionSheet != null)
                    {
                        <div class="small mt-1 text-primary">
                            <i class="bi bi-card-checklist me-1"></i>Phiếu tiếp nhận: <a href="/Reception/Detail/@Model.ReceptionSheet.Id" class="fw-semibold">@Model.ReceptionSheet.ReceptionNo</a> (<span class="badge bg-@Ui.ReceptionStatus(Model.ReceptionSheet.Status).css" style="font-size:10px">@Ui.ReceptionStatus(Model.ReceptionSheet.Status).text</span>)
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.IntakeNote)) { <div class="small mt-1 text-muted">Tình trạng: @Model.IntakeNote</div> }
                </div>
            </div>
        </div></div>

        @if (Model.CampaignMarketing != null)
        {
            <div class="alert alert-warning d-flex justify-content-between align-items-center mb-3 border-warning">
                <div>
                    <i class="bi bi-megaphone-fill me-2 fs-5 text-warning"></i>
                    <strong>Chiến dịch KM áp dụng: @Model.CampaignMarketing.CamMarketingName (@Model.CampaignMarketing.CamMarketingNo)</strong>
                    <div class="small text-muted mt-1">
                        Ưu đãi giảm giá: <b class="text-success fs-6">-@Model.CampaignDiscountAmount.ToString("N0")đ</b> trực tiếp vào chi phí thanh toán của khách hàng!
                    </div>
                </div>
                @if (editable)
                {
                    <form asp-action="RemoveCampaign" method="post" class="d-inline">
                        @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Hủy áp dụng chiến dịch khuyến mãi này?')" title="Gỡ ưu đãi chiến dịch">
                            <i class="bi bi-x-circle me-1"></i>Gỡ KM
                        </button>
                    </form>
                }
            </div>
        }

        @if (Model.CustomerGroup != null)
        {
            <div class="alert alert-primary d-flex justify-content-between align-items-center mb-3 border-primary bg-primary bg-opacity-10">
                <div>
                    <i class="bi bi-buildings-fill me-2 fs-5 text-primary"></i>
                    <strong>Xe thuộc Khách đoàn: <a href="/CustomerGroup/Detail/@Model.CustomerGroup.Id" class="text-decoration-none fw-bold">@Model.CustomerGroup.GroupName (@Model.CustomerGroup.GroupNo)</a></strong>
                    <div class="small text-muted mt-1">
                        Chính sách ưu đãi đội xe: Giờ công <b>-@Model.CustomerGroup.DiscountPercentLabor%</b> · Phụ tùng <b>-@Model.CustomerGroup.DiscountPercentPart%</b>
                        @if (Model.CustomerGroupDiscountAmount > 0)
                        {
                            <span> | Đã áp dụng giảm: <b class="text-success fs-6">-@Model.CustomerGroupDiscountAmount.ToString("N0")đ</b></span>
                        }
                    </div>
                </div>
                @if (editable)
                {
                    <form asp-controller="CustomerGroup" asp-action="ApplyToRo" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="roId" value="@Model.Id" />
                        <input type="hidden" name="groupId" value="@Model.CustomerGroup.Id" />
                        <button type="submit" class="btn btn-outline-primary btn-sm" title="Tính lại ưu đãi đoàn theo các hạng mục hiện có">
                            <i class="bi bi-arrow-repeat me-1"></i>Áp ưu đãi đoàn
                        </button>
                    </form>
                }
            </div>
        }

        @if (Model.Bulletin != null)
        {
            <div class="alert alert-info d-flex justify-content-between align-items-center mb-3 border-info">
                <div>
                    <i class="bi bi-file-earmark-check-fill me-2 fs-5 text-info"></i>
                    <strong>Bản tin kỹ thuật HTC: <a href="/Bulletin/Detail/@Model.Bulletin.Id" class="text-decoration-none">@Model.Bulletin.BulletinNo — @Model.Bulletin.Title</a></strong>
                    <div class="small text-muted mt-1">
                        Hạng mục phụ tùng &amp; tiền công trong bản tin được hãng Hyundai chi trả 100% bảo hành!
                    </div>
                </div>
                <a href="/Bulletin/Detail/@Model.Bulletin.Id" class="btn btn-outline-info btn-sm">
                    <i class="bi bi-eye me-1"></i>Xem TSB
                </a>
            </div>
        }

        @if (pendingBulletins.Count > 0 && Model.BulletinId == null)
        {
            @foreach (var bvin in pendingBulletins.Where(v => v.Status == BulletinVinStatus.Pending))
            {
                <div class="alert alert-danger d-flex justify-content-between align-items-center mb-3 border-danger shadow-sm">
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-danger">TRIỆU HỒI / TSB</span>
                            <strong class="text-danger">Xe có Bản tin kỹ thuật từ HTC: @bvin.Bulletin.BulletinNo (@(bvin.Bulletin.BulletinNoHMC ?? "HMC"))</strong>
                        </div>
                        <div class="small mt-1 text-dark">
                            <b>@bvin.Bulletin.Title</b>
                            <div class="text-muted">@bvin.Bulletin.Remark</div>
                        </div>
                    </div>
                    @if (editable)
                    {
                        <form asp-action="ApplyBulletin" method="post" class="d-inline ms-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="bulletinId" value="@bvin.Bulletin.Id" />
                            <button type="submit" class="btn btn-danger btn-sm text-nowrap" onclick="return confirm('Nạp toàn bộ công việc & phụ tùng triệu hồi vào lệnh sửa chữa RO này?')">
                                <i class="bi bi-plus-circle me-1"></i>Áp dụng vào RO ngay
                            </button>
                        </form>
                    }
                </div>
            }
        }

        @if (Model.Status == ROStatus.Wait4Part)
        {
            <div class="alert alert-warning d-flex justify-content-between align-items-center mb-3">
                <div>
                    <i class="bi bi-clock-history me-2 fs-5"></i>
                    <strong>Xe đang đợi phụ tùng về kho (W4P).</strong> Vui lòng đặt hàng nhà cung cấp hoặc theo dõi đơn đặt phụ tùng.
                </div>
                <a href="/OrderPart/Create?roId=@Model.Id" class="btn btn-warning btn-sm fw-semibold">
                    <i class="bi bi-cart-plus me-1"></i>Đặt hàng NCC ngay
                </a>
            </div>
        }

        <div class="card"><div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0">Chi tiết công &amp; phụ tùng</h6>
                <div class="d-flex gap-2">
                    @if (editable && eligibleCampaigns.Count > 0 && Model.CampaignMarketing == null)
                    {
                        <button type="button" class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#applyCampaignModal">
                            <i class="bi bi-megaphone me-1"></i>Áp dụng khuyến mãi (@eligibleCampaigns.Count)
                        </button>
                    }
                    @if (editable && servicePackages.Count > 0)
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#applyPackageModal">
                            <i class="bi bi-collection me-1"></i>Áp dụng gói bảo dưỡng
                        </button>
                    }
                </div>
            </div>
            <table class="table align-middle">
                <thead><tr><th>Loại</th><th>Đối tượng TT</th><th>Nội dung</th><th class="text-end">SL</th><th class="text-end">Đơn giá</th><th class="text-end">Thành tiền</th><th></th></tr></thead>
                <tbody>
                @foreach (var l in Model.Lines)
                {
                    var (expTxt, expCss) = Ui.Expense(l.ExpenseType);
                    <tr>
                        <td>@if (l.Type == LineType.Labor) { <span class="badge bg-info">Công</span> } else { <span class="badge bg-secondary">Phụ tùng</span> }</td>
                        <td><span class="badge bg-@expCss" style="font-size:11px">@expTxt</span></td>
                        <td>
                            @l.Name
                            @if (l.ServiceItem != null)
                            {
                                <a href="/ServiceItem/Detail/@l.ServiceItemId" class="badge bg-primary-subtle text-primary border text-decoration-none ms-1" style="font-size:11px"><i class="bi bi-wrench-adjustable me-1"></i>@l.ServiceItem.Code (@(l.StdManHour?.ToString("0.##") ?? l.ServiceItem.StdManHour.ToString("0.##"))h)</a>
                            }
                            else if (l.Part != null)
                            {
                                <span class="badge bg-light text-secondary border ms-1" style="font-size:11px"><i class="bi bi-tag me-1"></i>@l.Part.Code</span>
                            }
                        </td>
                        <td class="text-end">@l.Quantity.ToString("0.##")</td>
                        <td class="text-end">@l.UnitPrice.ToString("N0")</td>
                        <td class="text-end fw-semibold">@l.Amount.ToString("N0")</td>
                        <td>@if (editable) { <form asp-action="RemoveLine" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="lineId" value="@l.Id" /><button class="btn btn-sm btn-link text-danger p-0"><i class="bi bi-x-lg"></i></button></form> }</td>
                    </tr>
                }
                @if (Model.Lines.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-3">Chưa có dòng nào.</td></tr> }
                </tbody>
                <tfoot>
                    <tr><td colspan="5" class="text-end text-muted">Tiền công</td><td class="text-end">@Model.LaborTotal.ToString("N0")</td><td></td></tr>
                    <tr><td colspan="5" class="text-end text-muted">Tiền phụ tùng</td><td class="text-end">@Model.PartTotal.ToString("N0")</td><td></td></tr>
                    @if (Model.WarrantyTotal > 0)
                    {
                        <tr><td colspan="5" class="text-end text-primary fw-semibold"><i class="bi bi-shield-check me-1"></i>Hãng bảo hành chi trả</td><td class="text-end text-primary fw-semibold">@Model.WarrantyTotal.ToString("N0")đ</td><td></td></tr>
                        <tr><td colspan="5" class="text-end text-muted">Khách hàng thanh toán thực tế</td><td class="text-end fw-semibold">@Model.CustomerTotal.ToString("N0")đ</td><td></td></tr>
                    }
                    @if (Model.InsuranceTotal > 0)
                    {
                        <tr><td colspan="5" class="text-end text-info fw-semibold"><i class="bi bi-shield-shaded me-1"></i>Bảo hiểm bồi thường bảo lãnh</td><td class="text-end text-info fw-semibold">@Model.InsuranceTotal.ToString("N0")đ</td><td></td></tr>
                    }
                    @if (Model.CampaignDiscountAmount > 0)
                    {
                        <tr><td colspan="5" class="text-end text-warning fw-semibold"><i class="bi bi-megaphone me-1"></i>Ưu đãi Chiến dịch (@(Model.CampaignMarketing?.CamMarketingName ?? "Khuyến mãi"))</td><td class="text-end fw-semibold text-danger">-@Model.CampaignDiscountAmount.ToString("N0")đ</td><td></td></tr>
                    }
                    @if (Model.CustomerGroupDiscountAmount > 0)
                    {
                        <tr><td colspan="5" class="text-end text-primary fw-semibold"><i class="bi bi-buildings me-1"></i>Chiết khấu Khách đoàn (@(Model.CustomerGroup?.GroupName ?? "Đội xe"))</td><td class="text-end fw-semibold text-danger">-@Model.CustomerGroupDiscountAmount.ToString("N0")đ</td><td></td></tr>
                    }
                    <tr class="fw-bold"><td colspan="5" class="text-end">TỔNG LỆNH SC</td><td class="text-end" style="color:#1d4ed8">@Model.Total.ToString("N0")đ</td><td></td></tr>
                </tfoot>
            </table>
            @if (editable)
            {
                <form asp-action="AddLine" method="post" class="mt-3 p-2 bg-light rounded border">
                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="serviceItemId" id="lineServiceItemId" />
                    <input type="hidden" name="stdManHour" id="lineStdManHour" />
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <select id="servicePicker" class="form-select form-select-sm" onchange="onServiceChange(this)">
                                <option value="">-- Chọn công việc chuẩn Flat Rate (Ser_MST_Service) --</option>
                                @foreach (var s in serviceItems)
                                {
                                    <option value="@s.Id" data-name="@s.Name" data-price="@s.Price" data-hours="@s.StdManHour" data-warranty="@(s.FlagWarranty ? "1" : "0")">
                                        [@s.Code] @s.Name (@s.StdManHour.ToString("0.##")h · @s.Price.ToString("N0")đ@(s.FlagWarranty ? " · BH Hãng" : ""))
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <select id="partPicker" name="partId" class="form-select form-select-sm" onchange="onPartChange(this)">
                                <option value="">-- Chọn phụ tùng từ kho (tùy chọn) --</option>
                                @foreach (var p in parts)
                                {
                                    <option value="@p.Id" data-name="@p.Name" data-price="@p.SalePrice" data-unit="@p.Unit" data-stock="@p.InStock">
                                        [@p.Code] @p.Name (Tồn: @p.InStock.ToString("0.##") @p.Unit · @p.SalePrice.ToString("N0")đ)
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-12 small text-muted d-flex align-items-center">
                            <span id="partStockInfo">Hoặc nhập tay công việc / phụ tùng bên dưới:</span>
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-2">
                            <select id="lineTypeSelect" name="type" class="form-select form-select-sm">
                                <option value="0">Công</option>
                                <option value="1">Phụ tùng</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select id="lineExpenseSelect" name="expenseType" class="form-select form-select-sm" title="Đối tượng thanh toán">
                                <option value="0">Khách trả</option>
                                <option value="1">Bảo hành</option>
                                <option value="2">Bảo hiểm</option>
                                <option value="3">Nội bộ</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <input id="lineNameInput" name="name" class="form-control form-control-sm" placeholder="Nội dung công / tên phụ tùng" required />
                        </div>
                        <div class="col-md-1">
                            <input id="lineQtyInput" name="quantity" type="number" step="0.01" value="1" class="form-control form-control-sm" placeholder="SL" />
                        </div>
                        <div class="col-md-2">
                            <input id="linePriceInput" name="unitPrice" type="number" step="1000" value="0" class="form-control form-control-sm" placeholder="Đơn giá" />
                        </div>
                        <div class="col-md-1">
                            <button class="btn btn-sm btn-primary w-100" title="Thêm dòng"><i class="bi bi-plus-lg"></i></button>
                        </div>
                    </div>
                </form>
            }
        </div></div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-3">Chuyển trạng thái</h6>
            @if (next.Length == 0) { <div class="alert alert-secondary small mb-0">RO đã ở trạng thái kết thúc.</div> }
            @foreach (var n in next)
            {
                var (nt, nc, ncss) = Ui.Status(n);
                <form asp-action="Transition" method="post" class="mb-2">
                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="to" value="@((int)n)" />
                    <button class="btn btn-outline-primary w-100 text-start"><i class="bi bi-arrow-right-circle me-1"></i>@nt <span class="badge bg-@ncss float-end">@nc</span></button>
                </form>
            }
            @if (deletable)
            {
                <form asp-action="Delete" method="post" onsubmit="return confirm('Xóa RO này?')" class="mt-2">
                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn btn-outline-danger w-100"><i class="bi bi-trash me-1"></i>Xóa RO</button>
                </form>
            }
        </div></div>

        <div class="card mb-3"><div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0"><i class="bi bi-cash-coin text-success me-1"></i>Thu ngân &amp; Thanh toán</h6>
                <a href="/Payment/Create?roId=@Model.Id" class="btn btn-sm btn-outline-success"><i class="bi bi-plus-lg me-1"></i>Lập phiếu thu</a>
            </div>
            <div class="p-2 bg-light rounded border mb-2 small">
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Khách phải trả:</span>
                    <span class="fw-semibold">@Model.CustomerTotal.ToString("N0")đ</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Đã thanh toán:</span>
                    <span class="text-success fw-semibold">@Model.PaidAmount.ToString("N0")đ</span>
                </div>
                <div class="d-flex justify-content-between border-top pt-1 mt-1">
                    <span class="fw-bold">Còn thiếu:</span>
                    <span class="fw-bold @(Model.RemainingBalance > 0 ? "text-danger" : "text-success")">
                        @(Model.RemainingBalance > 0 ? $"{Model.RemainingBalance:N0}đ" : "Đã thanh toán đủ")
                    </span>
                </div>
            </div>
            @if (Model.RemainingBalance > 0)
            {
                <form asp-controller="CusDebit" asp-action="CreateFromRO" method="post" class="mb-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="roId" value="@Model.Id" />
                    <input type="hidden" name="amount" value="@Model.RemainingBalance" />
                    <button type="submit" class="btn btn-sm btn-outline-danger w-100" title="Ghi nhận số tiền còn thiếu vào công nợ khách hàng"><i class="bi bi-wallet2 me-1"></i>Ghi nhận công nợ (@Model.RemainingBalance.ToString("N0")đ)</button>
                </form>
            }
            @if (Model.CusDebits.Count > 0)
            {
                <div class="mb-2">
                    <div class="text-muted fw-bold small mb-1"><i class="bi bi-wallet2 text-danger me-1"></i>Công nợ đã ghi nhận:</div>
                    <div class="list-group list-group-flush small mb-2">
                        @foreach (var cd in Model.CusDebits)
                        {
                            var (cstxt, cscode, css) = Ui.CusDebitStatus(cd.Status);
                            <a href="/CusDebit/Detail/@cd.CustomerId" class="list-group-item list-group-item-action px-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">@cd.DebitNo <span class="badge bg-@css font-monospace ms-1" style="font-size:10px">@cscode</span></div>
                                    <div class="text-muted" style="font-size:11px">Nợ: @cd.DebitAmount.ToString("N0")đ · Còn: <span class="text-danger fw-semibold">@cd.RemainAmount.ToString("N0")đ</span></div>
                                </div>
                                <span class="badge bg-light text-dark border">Xem nợ</span>
                            </a>
                        }
                    </div>
                </div>
            }
            @if (Model.InsuranceTotal > 0 && !Model.InsuranceDebits.Any(d => d.Status != InsuranceDebitStatus.Cancelled))
            {
                <form asp-controller="InsuranceDebit" asp-action="CreateFromRo" method="post" class="mb-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="roId" value="@Model.Id" />
                    <input type="hidden" name="debitAmount" value="@Model.InsuranceTotal" />
                    <button type="submit" class="btn btn-sm btn-outline-primary w-100" title="Ghi nhận số tiền bảo hiểm chi trả vào công nợ Hãng bảo hiểm"><i class="bi bi-shield-shaded me-1"></i>Ghi nhận nợ bảo hiểm (@Model.InsuranceTotal.ToString("N0")đ)</button>
                </form>
            }
            @if (Model.InsuranceDebits.Count > 0)
            {
                <div class="mb-2">
                    <div class="text-muted fw-bold small mb-1"><i class="bi bi-shield-shaded text-primary me-1"></i>Công nợ Bảo hiểm:</div>
                    <div class="list-group list-group-flush small mb-2">
                        @foreach (var idb in Model.InsuranceDebits)
                        {
                            var (istxt, iscode, iscss) = Ui.InsuranceDebitStatus(idb.Status);
                            <a href="/InsuranceDebit/DebitDetail/@idb.Id" class="list-group-item list-group-item-action px-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">@idb.DebitNo <span class="badge bg-@iscss font-monospace ms-1" style="font-size:10px">@iscode</span></div>
                                    <div class="text-muted" style="font-size:11px">@idb.InsName · Nợ: @idb.DebitAmount.ToString("N0")đ · Còn: <span class="text-danger fw-semibold">@idb.RemainAmount.ToString("N0")đ</span></div>
                                </div>
                                <span class="badge bg-light text-dark border">Xem nợ</span>
