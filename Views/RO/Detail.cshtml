                            <div>
                                <div class="fw-semibold">@w.ReportNo</div>
                                <div class="text-muted" style="font-size:11px">@w.ClaimAmount.ToString("N0")đ · @w.CreatedAt.ToString("dd/MM/yyyy")</div>
                            </div>
                            <span class="badge bg-@wcss">@wcode</span>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="text-muted small">Chưa có Báo cáo bảo hành cho lệnh này. Nhấn "Lập BCBH" để tạo đề nghị bồi hoàn gửi HTC.</div>
            }
        </div></div>

        <div class="card mb-3"><div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0"><i class="bi bi-shield-shaded text-primary me-1"></i>Hồ sơ bảo hiểm</h6>
                <a href="/Insurance/Create?roId=@Model.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg me-1"></i>Lập hồ sơ BH</a>
            </div>
            @if (Model.InsuranceClaims.Count > 0)
            {
                <div class="list-group list-group-flush small">
                    @foreach (var c in Model.InsuranceClaims)
                    {
                        var (ctxt, ccode, ccss) = Ui.InsuranceClaimStatus(c.Status);
                        <a href="/Insurance/Detail/@c.Id" class="list-group-item list-group-item-action px-0 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold">@c.ClaimNo</div>
                                <div class="text-muted" style="font-size:11px">@c.InsuranceCompany.InsNo · BH duyệt: @c.InsuranceAmount.ToString("N0")đ</div>
                            </div>
                            <span class="badge bg-@ccss">@ccode</span>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="text-muted small">Chưa có Hồ sơ bảo hiểm cho lệnh này. Nhấn "Lập hồ sơ BH" để đề nghị bảo lãnh chi trả bồi thường.</div>
            }
        </div></div>

        <div class="card mb-3"><div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0"><i class="bi bi-headset text-info me-1"></i>Chăm sóc khách hàng 24h</h6>
                @if (Model.CustomerCares.Count == 0 && (Model.Status == ROStatus.Finished || Model.Status == ROStatus.Paid))
                {
                    <a href="/CustomerCare/Create?roId=@Model.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-plus-lg me-1"></i>Tạo phiếu CSKH</a>
                }
            </div>
            @if (Model.CustomerCares.Count > 0)
            {
                <div class="list-group list-group-flush small">
                    @foreach (var c in Model.CustomerCares)
                    {
                        var (ctxt, ccode, ccss) = Ui.CustomerCareStatus(c.Status);
                        <a href="/CustomerCare/Detail/@c.Id" class="list-group-item list-group-item-action px-0 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold">@c.CareNo</div>
                                <div class="text-muted" style="font-size:11px">
                                    @(c.ContactedDate.HasValue ? $"Đã gọi: {c.ContactedDate:dd/MM/yyyy HH:mm}" : "Chưa liên hệ khảo sát")
                                    @if (!string.IsNullOrWhiteSpace(c.ContactedBy)) { <span> · @c.ContactedBy</span> }
                                </div>
                            </div>
                            <span class="badge bg-@ccss">@ccode</span>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="text-muted small">
                    @if (Model.Status == ROStatus.Finished)
                    {
                        <span>Xe đã xuất xưởng. Nhấn "Tạo phiếu CSKH" hoặc hệ thống tự động đưa vào danh sách khảo sát 24h.</span>
                    }
                    else
                    {
                        <span>Quy trình CSKH 24h sẽ tự động kích hoạt khi xe hoàn tất sửa chữa (Giao xe / Finished).</span>
                    }
                </div>
            }
        </div></div>

        <div class="card mb-3"><div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0"><i class="bi bi-journal-bookmark text-primary me-1"></i>Thư viện Kỹ thuật</h6>
                <a href="/TechnicalLibrary/Create?roId=@Model.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg me-1"></i>Đúc kết pan</a>
            </div>
            @if (Model.TechnicalLibraries.Count > 0)
            {
                <div class="list-group list-group-flush small">
                    @foreach (var t in Model.TechnicalLibraries)
                    {
                        var (ttxt, tcode, tcss) = Ui.TechnicalLibraryType(t.Type);
                        var (libStTxt, _, libStCss) = Ui.TechnicalLibraryStatus(t.IsActive);
                        <a href="/TechnicalLibrary/Detail/@t.Id" class="list-group-item list-group-item-action px-0 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold">@t.TechnicalLibraryCode</div>
                                <div class="text-muted text-truncate" style="font-size:11px;max-width:180px">@t.ReRepairRemark</div>
                            </div>
                            <span class="badge bg-@libStCss">@libStTxt</span>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="text-muted small">
                    Ghi nhận giải pháp pan bệnh hoặc phản tu vào Cẩm nang kỹ thuật để chia sẻ toàn xưởng.
                    <div class="mt-1"><a href="/TechnicalLibrary?q=@Model.Car.Model" class="text-decoration-none small"><i class="bi bi-search me-1"></i>Tra cứu cẩm nang cho xe này</a></div>
                </div>
            }
        </div></div>

        <div class="card mb-3"><div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0"><i class="bi bi-calendar2-week text-success me-1"></i>Nhắc bảo dưỡng định kỳ</h6>
                @if (Model.WorkDoneSoon)
                {
                    <span class="badge bg-warning text-dark" title="Khách sắp đến kỳ bảo dưỡng"><i class="bi bi-bell me-1"></i>Sắp đến kỳ</span>
                }
            </div>
            @if (Model.ReminderMaintanceDate.HasValue || Model.ReminderMaintanceKm.HasValue || !string.IsNullOrWhiteSpace(Model.MemberNo))
            {
                <div class="p-2 bg-light rounded border mb-2 small">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Ngày khuyến nghị:</span>
                        <span class="fw-semibold">@(Model.ReminderMaintanceDate?.ToString("dd/MM/yyyy") ?? "—")</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Mốc km kế tiếp:</span>
                        <span class="fw-semibold">@(Model.ReminderMaintanceKm.HasValue ? Model.ReminderMaintanceKm.Value.ToString("N0") + " km" : "—")</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.MemberNo))
                    {
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Số thẻ hội viên:</span>
                            <span class="fw-semibold">@Model.MemberNo</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-muted small mb-2">Chưa thiết lập nhắc bảo dưỡng cho lệnh này.</div>
            }
            @if (editable)
            {
                <form asp-action="UpdateMaintenanceReminder" method="post" class="p-2 bg-light rounded border">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small mb-0">Ngày khuyến nghị</label>
                            <input type="date" name="reminderDate" value="@(Model.ReminderMaintanceDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-0">Mốc km kế tiếp</label>
                            <input type="number" name="reminderKm" value="@Model.ReminderMaintanceKm" min="0" step="500" class="form-control form-control-sm" placeholder="VD: 20000" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small mb-0">Số thẻ hội viên</label>
                            <input type="text" name="memberNo" value="@Model.MemberNo" class="form-control form-control-sm" placeholder="MemberNo (tùy chọn)" />
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="workDoneSoon" value="true" id="workDoneSoonChk" @(Model.WorkDoneSoon ? "checked" : "") />
                                <label class="form-check-label small" for="workDoneSoonChk">Khách sắp đến kỳ bảo dưỡng (WorkDoneSoon)</label>
                            </div>
                        </div>
                        <div class="col-12 text-end">
                            <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-save me-1"></i>Lưu nhắc bảo dưỡng</button>
                        </div>
                    </div>
                </form>
            }
        </div></div>

        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-2">Mốc thời gian</h6>
            <ul class="list-unstyled small mb-0">
                <li class="mb-1"><i class="bi bi-circle-fill text-secondary me-1" style="font-size:7px"></i>Tạo: @Model.CreatedAt.ToString("HH:mm dd/MM")</li>
                @if (Model.IntakeAt != null) { <li class="mb-1"><i class="bi bi-circle-fill text-primary me-1" style="font-size:7px"></i>Vào xưởng: @Model.IntakeAt?.ToString("HH:mm dd/MM")</li> }
                @if (Model.FinishedAt != null) { <li class="mb-1"><i class="bi bi-circle-fill text-success me-1" style="font-size:7px"></i>Giao xe: @Model.FinishedAt?.ToString("HH:mm dd/MM")</li> }
            </ul>
        </div></div>
    </div>
</div>

@if (editable && eligibleCampaigns.Count > 0)
{
    <div class="modal fade" id="applyCampaignModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="ApplyCampaign" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold"><i class="bi bi-megaphone text-warning me-2"></i>Áp dụng Chiến dịch Khuyến mãi vào RO</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small">Hệ thống tìm thấy <b>@eligibleCampaigns.Count</b> chiến dịch CSKH đang chạy phù hợp với dòng xe <b>@Model.Car.Model (@Model.Car.Plate)</b>. Chọn chiến dịch để tính toán giảm giá ưu đãi:</p>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Chiến dịch khả dụng</label>
                            <select name="campaignId" class="form-select" required>
                                <option value="">-- Chọn chiến dịch khuyến mãi --</option>
                                @foreach (var c in eligibleCampaigns)
                                {
                                    <option value="@c.Id">
                                        [@c.CamMarketingNo] @c.CamMarketingName (Công: -@c.DiscountLaborPercent% · Phụ tùng: -@c.DiscountPartPercent%)
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-warning"><i class="bi bi-check-lg me-1"></i>Áp dụng ưu đãi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (editable && servicePackages.Count > 0)
{
    <div class="modal fade" id="applyPackageModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="ApplyPackage" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
