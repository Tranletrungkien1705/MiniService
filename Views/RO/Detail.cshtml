@model RepairOrder
@{
    ViewData["Title"] = $"RO {Model.Code}";
    var (stTxt, stCode, stCss) = Ui.Status(Model.Status);
    var next = (ROStatus[])ViewBag.Next;
    bool editable = Model.Status is not (ROStatus.Finished or ROStatus.Paid or ROStatus.Rejected or ROStatus.NotResponding);
    bool deletable = Model.Status is ROStatus.Created or ROStatus.Printed or ROStatus.Rejected or ROStatus.NotResponding;
}
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3"><div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <h5 class="fw-bold mb-1">@Model.Code <span class="badge bg-@stCss ms-1" title="@stCode">@stTxt</span></h5>
                    <div class="text-muted small"><i class="bi bi-car-front me-1"></i>@Model.Car.Plate · @Model.Car.Model · @Model.Car.Year — <b>@Model.Customer.Name</b> (@Model.Customer.Phone)</div>
                    <div class="small mt-1">Odo: <b>@Model.Odometer.ToString("N0")</b> km · Thợ: <b>@(Model.Technician ?? "—")</b></div>
                    @if (!string.IsNullOrEmpty(Model.IntakeNote)) { <div class="small mt-1 text-muted">Tình trạng: @Model.IntakeNote</div> }
                </div>
            </div>
        </div></div>

        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3">Chi tiết công &amp; phụ tùng</h6>
            <table class="table align-middle">
                <thead><tr><th>Loại</th><th>Nội dung</th><th class="text-end">SL</th><th class="text-end">Đơn giá</th><th class="text-end">Thành tiền</th><th></th></tr></thead>
                <tbody>
                @foreach (var l in Model.Lines)
                {
                    <tr>
                        <td>@if (l.Type == LineType.Labor) { <span class="badge bg-info">Công</span> } else { <span class="badge bg-secondary">Phụ tùng</span> }</td>
                        <td>@l.Name</td>
                        <td class="text-end">@l.Quantity.ToString("0.##")</td>
                        <td class="text-end">@l.UnitPrice.ToString("N0")</td>
                        <td class="text-end fw-semibold">@l.Amount.ToString("N0")</td>
                        <td>@if (editable) { <form asp-action="RemoveLine" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="lineId" value="@l.Id" /><button class="btn btn-sm btn-link text-danger p-0"><i class="bi bi-x-lg"></i></button></form> }</td>
                    </tr>
                }
                @if (Model.Lines.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-3">Chưa có dòng nào.</td></tr> }
                </tbody>
                <tfoot>
                    <tr><td colspan="4" class="text-end text-muted">Tiền công</td><td class="text-end">@Model.LaborTotal.ToString("N0")</td><td></td></tr>
                    <tr><td colspan="4" class="text-end text-muted">Tiền phụ tùng</td><td class="text-end">@Model.PartTotal.ToString("N0")</td><td></td></tr>
                    <tr class="fw-bold"><td colspan="4" class="text-end">TỔNG</td><td class="text-end" style="color:#1d4ed8">@Model.Total.ToString("N0")đ</td><td></td></tr>
                </tfoot>
            </table>
            @if (editable)
            {
                <form asp-action="AddLine" method="post" class="row g-2 mt-1">
                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                    <div class="col-md-2"><select name="type" class="form-select form-select-sm"><option value="0">Công</option><option value="1">Phụ tùng</option></select></div>
                    <div class="col-md-5"><input name="name" class="form-control form-control-sm" placeholder="Nội dung công / tên phụ tùng" required /></div>
                    <div class="col-md-2"><input name="quantity" type="number" step="0.01" value="1" class="form-control form-control-sm" placeholder="SL" /></div>
                    <div class="col-md-2"><input name="unitPrice" type="number" step="1000" value="0" class="form-control form-control-sm" placeholder="Đơn giá" /></div>
                    <div class="col-md-1"><button class="btn btn-sm btn-primary w-100"><i class="bi bi-plus"></i></button></div>
                </form>
            }
        </div></div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-3">Chuyển trạng thái</h6>
            @if (next.Length == 0) { <div class="alert alert-secondary small mb-0">RO đã ở trạng thái kết thúc.</div> }
            @foreach (var n in next)
            {
                var (nt, nc, ncss) = Ui.Status(n);
                <form asp-action="Transition" method="post" class="mb-2">
                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="to" value="@((int)n)" />
                    <button class="btn btn-outline-primary w-100 text-start"><i class="bi bi-arrow-right-circle me-1"></i>@nt <span class="badge bg-@ncss float-end">@nc</span></button>
                </form>
            }
            @if (deletable)
            {
                <form asp-action="Delete" method="post" onsubmit="return confirm('Xóa RO này?')" class="mt-2">
                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn btn-outline-danger w-100"><i class="bi bi-trash me-1"></i>Xóa RO</button>
                </form>
            }
        </div></div>
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-2">Mốc thời gian</h6>
            <ul class="list-unstyled small mb-0">
                <li class="mb-1"><i class="bi bi-circle-fill text-secondary me-1" style="font-size:7px"></i>Tạo: @Model.CreatedAt.ToString("HH:mm dd/MM")</li>
                @if (Model.IntakeAt != null) { <li class="mb-1"><i class="bi bi-circle-fill text-primary me-1" style="font-size:7px"></i>Vào xưởng: @Model.IntakeAt?.ToString("HH:mm dd/MM")</li> }
                @if (Model.FinishedAt != null) { <li class="mb-1"><i class="bi bi-circle-fill text-success me-1" style="font-size:7px"></i>Giao xe: @Model.FinishedAt?.ToString("HH:mm dd/MM")</li> }
            </ul>
        </div></div>
    </div>
</div>
