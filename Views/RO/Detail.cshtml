                        <a href="/PartOO/Detail/@o.Id" class="list-group-item list-group-item-action px-0 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold">@o.OONo - @o.PartName</div>
                                <div class="text-muted" style="font-size:11px">Nợ @o.SoLuongNo.ToString("N0") (còn @o.SoLuongConNo.ToString("N0")) · @(o.NgayHenTra?.ToString("dd/MM/yyyy") ?? "Chưa hẹn")</div>
