                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small">Chọn gói bảo dưỡng chuẩn. Hệ thống sẽ tự động thêm tất cả các dòng tiền công và phụ tùng trong gói vào lệnh sửa chữa <b>@Model.Code</b>.</p>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Gói bảo dưỡng định kỳ</label>
                            <select name="packageId" class="form-select" required>
                                <option value="">-- Chọn gói bảo dưỡng --</option>
                                @foreach (var p in servicePackages)
                                {
                                    <option value="@p.Id">[@p.PackageNo] @p.Name (@p.TakingTimeHours:0.#h · @p.Items.Count mục · @p.Total.ToString("N0")đ)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Xác nhận áp dụng</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
function onServiceChange(sel) {
    var opt = sel.options[sel.selectedIndex];
    if (sel.value) {
        var partPicker = document.getElementById('partPicker');
        if (partPicker) partPicker.value = "";
        var lineTypeSelect = document.getElementById('lineTypeSelect');
        if (lineTypeSelect) lineTypeSelect.value = "0";
        var nameInput = document.getElementById('lineNameInput');
        if (nameInput) nameInput.value = opt.getAttribute('data-name') || '';
        var priceInput = document.getElementById('linePriceInput');
        if (priceInput) priceInput.value = opt.getAttribute('data-price') || 0;
        var hours = opt.getAttribute('data-hours') || '1';
        var qtyInput = document.getElementById('lineQtyInput');
        if (qtyInput) qtyInput.value = hours;
        var serviceItemIdInput = document.getElementById('lineServiceItemId');
        if (serviceItemIdInput) serviceItemIdInput.value = sel.value;
        var stdManHourInput = document.getElementById('lineStdManHour');
        if (stdManHourInput) stdManHourInput.value = hours;
        var isWarranty = opt.getAttribute('data-warranty');
        var expenseSelect = document.getElementById('lineExpenseSelect');
        if (expenseSelect) {
            expenseSelect.value = (isWarranty == "1") ? "1" : "0";
        }
        var stockInfo = document.getElementById('partStockInfo');
        if (stockInfo) {
            stockInfo.innerHTML = '<span class="badge bg-primary-subtle text-primary"><i class="bi bi-wrench-adjustable me-1"></i>Công việc chuẩn: ' + hours + ' giờ định mức' + (isWarranty == "1" ? ' · Bảo hành HTC' : '') + '</span>';
        }
    } else {
        var serviceItemIdInput = document.getElementById('lineServiceItemId');
        if (serviceItemIdInput) serviceItemIdInput.value = "";
        var stdManHourInput = document.getElementById('lineStdManHour');
        if (stdManHourInput) stdManHourInput.value = "";
        var stockInfo = document.getElementById('partStockInfo');
        if (stockInfo) {
            stockInfo.innerText = 'Hoặc nhập tay công việc / phụ tùng bên dưới:';
        }
    }
}

function onPartChange(sel) {
    var opt = sel.options[sel.selectedIndex];
    if (sel.value) {
        var servicePicker = document.getElementById('servicePicker');
        if (servicePicker) servicePicker.value = "";
        var serviceItemIdInput = document.getElementById('lineServiceItemId');
        if (serviceItemIdInput) serviceItemIdInput.value = "";
        var stdManHourInput = document.getElementById('lineStdManHour');
        if (stdManHourInput) stdManHourInput.value = "";
        var lineTypeSelect = document.getElementById('lineTypeSelect');
        if (lineTypeSelect) lineTypeSelect.value = "1";
        var nameInput = document.getElementById('lineNameInput');
        if (nameInput) nameInput.value = opt.getAttribute('data-name') || '';
        var priceInput = document.getElementById('linePriceInput');
        if (priceInput) priceInput.value = opt.getAttribute('data-price') || 0;
        var stock = opt.getAttribute('data-stock');
        var unit = opt.getAttribute('data-unit');
        var stockInfo = document.getElementById('partStockInfo');
        if (stockInfo) {
            stockInfo.innerHTML = '<span class="badge bg-success-subtle text-success"><i class="bi bi-box-seam me-1"></i>Kho còn: ' + stock + ' ' + unit + '</span>';
        }
    } else {
        var stockInfo = document.getElementById('partStockInfo');
        if (stockInfo) {
            stockInfo.innerText = 'Hoặc nhập tay công việc / phụ tùng bên dưới:';
        }
    }
}
</script>
}
