@{ ViewData["Title"] = "Tiếp nhận xe (tạo RO)"; var cars = (List<Car>)ViewBag.Cars; }
<div class="card" style="max-width:680px"><div class="card-body">
    @if (cars.Count == 0)
    {
        <div class="alert alert-warning">Chưa có xe. <a href="/Customer">Thêm khách hàng + xe</a> trước.</div>
    }
    else
    {
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-8"><label class="form-label small text-muted">Xe tiếp nhận *</label>
                    <select name="carId" class="form-select" required><option value="">— Chọn xe —</option>
                        @foreach (var c in cars) { <option value="@c.Id">@c.Plate — @c.Model (@c.Customer.Name)</option> }
                    </select></div>
                <div class="col-md-4"><label class="form-label small text-muted">Số km (odo)</label><input name="odometer" type="number" value="0" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label small text-muted">Thợ phụ trách</label><input name="technician" class="form-control" placeholder="VD: Thợ Hùng" /></div>
                <div class="col-12"><label class="form-label small text-muted">Ghi nhận tình trạng khi nhận xe</label><textarea name="intakeNote" class="form-control" rows="2" placeholder="VD: Xe kêu phanh, đèn báo lỗi động cơ..."></textarea></div>
            </div>
            <div class="mt-3"><button class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Tạo RO (Lập báo giá)</button> <a href="/RO" class="btn btn-outline-secondary">Hủy</a></div>
        </form>
    }
</div></div>
