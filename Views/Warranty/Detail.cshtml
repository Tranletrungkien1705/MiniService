@model WarrantyReport
@{
    ViewData["Title"] = $"Báo cáo bảo hành {Model.ReportNo}";
    var (stTxt, stCode, stCss) = Ui.WarrantyStatus(Model.Status);
    var next = (WarrantyStatus[])ViewBag.Next;
    bool canDelete = Model.Status is WarrantyStatus.Pending or WarrantyStatus.Reverted;
}

<div class="row g-3">
    <div class="col-lg-8">
        <!-- Thông tin hồ sơ & Xe -->
        <div class="card mb-3"><div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h5 class="fw-bold mb-1">
                        @Model.ReportNo
                        <span class="badge bg-@stCss ms-2">@stCode — @stTxt</span>
                    </h5>
                    <div class="text-muted small">
                        Liên kết Lệnh SC: <a href="/RO/Detail/@Model.ROId" class="fw-bold text-decoration-none"><i class="bi bi-clipboard2-pulse me-1"></i>@Model.RO.Code</a>
                        · Ngày lập: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        · Người lập: <b>@Model.CreatedBy</b>
                    </div>
                </div>
                <a href="/Warranty" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Danh sách</a>
            </div>

            <div class="row g-2 p-3 bg-light rounded small">
                <div class="col-md-4">
                    <span class="text-muted">Biển số xe:</span>
                    <div class="fw-bold fs-6">@Model.Car.Plate</div>
                </div>
                <div class="col-md-4">
                    <span class="text-muted">Dòng xe:</span>
                    <div class="fw-bold">@Model.Car.Model (@Model.Car.Year)</div>
                </div>
                <div class="col-md-4">
                    <span class="text-muted">Số khung (VIN):</span>
                    <div class="fw-semibold font-monospace">@(Model.Car.Vin ?? "—")</div>
                </div>
                <div class="col-md-4">
                    <span class="text-muted">Chủ xe / KH:</span>
                    <div class="fw-semibold">@Model.Customer.Name</div>
                </div>
                <div class="col-md-4">
                    <span class="text-muted">Số điện thoại:</span>
                    <div>@(Model.Customer.Phone ?? "—")</div>
                </div>
                <div class="col-md-4">
                    <span class="text-muted">Số Km vào xưởng:</span>
                    <div class="fw-bold text-primary">@Model.Odometer.ToString("N0") km</div>
                </div>
            </div>
        </div></div>

        <!-- Chẩn đoán kỹ thuật -->
        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-tools text-primary me-2"></i>Hiện tượng hư hỏng &amp; Chẩn đoán kỹ thuật</h6>
            <div class="mb-3">
                <div class="text-muted small fw-semibold">Hiện tượng phàn nàn của KH (CusRequest):</div>
                <div class="p-2 bg-light rounded mt-1 border-start border-3 border-warning">@Model.IssueDescription</div>
            </div>
            <div class="mb-3">
                <div class="text-muted small fw-semibold">Kết quả chẩn đoán của KTV (CarStatus):</div>
                <div class="p-2 bg-light rounded mt-1 border-start border-3 border-info">@Model.DiagnosticResult</div>
            </div>
            <div class="row g-2">
                <div class="col-md-4">
                    <div class="p-2 border rounded">
                        <div class="text-muted small">Mã chẩn đoán (DTC):</div>
                        <div class="fw-bold text-danger"><code>@(string.IsNullOrEmpty(Model.ErrorCodeCD) ? "—" : Model.ErrorCodeCD)</code></div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-2 border rounded">
                        <div class="text-muted small">Mã hiện tượng (PN):</div>
                        <div class="fw-bold">@(string.IsNullOrEmpty(Model.ErrorCodePN) ? "—" : Model.ErrorCodePN)</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-2 border rounded">
                        <div class="text-muted small">Phụ tùng lỗi:</div>
                        <div class="fw-semibold text-truncate">@(Model.PartError != null ? $"[{Model.PartError.Code}] {Model.PartError.Name}" : "Chưa xác định")</div>
                    </div>
                </div>
            </div>
        </div></div>

        <!-- Danh sách hạng mục yêu cầu bồi hoàn -->
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-card-checklist text-primary me-2"></i>Hạng mục công &amp; phụ tùng đề nghị bồi hoàn</h6>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Loại</th>
                            <th>Mã</th>
                            <th>Tên hạng mục</th>
                            <th class="text-end">SL</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var it in Model.Items)
                    {
                        <tr>
                            <td>
                                @if (it.Type == LineType.Labor)
                                {
                                    <span class="badge bg-info">Công lao động</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Phụ tùng thay thế</span>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border">@it.Code</span></td>
                            <td class="fw-semibold">@it.Name</td>
                            <td class="text-end">@it.Quantity.ToString("0.##")</td>
                            <td class="text-end">@it.UnitPrice.ToString("N0")</td>
                            <td class="text-end fw-bold">@it.Amount.ToString("N0")đ</td>
                        </tr>
                    }
                    @if (Model.Items.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-3">Không có hạng mục nào.</td></tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr><td colspan="5" class="text-end text-muted">Tổng tiền công đề nghị:</td><td class="text-end">@Model.LaborClaimTotal.ToString("N0")đ</td></tr>
                        <tr><td colspan="5" class="text-end text-muted">Tổng tiền phụ tùng đề nghị:</td><td class="text-end">@Model.PartClaimTotal.ToString("N0")đ</td></tr>
                        <tr class="fw-bold fs-6">
                            <td colspan="5" class="text-end text-primary">TỔNG TIỀN ĐỀ NGHỊ BỒI HOÀN:</td>
                            <td class="text-end text-primary">@Model.ClaimAmount.ToString("N0")đ</td>
                        </tr>
                        @if (Model.ApprovedAmount.HasValue)
                        {
                            <tr class="fw-bold fs-6 bg-success-subtle">
                                <td colspan="5" class="text-end text-success">SỐ TIỀN HÃNG PHÊ DUYỆT BỒI HOÀN:</td>
                                <td class="text-end text-success">@Model.ApprovedAmount.Value.ToString("N0")đ</td>
                            </tr>
                        }
                    </tfoot>
                </table>
            </div>
        </div></div>
    </div>

    <!-- Cột bên phải: Trạng thái & Thao tác -->
    <div class="col-lg-4">
        <!-- Trạng thái & Chuyển bước -->
        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-shuffle me-1"></i>Quy trình phê duyệt (State Machine)</h6>
            
            <div class="mb-3">
                <div class="small text-muted mb-1">Trạng thái hiện tại:</div>
                <div class="alert alert-@stCss py-2 px-3 mb-0 d-flex align-items-center justify-content-between">
                    <b>@stTxt</b>
                    <span class="badge bg-@stCss">@stCode</span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.DecisionNote))
            {
                <div class="alert alert-success small mb-3">
                    <i class="bi bi-chat-left-quote me-1"></i><b>Ý kiến HTC:</b> @Model.DecisionNote
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.RejectionReason))
            {
                <div class="alert alert-danger small mb-3">
                    <i class="bi bi-exclamation-octagon me-1"></i><b>Lý do:</b> @Model.RejectionReason
                </div>
            }

            @if (next.Length > 0)
            {
                <div class="small fw-semibold text-secondary mb-2">Thao tác tiếp theo:</div>

                @if (next.Contains(WarrantyStatus.Sent))
                {
                    <form asp-action="Transition" method="post" class="mb-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="to" value="@((int)WarrantyStatus.Sent)" />
                        <button class="btn btn-warning w-100 text-start" onclick="return confirm('Gửi hồ sơ bảo hành này lên nhà phân phối HTC?')">
                            <i class="bi bi-send me-1"></i>Gửi hồ sơ lên HTC <span class="badge bg-dark float-end">SENT</span>
                        </button>
                    </form>
                }

                @if (next.Contains(WarrantyStatus.Confirmed))
                {
                    <form asp-action="Transition" method="post" class="mb-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="to" value="@((int)WarrantyStatus.Confirmed)" />
                        <button class="btn btn-info text-white w-100 text-start" onclick="return confirm('HTC xác nhận đã tiếp nhận đầy đủ hồ sơ hợp lệ?')">
                            <i class="bi bi-check2-circle me-1"></i>HTC Xác nhận hồ sơ <span class="badge bg-dark float-end">CONF</span>
                        </button>
                    </form>
                }

                @if (next.Contains(WarrantyStatus.Accepted))
                {
                    <button type="button" class="btn btn-success w-100 text-start mb-2" data-bs-toggle="modal" data-bs-target="#acceptModal">
                        <i class="bi bi-award me-1"></i>Hãng chấp thuận bồi hoàn <span class="badge bg-dark float-end">ACCE</span>
                    </button>
                }

                @if (next.Contains(WarrantyStatus.Rejected))
                {
                    <button type="button" class="btn btn-danger w-100 text-start mb-2" data-bs-toggle="modal" data-bs-target="#rejectModal">
                        <i class="bi bi-x-circle me-1"></i>Hãng từ chối bồi hoàn <span class="badge bg-dark float-end">REJ</span>
                    </button>
                }

                @if (next.Contains(WarrantyStatus.Reverted))
                {
                    <button type="button" class="btn btn-secondary w-100 text-start mb-2" data-bs-toggle="modal" data-bs-target="#revertModal">
                        <i class="bi bi-arrow-return-left me-1"></i>Yêu cầu bổ sung hồ sơ <span class="badge bg-dark float-end">REVERT</span>
                    </button>
                }
            }
            else
            {
                <div class="alert alert-secondary small mb-0">Hồ sơ đã ở trạng thái kết thúc.</div>
            }

            @if (canDelete)
            {
                <form asp-action="Delete" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa Báo cáo bảo hành này?')" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn btn-outline-danger btn-sm w-100"><i class="bi bi-trash me-1"></i>Xóa Báo cáo bảo hành</button>
                </form>
            }
        </div></div>

        <!-- Mốc thời gian -->
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-clock-history me-1"></i>Lịch sử mốc thời gian</h6>
            <ul class="list-unstyled small mb-0">
                <li class="mb-2">
                    <i class="bi bi-circle-fill text-secondary me-2" style="font-size:8px"></i>
                    <b>Khởi tạo:</b> @Model.CreatedAt.ToString("HH:mm dd/MM/yyyy")
                </li>
                @if (Model.SubmittedAt.HasValue)
                {
                    <li class="mb-2">
                        <i class="bi bi-circle-fill text-warning me-2" style="font-size:8px"></i>
                        <b>Gửi duyệt HTC:</b> @Model.SubmittedAt?.ToString("HH:mm dd/MM/yyyy")
                    </li>
                }
                @if (Model.DecidedAt.HasValue)
                {
                    <li class="mb-2">
                        <i class="bi bi-circle-fill @(Model.Status == WarrantyStatus.Accepted ? "text-success" : "text-danger") me-2" style="font-size:8px"></i>
                        <b>Ra quyết định:</b> @Model.DecidedAt?.ToString("HH:mm dd/MM/yyyy")
                    </li>
                }
            </ul>
        </div></div>
    </div>
</div>

<!-- Modal Chấp thuận bồi hoàn -->
<div class="modal fade" id="acceptModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Transition" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="to" value="@((int)WarrantyStatus.Accepted)" />
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-success"><i class="bi bi-award me-1"></i>Chấp thuận bồi hoàn bảo hành</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Số tiền bồi hoàn được phê duyệt (VNĐ)</label>
                    <input name="approvedAmount" type="number" step="1000" value="@Model.ClaimAmount" class="form-control" required />
                    <div class="form-text">Mặc định bằng tổng tiền đề nghị (@Model.ClaimAmount.ToString("N0")đ). Có thể điều chỉnh nếu hãng duyệt một phần.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Ghi chú phê duyệt của HTC</label>
                    <textarea name="note" rows="2" class="form-control" placeholder="HTC chấp thuận bồi hoàn toàn bộ chi phí theo chính sách bảo hành..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="submit" class="btn btn-success"><i class="bi bi-check-lg me-1"></i>Xác nhận Chấp thuận</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Từ chối -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Transition" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="to" value="@((int)WarrantyStatus.Rejected)" />
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-danger"><i class="bi bi-x-circle me-1"></i>Từ chối bảo hành</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Lý do từ chối bảo hành <span class="text-danger">*</span></label>
                    <textarea name="note" rows="3" class="form-control" placeholder="Ghi rõ lý do hãng từ chối (VD: Xe đã hết hạn bảo hành, hư hỏng do tác động ngoại lực...)" required></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="submit" class="btn btn-danger"><i class="bi bi-x-lg me-1"></i>Xác nhận Từ chối</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Yêu cầu bổ sung hồ sơ -->
<div class="modal fade" id="revertModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Transition" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="to" value="@((int)WarrantyStatus.Reverted)" />
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-secondary"><i class="bi bi-arrow-return-left me-1"></i>Yêu cầu bổ sung hồ sơ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Yêu cầu đại lý bổ sung thông tin gì? <span class="text-danger">*</span></label>
                    <textarea name="note" rows="3" class="form-control" placeholder="VD: Yêu cầu đính kèm ảnh chụp mã phụ tùng lỗi và dữ liệu scan chẩn đoán DTC..." required></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-send me-1"></i>Gửi yêu cầu bổ sung</button>
            </div>
        </form>
    </div>
</div>
