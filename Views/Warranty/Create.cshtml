@{
    ViewData["Title"] = "Lập Báo cáo bảo hành (Warranty Report)";
    var ros = (List<RepairOrder>)ViewBag.ROs;
    var parts = (List<Part>)ViewBag.Parts;
    int? selectedRoId = (int?)ViewBag.SelectedRoId;
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold mb-1"><i class="bi bi-shield-plus text-primary me-2"></i>Lập Báo cáo bảo hành xe</h5>
                        <div class="text-muted small">Tạo hồ sơ đề nghị bồi hoàn bảo hành gửi nhà phân phối HTC/HMC theo chuẩn idn.CarService</div>
                    </div>
                    <a href="/Warranty" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Lệnh sửa chữa (RO) áp dụng <span class="text-danger">*</span></label>
                        <select name="roId" class="form-select" required>
                            <option value="">-- Chọn lệnh sửa chữa (RO) có yêu cầu bảo hành --</option>
                            @foreach (var r in ros)
                            {
                                bool isSel = selectedRoId.HasValue && selectedRoId.Value == r.Id;
                                <option value="@r.Id" selected="@isSel">
                                    [@r.Code] Xe @r.Car.Plate (@r.Car.Model) — KH: @r.Customer.Name — Tổng: @r.Total.ToString("N0")đ
                                    @(r.WarrantyTotal > 0 ? $" (Hạng mục BH: {r.WarrantyTotal:N0}đ)" : "")
                                </option>
                            }
                        </select>
                        <div class="form-text">Các hạng mục công và phụ tùng thuộc lệnh sửa chữa sẽ được tự động kết chuyển vào hồ sơ bảo hành.</div>
                    </div>

                    <div class="card bg-light border-0 mb-3"><div class="card-body">
                        <h6 class="fw-bold text-dark mb-3"><i class="bi bi-clipboard2-pulse me-1 text-primary"></i>Thông tin kỹ thuật &amp; Sự cố hư hỏng</h6>
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label small fw-semibold">Hiện tượng / Phàn nàn của khách hàng (CusRequest) <span class="text-danger">*</span></label>
                                <textarea name="issueDesc" rows="2" class="form-control" placeholder="Mô tả hiện tượng xe gặp phải (VD: Động cơ rung giật khi tăng tốc, đèn Check Engine sáng nhấp nháy...)" required></textarea>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label small fw-semibold">Kết quả chẩn đoán kỹ thuật viên (CarStatus) <span class="text-danger">*</span></label>
                                <textarea name="diagResult" rows="2" class="form-control" placeholder="Nguyên nhân hư hỏng được kỹ thuật viên xác định (VD: Lỗi bỏ lửa xy-lanh 2 do nứt cách điện sứ bugi...)" required></textarea>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Mã chẩn đoán DTC (ErrorCodeCD)</label>
                                <input name="errCodeCD" class="form-control" placeholder="VD: P0302, P0133, DTC-01" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Mã vị trí / hiện tượng (ErrorCodePN)</label>
                                <input name="errCodePN" class="form-control" placeholder="VD: ENG-IGN-02, ENG-LEAK-01" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Phụ tùng lỗi gây sự cố (PartIDError)</label>
                                <select name="partIdError" class="form-select">
                                    <option value="">-- Chọn phụ tùng lỗi (nếu có) --</option>
                                    @foreach (var p in parts)
                                    {
                                        <option value="@p.Id">[@p.Code] @p.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div></div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="/Warranty" class="btn btn-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i>Lập Báo cáo bảo hành</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
