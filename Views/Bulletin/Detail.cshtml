@model Bulletin
@{
    ViewData["Title"] = $"Bản tin kỹ thuật {Model.BulletinNo}";
    var (stTxt, stCode, stCss) = Ui.BulletinStatus(Model.Status);
    var eligibleROs = (List<RepairOrder>?)ViewBag.EligibleROs ?? [];
    var openROs = eligibleROs.Where(r => r.Status is not (ROStatus.Finished or ROStatus.Paid or ROStatus.Rejected or ROStatus.NotResponding)).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center gap-2">
        <a href="/Bulletin" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Danh sách TSB</a>
        <h5 class="fw-bold mb-0">@Model.BulletinNo <span class="badge bg-@stCss ms-1">@stTxt</span></h5>
        @if (!Model.IsActive)
        {
            <span class="badge bg-secondary">Tạm dừng hiệu lực</span>
        }
    </div>
    <div class="d-flex gap-2">
        <a href="/Bulletin/Print/@Model.Id" target="_blank" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-printer me-1"></i>In bản tin TSB
        </a>
        <form asp-action="ToggleActive" method="post" class="d-inline">
            @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-sm @(Model.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                <i class="bi @(Model.IsActive ? "bi-pause-circle" : "bi-play-circle") me-1"></i>@(Model.IsActive ? "Tạm dừng" : "Kích hoạt lại")
            </button>
        </form>
        @if (Model.Status == BulletinStatus.Active)
        {
            <form asp-action="Transition" method="post" class="d-inline">
                @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="to" value="@((int)BulletinStatus.Finished)" />
                <button type="submit" class="btn btn-sm btn-outline-info" onclick="return confirm('Chuyển trạng thái sang Đã kết thúc chiến dịch?')">
                    <i class="bi bi-check-circle me-1"></i>Kết thúc chiến dịch
                </button>
            </form>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <!-- Thông tin tổng quan Bản tin -->
        <div class="card mb-3"><div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h5 class="fw-bold mb-1 text-primary">@Model.Title</h5>
                    <div class="text-muted small">
                        Mã bản tin HMC: <b class="font-monospace text-dark">@(Model.BulletinNoHMC ?? "—")</b> · Ban hành: <b>@Model.CreateDate.ToString("dd/MM/yyyy")</b>
                        @if (Model.DateExpired.HasValue)
                        {
                            <span> · Hạn: <b class="@(Model.IsExpired ? "text-danger" : "text-dark")">@Model.DateExpired.Value.ToString("dd/MM/yyyy")</b></span>
                        }
                    </div>
                    <div class="small text-muted mt-1">
                        Đơn vị ban hành: <b class="text-dark">@Model.UserCreate</b>
                        @if (!string.IsNullOrEmpty(Model.FileNameAttachment))
                        {
                            <span class="ms-3"><i class="bi bi-paperclip me-1 text-primary"></i><span class="font-monospace text-primary">@Model.FileNameAttachment</span></span>
                        }
                    </div>
                </div>
            </div>

            <div class="mt-3 pt-3 border-top">
                <h6 class="fw-bold mb-1 text-dark"><i class="bi bi-exclamation-circle text-warning me-1"></i>Hiện tượng hư hỏng &amp; Nguyên nhân kỹ thuật</h6>
                <div class="p-3 bg-light rounded text-secondary small" style="white-space: pre-line">@(string.IsNullOrWhiteSpace(Model.Remark) ? "Chưa có mô tả hiện tượng kỹ thuật." : Model.Remark)</div>
            </div>

            <div class="mt-3 pt-3 border-top">
                <h6 class="fw-bold mb-1 text-success"><i class="bi bi-tools me-1"></i>Phương án khắc phục &amp; Hướng dẫn xử lý tiêu chuẩn HTC</h6>
                <div class="p-3 bg-light rounded text-dark small" style="white-space: pre-line">@(string.IsNullOrWhiteSpace(Model.Solution) ? "Chưa có quy trình xử lý kỹ thuật." : Model.Solution)</div>
            </div>
        </div></div>

        <!-- Danh mục công việc & Phụ tùng thay thế bảo hành -->
        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-box-seam text-primary me-2"></i>Hạng mục công việc &amp; Phụ tùng thay thế (Bảo hành hãng 100%)</h6>
            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:100px">Phân loại</th>
                            <th style="width:140px">Mã hạng mục</th>
                            <th>Tên công việc / Phụ tùng</th>
                            <th style="width:90px" class="text-center">Số lượng</th>
                            <th style="width:120px" class="text-end">Định mức BH</th>
                            <th>Ghi chú kỹ thuật</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center py-3 text-muted">Bản tin này chưa khai báo danh mục phụ tùng / công việc.</td></tr>
                        }
                        @foreach (var it in Model.Items)
                        {
                            <tr>
                                <td>
                                    <span class="badge @(it.Type == LineType.Labor ? "bg-info" : "bg-warning text-dark")">@Ui.Line(it.Type)</span>
                                </td>
                                <td class="font-monospace fw-semibold">@it.Code</td>
                                <td class="fw-semibold">@it.Name</td>
                                <td class="text-center">@it.Quantity.ToString("N0") @it.Unit</td>
                                <td class="text-end fw-semibold">
                                    @(it.UnitPrice > 0 ? it.UnitPrice.ToString("N0") + "đ" : "Miễn phí")
                                </td>
                                <td class="small text-muted">@it.Note</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div></div>

        <!-- Danh sách xe áp dụng theo số khung VIN -->
        <div class="card mb-3"><div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h6 class="fw-bold mb-0"><i class="bi bi-car-front text-primary me-2"></i>Danh sách xe áp dụng theo số khung VIN (@Model.TargetVins.Count xe)</h6>
                    <div class="text-muted small">Cập nhật tiến độ triệu hồi hoặc nạp vào Lệnh sửa chữa khi xe đến xưởng dịch vụ.</div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Số khung VIN</th>
                            <th>Biển số &amp; Model</th>
                            <th>Trạng thái triệu hồi</th>
                            <th>Hoàn thành</th>
                            <th>Lệnh RO</th>
                            <th class="text-end">Đổi trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.TargetVins.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center py-3 text-muted">Chưa có số khung xe VIN nào được gắn vào bản tin này.</td></tr>
                        }
                        @foreach (var vin in Model.TargetVins)
                        {
                            var (vtxt, _, vcss) = Ui.BulletinVinStatus(vin.Status);
                            <tr>
                                <td class="font-monospace fw-bold text-primary">@vin.VinNo</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(vin.PlateNo))
                                    {
                                        <span class="fw-semibold">@vin.PlateNo</span>
                                    }
                                    <span class="text-muted small ms-1">(@(vin.Model ?? "—"))</span>
                                </td>
                                <td>
                                    <span class="badge bg-@vcss">@vtxt</span>
                                </td>
                                <td class="small">
                                    @if (vin.Status == BulletinVinStatus.Completed)
                                    {
                                        <div>@vin.DateDone?.ToString("dd/MM/yyyy HH:mm")</div>
                                        <div class="text-muted" style="font-size:11px">KTV: @(vin.DoneBy ?? "—")</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(vin.RONo))
                                    {
                                        @if (vin.ROId.HasValue)
                                        {
                                            <a href="/RO/Detail/@vin.ROId.Value" class="badge bg-light text-dark border text-decoration-none">
                                                <i class="bi bi-link-45deg me-1"></i>@vin.RONo
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">@vin.RONo</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <form asp-action="UpdateVinStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="vinId" value="@vin.Id" />
                                        <input type="hidden" name="bulletinId" value="@Model.Id" />
                                        @if (vin.Status == BulletinVinStatus.Pending)
                                        {
                                            <input type="hidden" name="status" value="@((int)BulletinVinStatus.Completed)" />
                                            <input type="hidden" name="doneBy" value="Cố vấn dịch vụ" />
                                            <button type="submit" class="btn btn-xs btn-outline-success" title="Đánh dấu đã hoàn thành">
                                                <i class="bi bi-check2"></i> Xong
                                            </button>
                                        }
                                        else
                                        {
                                            <input type="hidden" name="status" value="@((int)BulletinVinStatus.Pending)" />
                                            <button type="submit" class="btn btn-xs btn-outline-warning" title="Chuyển về chưa xử lý">
                                                <i class="bi bi-arrow-counterclockwise"></i> Mở lại
                                            </button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Form Bổ sung thêm số VIN vào bản tin -->
            <div class="mt-3 pt-3 border-top">
                <a class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" href="#collapseAddVins">
                    <i class="bi bi-plus-circle me-1"></i>Bổ sung thêm danh sách số VIN vào bản tin
                </a>
                <div class="collapse mt-2" id="collapseAddVins">
                    <form asp-action="AddVins" method="post" class="card card-body bg-light">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bulletinId" value="@Model.Id" />
                        <div class="row g-2">
                            <div class="col-md-8">
                                <label class="form-label small fw-semibold">Danh sách số khung VIN (phân tách bởi dấu phẩy, khoảng trắng hoặc xuống dòng):</label>
                                <textarea name="vinListRaw" class="form-control form-control-sm font-monospace text-uppercase" rows="3" placeholder="RLHXXTC009&#10;RLHXXTC010&#10;RLHXXTC011"></textarea>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Dòng xe áp dụng:</label>
                                <input type="text" name="targetModel" class="form-control form-control-sm" placeholder="VD: Hyundai Tucson 2023" />
                                <button type="submit" class="btn btn-primary btn-sm w-100 mt-3">
                                    <i class="bi bi-plus-lg me-1"></i>Thêm VINs
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div></div>

        <!-- Danh sách Lệnh sửa chữa RO đã áp dụng TSB này -->
        @if (Model.AppliedROs.Count > 0)
        {
            <div class="card mb-3"><div class="card-body">
                <h6 class="fw-bold mb-2"><i class="bi bi-clipboard2-pulse text-success me-2"></i>Lệnh sửa chữa RO đã áp dụng bản tin này (@Model.AppliedROs.Count RO)</h6>
                <div class="list-group list-group-flush small">
                    @foreach (var r in Model.AppliedROs)
                    {
                        var (rst, _, rcss) = Ui.Status(r.Status);
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <div>
                                <a href="/RO/Detail/@r.Id" class="fw-bold text-decoration-none">@r.Code</a>
                                <span class="ms-2">@r.Car?.Plate · @r.Car?.Model</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-@rcss">@rst</span>
                                <a href="/RO/Detail/@r.Id" class="btn btn-outline-primary btn-xs">Xem RO</a>
                            </div>
                        </div>
                    }
                </div>
            </div></div>
        }
    </div>

    <div class="col-lg-4">
        <!-- Thống kê tiến độ thực hiện -->
        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-pie-chart text-success me-2"></i>Tiến độ thực hiện triệu hồi</h6>
            <div class="text-center py-2">
                <div class="stat-num text-success">@Model.CompletionRate%</div>
                <div class="text-muted small">Tỷ lệ hoàn thành chiến dịch</div>
            </div>
            <div class="progress mb-3" style="height:10px">
                <div class="progress-bar bg-success" role="progressbar" style="width: @(Model.CompletionRate)%" aria-valuenow="@Model.CompletionRate" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
            <div class="d-flex justify-content-between small border-bottom py-2">
                <span class="text-muted">Tổng số xe áp dụng:</span>
                <span class="fw-bold">@Model.TotalVinCount xe</span>
            </div>
            <div class="d-flex justify-content-between small border-bottom py-2">
                <span class="text-muted">Đã thực hiện xong:</span>
                <span class="fw-bold text-success">@Model.CompletedVinCount xe</span>
            </div>
            <div class="d-flex justify-content-between small py-2">
                <span class="text-muted">Chờ triệu hồi / xử lý:</span>
                <span class="fw-bold text-warning">@Model.PendingVinCount xe</span>
            </div>
        </div></div>

        <!-- Nạp bản tin vào Lệnh RO đang mở -->
        @if (openROs.Count > 0 && Model.IsActive)
        {
            <div class="card mb-3 border-primary"><div class="card-body">
                <h6 class="fw-bold mb-2 text-primary"><i class="bi bi-box-arrow-in-down-right me-1"></i>Nạp TSB vào Lệnh sửa chữa</h6>
                <div class="text-muted small mb-2">Chọn một lệnh RO đang mở tại xưởng để nạp phụ tùng và tiền công triệu hồi:</div>
                <form asp-action="ApplyToRO" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bulletinId" value="@Model.Id" />
                    <div class="mb-2">
                        <select name="roId" class="form-select form-select-sm" required>
                            <option value="">-- Chọn lệnh RO đang sửa --</option>
                            @foreach (var ro in openROs)
                            {
                                <option value="@ro.Id">@ro.Code — @ro.Car?.Plate (@ro.Car?.Model)</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm w-100" onclick="return confirm('Nạp phụ tùng và công triệu hồi vào lệnh RO đã chọn?')">
                        <i class="bi bi-plus-lg me-1"></i>Nạp vào RO ngay
                    </button>
                </form>
            </div></div>
        }

        <!-- Xóa bản tin -->
        @if (Model.AppliedROs.Count == 0)
        {
            <div class="card border-danger"><div class="card-body">
                <h6 class="fw-bold text-danger mb-2">Xóa bản tin kỹ thuật</h6>
                <div class="text-muted small mb-2">Chỉ xóa được bản tin khi chưa liên kết với bất kỳ Lệnh sửa chữa RO nào.</div>
                <form asp-action="Delete" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bản tin kỹ thuật này?')">
                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-danger btn-sm w-100"><i class="bi bi-trash me-1"></i>Xóa bản tin này</button>
                </form>
            </div></div>
        }
    </div>
</div>
