@model PdiRequest
@{
    Layout = null;
    var selectedItem = (PdiRequestItem?)ViewBag.SelectedItem ?? Model.Items.FirstOrDefault();
    var (stTxt, _, _) = Ui.PdiRequestStatus(Model.Status);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Biên bản PDI @Model.PdiReqNo @(selectedItem != null ? $"— {selectedItem.Model} ({selectedItem.VIN})" : "") — Hyundai Car Service</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        body { font-family: "Segoe UI", Arial, sans-serif; font-size: 12.5px; color: #1f2937; background: #fff; }
        .print-container { max-width: 860px; margin: 20px auto; padding: 24px; border: 1px solid #d1d5db; border-radius: 8px; }
        .table-custom th, .table-custom td { padding: 4px 8px; font-size: 11.5px; }
        .pdi-group-hdr { background: #f1f5f9; font-weight: bold; color: #1e3a8a; }
        @@media print {
            .no-print { display: none !important; }
            .print-container { border: none !important; margin: 0 !important; padding: 0 !important; max-width: 100% !important; }
            body { font-size: 11px; }
            .table-custom th, .table-custom td { padding: 3px 6px; font-size: 10.5px; }
        }
    </style>
</head>
<body>

<div class="no-print bg-light border-bottom p-3 mb-3 text-center sticky-top">
    <button onclick="window.print()" class="btn btn-primary btn-sm me-2 fw-bold">
        <i class="bi bi-printer me-1"></i>In Biên bản PDI (Print)
    </button>
    <button onclick="window.close()" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-x-circle me-1"></i>Đóng
    </button>
</div>

<div class="print-container">
    <!-- Header đại lý Hyundai -->
    <div class="row align-items-center border-bottom pb-3 mb-2">
        <div class="col-8">
            <h5 class="fw-bold text-uppercase mb-0 text-primary">HYUNDAI THÀNH CÔNG VIỆT NAM</h5>
            <div class="fw-semibold small">ĐẠI LÝ ỦY QUYỀN CHÍNH HÃNG: @Model.DealerCode</div>
            <div class="text-muted small">XƯỞNG DỊCH VỤ SỬA CHỮA, BẢO DƯỠNG &amp; KIỂM TRA CHẤT LƯỢNG XE MỚI</div>
            <div class="text-muted small" style="font-size:11px">Hotline CSKH: 1900-561212 · Website: https://hyundai.thanhcong.vn</div>
        </div>
        <div class="col-4 text-end">
            <div class="fw-bold fs-6 text-uppercase text-danger">PHIẾU KIỂM TRA PDI</div>
            <div class="text-muted small font-monospace">Số phiếu: <b>@Model.PdiReqNo</b></div>
            <div class="text-muted small">Ngày lập: <b>@Model.CreatedDate.ToString("dd/MM/yyyy")</b></div>
            <div class="text-muted small">Đơn vị: <b>@Model.CreatedBy</b></div>
        </div>
    </div>

    <!-- Tiêu đề chính -->
    <div class="text-center my-3">
        <h4 class="fw-bold text-uppercase mb-1 text-dark">BIÊN BẢN KIỂM TRA XUẤT XƯỞNG XE MỚI (PDI)</h4>
        <div class="small text-muted fst-italic fw-semibold">(PRE-DELIVERY INSPECTION &amp; QUALITY RELEASE CERTIFICATE)</div>
    </div>

    @if (selectedItem != null)
    {
        <!-- Thông tin xe & khách hàng -->
        <table class="table table-bordered table-custom mb-3">
            <tbody>
                <tr>
                    <td style="width:18%" class="bg-light fw-bold">Tên khách hàng:</td>
                    <td style="width:32%"><b>@selectedItem.CustomerName</b></td>
                    <td style="width:18%" class="bg-light fw-bold">Số hợp đồng bán:</td>
                    <td style="width:32%"><b class="font-monospace text-primary">@selectedItem.ContractNo</b></td>
                </tr>
                <tr>
                    <td class="bg-light fw-bold">Số điện thoại KH:</td>
                    <td>@(selectedItem.CustomerPhone ?? "—")</td>
                    <td class="bg-light fw-bold">Ngày dự kiến giao:</td>
                    <td><b class="text-danger">@selectedItem.ExpectedDeliveryDate.ToString("dd/MM/yyyy")</b></td>
                </tr>
                <tr>
                    <td class="bg-light fw-bold">Dòng xe (Model):</td>
                    <td><b class="fs-6 text-primary">@selectedItem.Model</b></td>
                    <td class="bg-light fw-bold">Phiên bản (Spec):</td>
                    <td>@(selectedItem.Spec ?? "Tiêu chuẩn")</td>
                </tr>
                <tr>
                    <td class="bg-light fw-bold">Số khung (VIN):</td>
                    <td><b class="font-monospace text-primary">@selectedItem.VIN</b></td>
                    <td class="bg-light fw-bold">Màu sơn xe:</td>
                    <td>@(selectedItem.Color ?? "Tiêu chuẩn")</td>
                </tr>
                <tr>
                    <td class="bg-light fw-bold">Số máy (Engine No):</td>
                    <td class="font-monospace">@(selectedItem.EngineNo ?? "—")</td>
                    <td class="bg-light fw-bold">Mã bình ắc quy:</td>
                    <td class="font-monospace">@(selectedItem.BatteryNo ?? "—")</td>
                </tr>
                <tr>
                    <td class="bg-light fw-bold">Lệnh sửa chữa (RO):</td>
                    <td>
                        @(selectedItem.RONo != null ? selectedItem.RONo : "Kiểm tra trực tiếp tại trạm PDI")
                    </td>
                    <td class="bg-light fw-bold">Trạng thái PDI:</td>
                    <td>
                        @if (selectedItem.Status == PdiItemStatus.Passed)
                        {
                            <span class="badge bg-success">ĐẠT CHUẨN XUẤT XƯỞNG (PASSED)</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">ĐANG KIỂM TRA HOÀN THIỆN</span>
                        }
                    </td>
                </tr>
                @if (selectedItem.FlagAccessory)
                {
                    <tr>
                        <td class="bg-light fw-bold text-warning">Gói phụ kiện giao xe:</td>
                        <td colspan="3"><b class="text-dark">@(selectedItem.AccessoryNote ?? "Lắp đặt theo hợp đồng giao xe")</b></td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Bảng 25 điểm kiểm tra chất lượng PDI -->
        <h6 class="fw-bold mb-2 text-uppercase" style="font-size:12px">
            <i class="bi bi-card-checklist text-primary me-1"></i>Bảng đánh giá 25 tiêu chuẩn kiểm tra xuất xưởng PDI
        </h6>
        <table class="table table-bordered table-sm table-custom mb-3">
            <thead class="table-light text-center">
                <tr>
                    <th style="width:40px">STT</th>
                    <th style="width:180px">Nhóm kiểm tra</th>
                    <th>Hạng mục tiêu chuẩn kỹ thuật</th>
                    <th style="width:110px">Kết quả</th>
                    <th style="width:180px">Ghi chú</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int idx = 1;
                    string currentGrp = "";
                }
                @foreach (var c in selectedItem.ChecklistItems)
                {
                    if (c.Group != currentGrp)
                    {
                        currentGrp = c.Group;
                        <tr class="pdi-group-hdr">
                            <td colspan="5" class="py-1">@currentGrp</td>
                        </tr>
                    }
                    <tr>
                        <td class="text-center text-muted">@(idx++)</td>
                        <td class="text-muted small">@c.Group</td>
                        <td>
                            <b>@c.Name</b>
                            <span class="text-muted small font-monospace ms-1">(@c.Code)</span>
                        </td>
                        <td class="text-center fw-semibold">
                            @if (c.Status == AuditStatus.Good)
                            {
                                <span class="text-success">✅ ĐẠT</span>
                            }
                            else if (c.Status == AuditStatus.Attention)
                            {
                                <span class="text-warning">⚠️ Chú ý</span>
                            }
                            else if (c.Status == AuditStatus.Replace)
                            {
                                <span class="text-danger">❌ Cần sửa</span>
                            }
                            else
                            {
                                <span class="text-muted">⚪ K/A</span>
                            }
                        </td>
                        <td class="small text-muted">@(c.Note ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Nhận xét và kết luận -->
        <div class="border rounded p-2 mb-3 bg-light">
            <div class="fw-bold small mb-1 text-primary"><i class="bi bi-chat-left-text me-1"></i>Đánh giá &amp; Kết luận của Kỹ thuật viên PDI:</div>
            <div class="small fst-italic">
                @(selectedItem.InspectionNotes ?? "Xe đã được kiểm tra toàn diện 25 hạng mục theo tiêu chuẩn Hyundai Toàn cầu, vận hành động cơ êm ái, các hệ thống an toàn, chiếu sáng, điều hòa và phụ kiện hoạt động hoàn hảo. Xe đạt tiêu chuẩn xuất xưởng bàn giao.")
            </div>
            <div class="text-muted mt-1 small" style="font-size:11px">
                Thời điểm kiểm tra: @(selectedItem.InspectionDate?.ToString("dd/MM/yyyy HH:mm") ?? DateTime.Now.ToString("dd/MM/yyyy HH:mm")) · KTV: <b>@(selectedItem.Inspector ?? "KTV PDI")</b>
            </div>
        </div>

        <div class="alert alert-success py-2 mb-4 text-center fw-bold small">
            <i class="bi bi-shield-check me-1"></i>XÁC NHẬN XE ĐỦ TIÊU CHUẨN XUẤT XƯỞNG VÀ SẴN SÀNG BÀN GIAO CHO KHÁCH HÀNG
        </div>
    }

    <!-- 4 Chữ ký xác nhận bàn giao -->
    <div class="row text-center mt-4 pt-2">
        <div class="col-3">
            <div class="fw-bold small text-uppercase">KỸ THUẬT VIÊN PDI</div>
            <div class="text-muted" style="font-size:10px">(Kiểm tra &amp; xác nhận)</div>
            <div style="height:55px;"></div>
            <div class="fw-semibold">@(selectedItem?.Inspector ?? "KTV PDI")</div>
        </div>
        <div class="col-3">
            <div class="fw-bold small text-uppercase">QUẢN ĐỐC XƯỞNG</div>
            <div class="text-muted" style="font-size:10px">(Nghiệm thu xuất xưởng)</div>
            <div style="height:55px;"></div>
            <div class="fw-semibold">@(Model.ApprovedBy ?? "Quản đốc xưởng")</div>
        </div>
        <div class="col-3">
            <div class="fw-bold small text-uppercase">CỐ VẤN DỊCH VỤ</div>
            <div class="text-muted" style="font-size:10px">(Bàn giao chất lượng)</div>
            <div style="height:55px;"></div>
            <div class="fw-semibold">CVDV Tiếp nhận</div>
        </div>
        <div class="col-3">
            <div class="fw-bold small text-uppercase">ĐẠI DIỆN BÁN HÀNG</div>
            <div class="text-muted" style="font-size:10px">(Tiếp nhận giao khách)</div>
            <div style="height:55px;"></div>
            <div class="fw-semibold">@Model.CreatedBy</div>
        </div>
    </div>
</div>

</body>
</html>
