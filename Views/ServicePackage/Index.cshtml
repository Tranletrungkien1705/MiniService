@model List<ServicePackage>
@{
    ViewData["Title"] = "Gói dịch vụ bảo dưỡng định kỳ";
    var totalPackages = Model.Count;
    var publicPackages = Model.Count(p => p.IsPublic);
    var activePackages = Model.Count(p => p.IsActive);
    var avgTime = totalPackages > 0 ? Model.Average(p => p.TakingTimeHours) : 0;
    var avgCost = totalPackages > 0 ? Model.Average(p => p.Total) : 0;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-collection text-primary me-2"></i>Gói dịch vụ bảo dưỡng định kỳ</h4>
        <div class="text-muted small">Quản lý danh mục gói bảo dưỡng xe chuẩn Hyundai (Ser_ServicePackage) &amp; nạp tự động vào RO / Báo giá</div>
    </div>
    <a href="/ServicePackage/Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Tạo gói bảo dưỡng mới</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card shadow-sm border-0"><div class="card-body">
            <div class="text-muted small">Tổng số gói bảo dưỡng</div>
            <div class="stat-num text-primary">@totalPackages <span style="font-size:13px;font-weight:normal" class="text-success">(@activePackages đang áp dụng)</span></div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm border-0"><div class="card-body">
            <div class="text-muted small">Gói toàn hệ thống hãng</div>
            <div class="stat-num text-info">@publicPackages <span style="font-size:13px;font-weight:normal" class="text-muted">(@(totalPackages - publicPackages) nội bộ đại lý)</span></div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm border-0"><div class="card-body">
            <div class="text-muted small">Thời gian định mức TB</div>
            <div class="stat-num text-warning">@avgTime.ToString("0.1") <span style="font-size:14px;font-weight:normal;color:#6b7280">giờ / xe</span></div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm border-0"><div class="card-body">
            <div class="text-muted small">Chi phí trọn gói TB</div>
            <div class="stat-num text-success">@avgCost.ToString("N0") <span style="font-size:14px;font-weight:normal;color:#6b7280">đ</span></div>
        </div></div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="q" class="form-control" placeholder="Tìm kiếm theo mã gói (PKG-BD...), tên gói hoặc mô tả..." value="@ViewBag.Q" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="isPublic" class="form-select">
                    <option value="">-- Tất cả phạm vi --</option>
                    <option value="true" selected="@(ViewBag.IsPublic == true)">Toàn hệ thống (HTC)</option>
                    <option value="false" selected="@(ViewBag.IsPublic == false)">Nội bộ đại lý</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="isActive" class="form-select">
                    <option value="">-- Trạng thái --</option>
                    <option value="true" selected="@(ViewBag.IsActive == true)">Đang áp dụng</option>
                    <option value="false" selected="@(ViewBag.IsActive == false)">Tạm dừng</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-filter me-1"></i>Lọc</button>
                <a href="/ServicePackage" class="btn btn-outline-secondary" title="Đặt lại bộ lọc"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:12%">Mã gói</th>
                        <th style="width:24%">Tên gói dịch vụ</th>
                        <th style="width:11%" class="text-center">Định mức</th>
                        <th style="width:11%" class="text-center">Cơ cấu hạng mục</th>
                        <th style="width:11%" class="text-end">Tiền công</th>
                        <th style="width:11%" class="text-end">Tiền phụ tùng</th>
                        <th style="width:12%" class="text-end">Tổng trọn gói</th>
                        <th style="width:8%" class="text-center">Phạm vi</th>
                        <th style="width:8%" class="text-center">Trạng thái</th>
                        <th style="width:5%" class="text-center"></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in Model)
                {
                    var (scopeTxt, scopeCss) = Ui.PackageScope(p.IsPublic);
                    var (actTxt, actCss) = Ui.PackageActive(p.IsActive);
                    <tr>
                        <td>
                            <a href="/ServicePackage/Detail/@p.Id" class="fw-bold font-monospace text-decoration-none">@p.PackageNo</a>
                        </td>
                        <td>
                            <div class="fw-semibold"><a href="/ServicePackage/Detail/@p.Id" class="text-dark text-decoration-none">@p.Name</a></div>
                            @if (!string.IsNullOrWhiteSpace(p.Description))
                            {
                                <div class="text-muted small text-truncate" style="max-width: 320px;" title="@p.Description">@p.Description</div>
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-clock me-1 text-warning"></i>@p.TakingTimeHours:0.1h
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="badge bg-info-subtle text-info-emphasis me-1" title="Số hạng mục công việc">@p.LaborCount công</span>
                            <span class="badge bg-secondary-subtle text-secondary-emphasis" title="Số phụ tùng thay thế">@p.PartCount phụ tùng</span>
                        </td>
                        <td class="text-end">@p.LaborSubTotal.ToString("N0")đ</td>
                        <td class="text-end">@p.PartSubTotal.ToString("N0")đ</td>
                        <td class="text-end fw-bold text-primary">@p.Total.ToString("N0")đ</td>
                        <td class="text-center">
                            <span class="badge bg-@scopeCss" style="font-size:11px">@scopeTxt</span>
                        </td>
                        <td class="text-center">
                            <span class="badge bg-@actCss" style="font-size:11px">@actTxt</span>
                        </td>
                        <td class="text-center">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-link text-muted p-0" type="button" data-bs-toggle="dropdown"><i class="bi bi-three-dots-vertical"></i></button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="/ServicePackage/Detail/@p.Id"><i class="bi bi-eye me-2"></i>Xem chi tiết</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form method="post" action="/ServicePackage/Delete/@p.Id" onsubmit="return confirm('Bạn có chắc chắn muốn xóa gói dịch vụ này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Xóa gói</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            Không tìm thấy gói dịch vụ bảo dưỡng nào phù hợp điều kiện lọc.
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
