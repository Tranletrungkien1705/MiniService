@{ ViewData["Title"] = "Bảng điều khiển"; var d = (SvcDash)ViewBag.Dash; }
<div class="row g-3 mb-3">
    <div class="col-6 col-lg">
        <div class="card"><div class="card-body">
            <div class="text-muted small">Lịch hẹn hôm nay</div>
            <div class="stat-num text-info">@d.TodayAppointments <span style="font-size:13px;font-weight:normal" class="text-primary">(@d.PendingAppointments chờ đón tiếp)</span></div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card"><div class="card-body">
            <div class="text-muted small">RO đang mở</div>
            <div class="stat-num" style="color:#1d4ed8">@d.OpenRO</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card"><div class="card-body">
            <div class="text-muted small">Đang sửa</div>
            <div class="stat-num text-primary">@d.InGarage</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card"><div class="card-body">
            <div class="text-muted small">Phụ tùng / Kho</div>
            <div class="stat-num text-warning">@d.Parts <span style="font-size:13px;font-weight:normal" class="text-danger">(@d.LowStockParts sắp hết)</span></div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card"><div class="card-body">
            <div class="text-muted small">Đặt hàng NCC</div>
            <div class="stat-num text-warning" style="font-size:18px"><a href="/OrderPart" class="text-decoration-none text-warning">@d.PendingOrderParts chờ</a> · @d.MonthOrderPartValue.ToString("N0")đ</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card"><div class="card-body">
            <div class="text-muted small">Nhập kho phụ tùng</div>
            <div class="stat-num text-primary" style="font-size:18px"><span class="text-warning">@d.PendingStockIns chờ</span> · @d.MonthStockInValue.ToString("N0")đ</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card"><div class="card-body">
            <div class="text-muted small">Xuất kho phụ tùng</div>
            <div class="stat-num" style="font-size:18px;color:#2563eb"><span class="text-warning">@d.PendingStockOuts chờ</span> · @d.MonthStockOutValue.ToString("N0")đ</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card"><div class="card-body">
            <div class="text-muted small">Bảo hành duyệt</div>
            <div class="stat-num" style="font-size:18px;color:#059669"><span class="text-warning">@d.PendingWarranty chờ</span> · @d.ApprovedWarrantyAmount.ToString("N0")đ</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card"><div class="card-body">
            <div class="text-muted small">CSKH sau dịch vụ 24h</div>
            <div class="stat-num" style="font-size:18px;color:#0284c7"><span class="text-warning">@d.PendingCustomerCares chờ</span> @if(d.FeedbackCustomerCares > 0){<span class="text-danger">· @d.FeedbackCustomerCares khiếu nại</span>}</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card"><div class="card-body">
            <div class="text-muted small">Gói bảo dưỡng</div>
            <div class="stat-num text-info" style="font-size:18px"><a href="/ServicePackage" class="text-decoration-none">@d.ServicePackages gói chuẩn</a></div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card"><div class="card-body">
            <div class="text-muted small">Báo giá dịch vụ</div>
            <div class="stat-num text-primary" style="font-size:18px"><span class="text-warning">@d.PendingQuotes chờ</span> · @d.MonthQuoteValue.ToString("N0")đ</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card"><div class="card-body">
            <div class="text-muted small">Thu tiền tháng này</div>
            <div class="stat-num text-success" style="font-size:18px">@d.MonthPaymentRevenue.ToString("N0")đ @if(d.PendingPayments > 0){<span class="text-warning" style="font-size:12px;font-weight:normal">(@d.PendingPayments nháp)</span>}</div>
        </div></div>
    </div>
</div>
<div class="row g-3">
    <div class="col-lg-7"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">RO theo trạng thái</h6>
        @foreach (var (st, cnt) in d.ByStatus)
        {
            var (txt, code, css) = Ui.Status(st);
            <div class="d-flex justify-content-between align-items-center border-bottom py-1">
                <span><span class="badge bg-@css">@code</span> <span class="ms-1">@txt</span></span>
                <span class="fw-semibold">@cnt</span>
            </div>
        }
        @if (d.ByStatus.Count == 0) { <div class="text-muted">Chưa có RO.</div> }
    </div></div></div>
    <div class="col-lg-5"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-2">Tác vụ</h6>
        <a href="/Appointment" class="btn btn-outline-info w-100 mb-2"><i class="bi bi-calendar2-check me-1"></i>Lịch hẹn dịch vụ (@d.PendingAppointments chờ xử lý)</a>
        <a href="/RO/Create" class="btn btn-primary w-100 mb-2"><i class="bi bi-plus-lg me-1"></i>Tiếp nhận xe (tạo RO)</a>
        <a href="/Quote/Create" class="btn btn-outline-primary w-100 mb-2"><i class="bi bi-file-earmark-plus me-1"></i>Lập báo giá dịch vụ (Quote)</a>
        <a href="/Quote" class="btn btn-outline-info w-100 mb-2"><i class="bi bi-file-earmark-text me-1"></i>Quản lý báo giá @if(d.PendingQuotes > 0){<span class="badge bg-warning text-dark ms-1">@d.PendingQuotes chờ duyệt</span>}</a>
        <a href="/RO?status=5" class="btn btn-outline-primary w-100 mb-2"><i class="bi bi-wrench me-1"></i>Xe đang sửa</a>
        <a href="/Part" class="btn btn-outline-secondary w-100 mb-2"><i class="bi bi-box-seam me-1"></i>Kho phụ tùng @if(d.LowStockParts > 0){<span class="badge bg-danger ms-1">@d.LowStockParts cảnh báo</span>}</a>
        <a href="/StockIn" class="btn btn-outline-primary w-100 mb-2"><i class="bi bi-box-arrow-in-down me-1"></i>Nhập kho phụ tùng @if(d.PendingStockIns > 0){<span class="badge bg-warning text-dark ms-1">@d.PendingStockIns chờ duyệt</span>}</a>
        <a href="/StockOut" class="btn btn-outline-primary w-100 mb-2"><i class="bi bi-box-arrow-up-right me-1"></i>Xuất kho phụ tùng @if(d.PendingStockOuts > 0){<span class="badge bg-warning text-dark ms-1">@d.PendingStockOuts chờ duyệt</span>}</a>
        <a href="/Payment" class="btn btn-outline-success w-100 mb-2"><i class="bi bi-cash-coin me-1"></i>Thu ngân &amp; Phiếu thu (Payment) @if(d.PendingPayments > 0){<span class="badge bg-warning text-dark ms-1">@d.PendingPayments chờ thu</span>}</a>
        <a href="/CustomerCare" class="btn btn-outline-info w-100 mb-2"><i class="bi bi-headset me-1"></i>Chăm sóc khách hàng 24h @if(d.PendingCustomerCares > 0){<span class="badge bg-warning text-dark ms-1">@d.PendingCustomerCares chờ</span>}@if(d.FeedbackCustomerCares > 0){<span class="badge bg-danger ms-1">@d.FeedbackCustomerCares khiếu nại</span>}</a>
        <a href="/Warranty" class="btn btn-outline-success w-100 mb-2"><i class="bi bi-shield-check me-1"></i>Báo cáo bảo hành xe (Warranty) @if(d.PendingWarranty > 0){<span class="badge bg-warning text-dark ms-1">@d.PendingWarranty chờ duyệt</span>}</a>
        <div class="text-muted small mt-2">API tra cứu: <code>GET /api/ro?plate=30A</code> · <code>GET /api/appointments</code> · <code>GET /api/parts</code> · <code>GET /api/quotes</code> · <code>GET /api/stockin</code> · <code>GET /api/stockout</code> · <code>GET /api/payments</code> · <code>GET /api/warranty</code> · <code>GET /api/customercare</code></div>
    </div></div></div>
</div>
