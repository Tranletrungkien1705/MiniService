@{
    ViewData["Title"] = "Lập phiếu chia sẻ phụ tùng";
    var parts = ViewBag.Parts as List<Part> ?? new List<Part>();
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a href="/SharePart" class="text-decoration-none small text-muted"><i class="bi bi-arrow-left me-1"></i>Chia sẻ phụ tùng</a>
        <h5 class="mb-0 fw-bold mt-1"><i class="bi bi-share me-2 text-primary"></i>Lập phiếu chia sẻ phụ tùng</h5>
    </div>
</div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-header bg-white fw-semibold"><i class="bi bi-info-circle me-1 text-primary"></i>Thông tin phiếu chia sẻ</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Mã đại lý chia sẻ (DealerCode) <span class="text-danger">*</span></label>
                    <input name="dealerCode" value="@ViewBag.DealerCode" class="form-control font-monospace" placeholder="VD: VS058" required style="text-transform:uppercase" />
                </div>
                <div class="col-md-8">
                    <label class="form-label small fw-semibold">Tên đại lý (DealerName)</label>
                    <input name="dealerName" class="form-control" placeholder="VD: Hyundai Thành Công Vĩnh Phúc" />
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold">Ghi chú (Remark)</label>
                    <textarea name="remark" class="form-control" rows="2" placeholder="Mô tả mục đích chia sẻ, điều kiện điều chuyển..."></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <span class="fw-semibold"><i class="bi bi-box-seam me-1 text-primary"></i>Danh sách phụ tùng chia sẻ</span>
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addRow()"><i class="bi bi-plus-lg me-1"></i>Thêm dòng</button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0" id="lineTable">
                    <thead>
                        <tr>
                            <th style="width:340px">Phụ tùng <span class="text-danger">*</span></th>
                            <th style="width:150px">SL chia sẻ <span class="text-danger">*</span></th>
                            <th>Ghi chú dòng</th>
                            <th style="width:60px"></th>
                        </tr>
                    </thead>
                    <tbody id="lineBody">
                    </tbody>
                </table>
            </div>
            <div class="small text-muted mt-2"><i class="bi bi-info-circle me-1"></i>Chỉ nên chia sẻ phụ tùng có tồn kho lớn hơn tồn tối thiểu (tồn dư).</div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu phiếu chia sẻ</button>
        <a href="/SharePart" class="btn btn-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
<script>
    const parts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(parts.Select(p => new { id = p.Id, code = p.Code, name = p.Name, unit = p.Unit, inStock = p.InStock, minStock = p.MinStock })));
    function partOptions() {
        return '<option value="">-- Chọn phụ tùng --</option>' + parts.map(p =>
            `<option value="${p.id}">${p.code} — ${p.name} (tồn: ${p.inStock}/${p.minStock})</option>`).join('');
    }
    function addRow() {
        const tbody = document.getElementById('lineBody');
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td><select name="partId" class="form-select form-select-sm">${partOptions()}</select></td>
            <td><input name="quantityShare" type="number" min="0" step="0.01" class="form-control form-control-sm font-monospace" value="1" /></td>
            <td><input name="lineRemark" class="form-control form-control-sm" placeholder="Ghi chú" /></td>
            <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()"><i class="bi bi-x-lg"></i></button></td>`;
        tbody.appendChild(tr);
    }
    addRow();
</script>
}
