@model List<WorkingCalendar>
@{
    ViewData["Title"] = "Lịch làm việc của đại lý";
    var summary = ViewBag.Summary as WorkingCalendarSummaryDto ?? new WorkingCalendarSummaryDto();
    int year = ViewBag.Year is int y ? y : DateTime.Today.Year;
    int? month = ViewBag.Month as int?;
    var byMonth = Model.GroupBy(c => c.Date.Month).OrderBy(g => g.Key).ToList();
}
<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Tổng số ngày khai báo</div>
                <div class="stat-num text-primary">@summary.TotalDays</div>
                <div class="text-muted" style="font-size:11.5px">Ngày trong lịch làm việc</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Ngày làm việc</div>
                <div class="stat-num text-success">@summary.WorkingDays</div>
                <div class="text-muted" style="font-size:11.5px">Ngày xưởng mở cửa</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Ngày nghỉ / Lễ</div>
                <div class="stat-num text-danger">@summary.DayOffs</div>
                <div class="text-muted" style="font-size:11.5px">Ngày xưởng đóng cửa</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Số năm / đại lý</div>
                <div class="stat-num text-info">@summary.YearCount / @summary.DealerCount</div>
                <div class="text-muted" style="font-size:11.5px">Năm · Đại lý có khai báo</div>
            </div>
        </div>
    </div>
</div>
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <form method="get" class="d-flex align-items-center gap-2 flex-wrap">
                <select name="year" class="form-select form-select-sm" style="width:120px" onchange="this.form.submit()">
                    @foreach (var v in Enumerable.Range(DateTime.Today.Year - 3, 6))
                    {
                        <option value="@v" selected="@(v == year)">Năm @v</option>
                    }
                </select>
                <select name="month" class="form-select form-select-sm" style="width:140px" onchange="this.form.submit()">
                    <option value="">-- Cả năm --</option>
                    @foreach (var m in Enumerable.Range(1, 12))
                    {
                        <option value="@m" selected="@(month == m)">Tháng @m</option>
                    }
                </select>
                <input name="dealerCode" value="@ViewBag.DealerCode" class="form-control form-control-sm" style="width:150px" placeholder="Mã đại lý" />
                <select name="status" class="form-select form-select-sm" style="width:160px" onchange="this.form.submit()">
                    <option value="">-- Trạng thái --</option>
                    <option value="WorkingDay" selected="@(ViewBag.Status as CalendarDayStatus? == CalendarDayStatus.WorkingDay)">Ngày làm việc</option>
                    <option value="DayOff" selected="@(ViewBag.Status as CalendarDayStatus? == CalendarDayStatus.DayOff)">Ngày nghỉ / Lễ</option>
                </select>
                <button type="submit" class="btn btn-sm btn-outline-secondary">Lọc</button>
                @if (month != null || ViewBag.Status != null || !string.IsNullOrEmpty(ViewBag.DealerCode as string))
                {
                    <a href="/WorkingCalendar?year=@year" class="btn btn-sm btn-link text-decoration-none">Xóa lọc</a>
                }
            </form>
            <div class="d-flex align-items-center gap-2">
                <a href="/WorkingCalendar/Create" class="btn btn-sm btn-primary">
                    <i class="bi bi-calendar-plus me-1"></i>Khởi tạo lịch năm
                </a>
            </div>
        </div>
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-calendar-x fs-3 d-block mb-1 text-secondary"></i>
                Chưa có lịch làm việc cho năm @year. Hãy bấm "Khởi tạo lịch năm" để sinh lịch.
            </div>
        }
        else
        {
            @foreach (var g in byMonth)
            {
                <div class="mb-3">
                    <div class="fw-semibold text-secondary mb-2"><i class="bi bi-calendar3 me-1"></i>Tháng @g.Key / @year</div>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var c in g.OrderBy(x => x.Date))
                        {
                            var info = Ui.CalendarDayStatus((CalendarDayStatus)c.StatusValue);
                            <a asp-action="Detail" asp-route-id="@c.Id"
                               class="btn btn-sm btn-@info.css position-relative"
                               style="width:52px"
                               title="@c.Date.ToString("dddd, dd/MM/yyyy") — @info.text">
                                @c.Date.Day
                            </a>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>
