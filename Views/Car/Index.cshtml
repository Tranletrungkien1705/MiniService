@model List<Car>
@{ ViewData["Title"] = "Xe"; }
<div class="card"><div class="card-body">
    <form method="get" class="mb-3" style="max-width:320px"><input name="q" value="@ViewBag.Q" class="form-control form-control-sm" placeholder="Biển số / mẫu xe / VIN..." /></form>
    <table class="table table-hover align-middle">
        <thead><tr><th>Biển số</th><th>Mẫu xe</th><th>Năm</th><th>VIN</th><th>Chủ xe</th></tr></thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr><td class="fw-semibold">@c.Plate</td><td>@c.Model</td><td>@c.Year</td><td class="small text-muted">@c.Vin</td><td>@c.Customer.Name</td></tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Chưa có xe. Thêm ở mục Khách hàng.</td></tr> }
        </tbody>
    </table>
</div></div>
