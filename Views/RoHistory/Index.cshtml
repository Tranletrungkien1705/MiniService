@model List<RoHistory>
@{
    ViewData["Title"] = "Nhật ký thao tác Lệnh sửa chữa (Ser_ROHistory)";
    var summary = ViewBag.Summary as RoHistorySummaryDto ?? new RoHistorySummaryDto();
    int? curRoId = ViewBag.RoId;
    ROStatus? curStatus = ViewBag.Status;
    string? curQ = ViewBag.Q;
}

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Tổng số dòng nhật ký</div>
                <div class="stat-num text-primary">@summary.TotalEntries <span class="fs-6 fw-normal text-muted">lượt</span></div>
                <div class="text-muted" style="font-size:11.5px">Ghi nhận mọi thao tác trên RO</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Số trạng thái đã đi qua</div>
                <div class="stat-num text-info">@summary.DistinctStatusCount <span class="fs-6 fw-normal text-muted">trạng thái</span></div>
                <div class="text-muted" style="font-size:11.5px">Vòng đời RO theo state machine</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Số lần hủy (REJ)</div>
                <div class="stat-num text-danger">@summary.RejectCount <span class="fs-6 fw-normal text-muted">lần</span></div>
                <div class="text-muted" style="font-size:11.5px">KH từ chối / quản lý hủy lệnh</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Thao tác gần nhất</div>
                <div class="stat-num text-success" style="font-size:18px">@(summary.LastEntryAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div>
                <div class="text-muted" style="font-size:11.5px">Bắt đầu: @(summary.FirstEntryAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-3">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="q" value="@curQ" class="form-control" placeholder="Ghi chú, người thao tác, mã RO..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Tất cả trạng thái --</option>
                    @foreach (var s in Enum.GetValues<ROStatus>())
                    {
                        var (t, c, _) = Ui.Status(s);
                        <option value="@((int)s)" selected="@(curStatus == s)">@c — @t</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <input type="number" name="roId" value="@curRoId" class="form-control form-control-sm" placeholder="Mã số RO (Id)" />
            </div>
            <div class="col-md-3 text-end">
                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i> Lọc</button>
                <a href="/RoHistory" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:150px">Thời điểm</th>
                    <th style="width:130px">Lệnh sửa chữa</th>
                    <th style="width:150px">Trạng thái</th>
                    <th>Ghi chú thao tác</th>
                    <th style="width:150px">Người thao tác</th>
                    <th style="width:90px" class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-1"></i>
                            Chưa có dòng nhật ký nào phù hợp bộ lọc.
                        </td>
                    </tr>
                }
                @foreach (var h in Model)
                {
                    var (stTxt, stCode, stCss) = Ui.Status(h.Status);
                    var (icon, iconCss) = Ui.HistoryAction(h.Status);
                    <tr>
                        <td class="text-muted small">@h.HistoryDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (h.RO != null)
                            {
                                <a href="/RO/Detail/@h.ROId" class="fw-semibold text-decoration-none">@h.RO.Code</a>
                                <div class="text-muted" style="font-size:11px">@h.RO.Car?.Plate</div>
                            }
                            else
                            {
                                <span class="text-muted">RO #@h.ROId</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-@stCss"><i class="bi @icon me-1"></i>@stCode</span>
                            <div class="text-muted" style="font-size:11px">@stTxt</div>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(h.Note) ? "—" : h.Note)</td>
                        <td class="text-muted small"><i class="bi bi-person me-1"></i>@(h.UserCode ?? "—")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a href="/RoHistory/Detail/@h.Id" class="btn btn-outline-primary" title="Chi tiết"><i class="bi bi-eye"></i></a>
                                <form method="post" action="/RoHistory/Delete/@h.Id" class="d-inline" onsubmit="return confirm('Xóa dòng nhật ký này?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="roId" value="@h.ROId" />
                                    <button type="submit" class="btn btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
