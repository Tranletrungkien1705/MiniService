@model CustomerCareBirthday
@{
    Layout = null;
    var (stText, _, _) = Ui.CustomerCareBirthdayStatus(Model.Status);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Thư chúc mừng sinh nhật &amp; Voucher — @Model.CareBthNo</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;1,600&display=swap" rel="stylesheet" />
    <style>
        body { font-family: 'Be Vietnam Pro', sans-serif; font-size: 14px; color: #1e293b; background: #fff; padding: 20px; }
        .greeting-card { border: 2px solid #1d4ed8; border-radius: 16px; padding: 32px; background: #fafcff; position: relative; overflow: hidden; }
        .card-header-banner { border-bottom: 2px solid #e2e8f0; padding-bottom: 16px; margin-bottom: 24px; }
        .greeting-title { font-family: 'Playfair Display', serif; font-size: 26px; color: #1e3a8a; font-weight: 700; text-align: center; }
        .voucher-box { border: 2px dashed #2563eb; background: #ffffff; border-radius: 12px; padding: 20px; margin: 24px 0; box-shadow: 0 4px 12px rgba(37,99,235,0.06); }
        .voucher-code { font-size: 24px; font-weight: 800; letter-spacing: 2px; color: #1d4ed8; }
        .voucher-value { font-size: 20px; font-weight: 700; color: #dc2626; }
        .signature-section { margin-top: 36px; }
        @@media print {
            body { padding: 0; background: #fff; }
            .no-print { display: none !important; }
            .greeting-card { border: 1.5px solid #000; box-shadow: none; }
            .voucher-box { border: 1.5px dashed #000; }
        }
    </style>
</head>
<body>
    <div class="no-print d-flex justify-content-between align-items-center mb-3">
        <button onclick="window.print()" class="btn btn-primary"><i class="bi bi-printer me-1"></i>In thiệp &amp; Voucher</button>
        <button onclick="window.close()" class="btn btn-secondary">Đóng</button>
    </div>

    <div class="greeting-card">
        <div class="card-header-banner d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <h5 class="fw-bold text-primary mb-0"><i class="bi bi-car-front-fill me-2"></i>HYUNDAI CAR SERVICE</h5>
                <div class="text-muted small">Trung tâm Dịch vụ &amp; Bảo hành Ô tô Chính hãng</div>
                <div class="text-muted small">Hotline đặt hẹn: 1900 8888 · Website: hyundai-services.vn</div>
            </div>
            <div class="text-end">
                <div class="fw-bold">Mã phiếu: @Model.CareBthNo</div>
                <div class="small text-muted">Ngày phát hành: @DateTime.Today.ToString("dd/MM/yyyy")</div>
            </div>
        </div>

        <div class="greeting-title my-3">
            <i class="bi bi-gift-fill text-danger me-2"></i>THƯ CHÚC MỪNG SINH NHẬT &amp; TRI ÂN KHÁCH HÀNG
        </div>

        <div class="my-4" style="line-height: 1.8;">
            <p><b>Kính gửi Quý khách hàng:</b> <span class="fs-5 fw-bold text-primary">@Model.Customer.Name</span></p>
            <p>
                Đại diện Ban Giám đốc và toàn thể đội ngũ Kỹ sư, Cố vấn Dịch vụ Trung tâm Dịch vụ Hyundai xin trân trọng gửi tới Quý khách lời chúc mừng sinh nhật nồng nhiệt và chân thành nhất!
            </p>
            <p>
                Kính chúc Quý khách bước sang tuổi mới luôn dồi dào sức khỏe, ngập tràn niềm vui, hạnh phúc viên mãn và luôn có những hành trình vạn dặm bình an bên cạnh chiếc xe yêu quý 
                <b>@(Model.Car != null ? $"{Model.Car.Model} (Biển số: {Model.Car.Plate})" : "Hyundai")</b>.
            </p>
            <p>
                Nhân dịp đặc biệt này, chúng tôi xin gửi tặng Quý khách món quà tri ân dịch vụ độc quyền:
            </p>
        </div>

        <!-- Khung Voucher Quà tặng -->
        <div class="voucher-box">
            <div class="row align-items-center">
                <div class="col-8">
                    <div class="text-uppercase small text-muted fw-bold">PHIẾU ƯU ĐÃI DỊCH VỤ SINH NHẬT</div>
                    <div class="voucher-code font-monospace mt-1">@(Model.GiftVoucherCode ?? "BDAY2026-VIP")</div>
                    <div class="voucher-value mt-1">
                        GIẢM @Model.GiftVoucherValue.ToString("N0") VNĐ 
                        <span class="fs-6 text-dark fw-normal">(hoặc giảm @Model.DiscountPercent% tiền công bảo dưỡng &amp; phụ tùng)</span>
                    </div>
                    <div class="small text-muted mt-2">
                        <i class="bi bi-clock me-1"></i>Có giá trị sử dụng đến hết ngày: <b>@(Model.VoucherValidUntil?.ToString("dd/MM/yyyy") ?? DateTime.Today.AddDays(30).ToString("dd/MM/yyyy"))</b>
                    </div>
                </div>
                <div class="col-4 text-center border-start">
                    <div class="text-danger fs-1"><i class="bi bi-cake2"></i></div>
                    <div class="small fw-bold text-uppercase mt-1 text-secondary">Đặc quyền Sinh nhật</div>
                    <div class="small text-muted">Áp dụng cho mọi dịch vụ</div>
                </div>
            </div>
        </div>

        <div class="small text-muted mb-4">
            <b>Điều khoản áp dụng:</b>
            <ul class="mb-0 ps-3">
                <li>Voucher có giá trị giảm trừ trực tiếp trên Lệnh sửa chữa (RO) tại Trung tâm dịch vụ.</li>
                <li>Không có giá trị quy đổi thành tiền mặt, áp dụng cho xe của Quý khách mang đến làm dịch vụ.</li>
                <li>Vui lòng thông báo mã voucher cho Cố vấn Dịch vụ khi tiếp nhận xe vào xưởng.</li>
            </ul>
        </div>

        <div class="row signature-section text-center">
            <div class="col-6">
                <div class="fw-bold">CỐ VẤN DỊCH VỤ</div>
                <div class="text-muted small">Người chăm sóc</div>
                <div style="height: 60px;"></div>
                <div class="fw-semibold">@(Model.ContactedBy ?? "CVDV Đại diện")</div>
            </div>
            <div class="col-6">
                <div class="fw-bold">GIÁM ĐỐC DỊCH VỤ</div>
                <div class="text-muted small">Ký và đóng dấu</div>
                <div style="height: 60px;"></div>
                <div class="fw-semibold">Ban Giám Đốc Xưởng Dịch Vụ</div>
            </div>
        </div>
    </div>
</body>
</html>
