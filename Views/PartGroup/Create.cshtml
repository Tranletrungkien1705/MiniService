@{
    ViewData["Title"] = "Thêm Nhóm vật tư (Part Group)";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a href="/PartGroup" class="text-decoration-none small text-muted"><i class="bi bi-arrow-left me-1"></i>Danh mục nhóm vật tư</a>
        <h5 class="mb-0 fw-bold mt-1"><i class="bi bi-diagram-3-fill me-2 text-primary"></i>Thêm Nhóm vật tư Mới (Ser_MST_PartGroup)</h5>
    </div>
</div>

<div class="card shadow-sm border-0" style="max-width:680px">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Mã nhóm (GroupCode) <span class="text-danger">*</span></label>
                    <input name="groupCode" class="form-control font-monospace" placeholder="VD: PG-DAU" required style="text-transform:uppercase" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Thứ tự hiển thị (OrderID)</label>
                    <input name="orderId" type="number" class="form-control" placeholder="VD: 1" />
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold">Tên nhóm vật tư (GroupName) <span class="text-danger">*</span></label>
                    <input name="groupName" class="form-control" placeholder="VD: Dầu & mỡ bôi trơn, Phanh - Hệ thống phanh..." required />
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold">Mã đại lý (DealerCode)</label>
                    <input name="dealerCode" class="form-control font-monospace" placeholder="VD: VS058 (bỏ trống = tất cả đại lý)" style="text-transform:uppercase" />
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold">Nhóm cha (ParentID)</label>
                    <select name="parentId" class="form-select">
                        <option value="">— Không có (nhóm gốc) —</option>
                        @foreach (var p in (ViewBag.Parents as List<PartGroup> ?? []))
                        {
                            <option value="@p.Id">@p.GroupCode - @p.GroupName</option>
                        }
                    </select>
                    <div class="form-text">Chọn nhóm cha để tạo cây phân cấp; bỏ trống nếu đây là nhóm gốc.</div>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu nhóm vật tư</button>
                <a href="/PartGroup" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>
