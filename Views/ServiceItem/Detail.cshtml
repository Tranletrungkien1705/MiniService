@model ServiceItem
@{
    ViewData["Title"] = $"Chi tiết công việc [{Model.Code}] {Model.Name}";
    var typeInfo = Ui.ServiceROType(Model.ROType);
    var activeInfo = Ui.ServiceItemActive(Model.IsActive);
    var editableROs = ViewBag.EditableROs as List<RepairOrder> ?? [];
    var lines = Model.RepairLines.OrderByDescending(l => l.RO?.CreatedAt ?? DateTime.MinValue).ToList();
    var totalUsedQty = lines.Sum(l => l.Quantity);
    var totalRevenue = lines.Sum(l => l.Amount);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Danh sách</a>
        <h4 class="mb-0 fw-bold">
            <span class="font-monospace text-primary">[@Model.Code]</span> @Model.Name
        </h4>
        <span class="badge @typeInfo.css">@typeInfo.code - @typeInfo.text</span>
        <span class="badge bg-@activeInfo.css">@activeInfo.text</span>
        @if (Model.FlagWarranty)
        {
            <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-shield-check me-1"></i>Bảo hành hãng HTC</span>
        }
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editModal">
            <i class="bi bi-pencil me-1"></i>Sửa thông tin
        </button>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa hoặc tạm dừng công việc này?');" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-danger">
                <i class="bi bi-trash me-1"></i>@(Model.RepairLines.Any() ? "Tạm dừng" : "Xóa")
            </button>
        </form>
    </div>
</div>

<div class="row g-3">
    <!-- Cột trái: Thông số định mức kỹ thuật & Đơn giá -->
    <div class="col-md-5">
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header bg-white fw-bold py-2">
                <i class="bi bi-info-circle me-1 text-primary"></i>Thông số định mức tiêu chuẩn (Flat Rate Specs)
            </div>
            <div class="card-body">
                <table class="table table-sm table-borderless mb-0">
                    <tbody>
                        <tr>
                            <td class="text-muted" style="width:160px">Mã công việc:</td>
                            <td class="fw-bold font-monospace text-primary">@Model.Code</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Tên công việc:</td>
                            <td class="fw-semibold">@Model.Name</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Phân loại nghiệp vụ:</td>
                            <td><span class="badge @typeInfo.css">@typeInfo.code - @typeInfo.text</span></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Dòng xe áp dụng:</td>
                            <td class="fw-semibold text-secondary">@(string.IsNullOrEmpty(Model.Model) ? "Tất cả các dòng xe Hyundai" : Model.Model)</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Giờ công tiêu chuẩn:</td>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace fs-6">
                                    @Model.StdManHour.ToString("0.##") giờ
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted">Bảo hành HTC:</td>
                            <td>
                                @if (Model.FlagWarranty)
                                {
                                    <span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle me-1"></i>Áp dụng bảo hành hãng</span>
                                }
                                else
                                {
                                    <span class="text-muted">Không áp dụng (Khách hàng chi trả)</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted">Trạng thái:</td>
                            <td><span class="badge bg-@activeInfo.css">@activeInfo.text</span></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Ngày khởi tạo:</td>
                            <td>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    </tbody>
                </table>

                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <div class="mt-3 p-2 bg-light rounded border small">
                        <div class="fw-semibold text-secondary mb-1"><i class="bi bi-journal-text me-1"></i>Quy trình kỹ thuật &amp; Tiêu chuẩn thi công:</div>
                        <div class="text-dark">@Model.Note</div>
                    </div>
                }
            </div>
        </div>

        <!-- Bảng tính tài chính & lợi nhuận -->
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header bg-white fw-bold py-2">
                <i class="bi bi-calculator me-1 text-success"></i>Cơ cấu đơn giá &amp; Hiệu quả tài chính
            </div>
            <div class="card-body">
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <div class="p-2 bg-light rounded text-center">
                            <div class="text-muted small">Đơn giá niêm yết</div>
                            <div class="fs-5 fw-bold text-primary font-monospace">@Model.Price.ToString("N0") <span class="small fw-normal fs-6">đ</span></div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 bg-light rounded text-center">
                            <div class="text-muted small">Giá gồm VAT (@Model.VatPercent%)</div>
                            <div class="fs-5 fw-bold text-success font-monospace">@Model.TotalWithVat.ToString("N0") <span class="small fw-normal fs-6">đ</span></div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 bg-light rounded text-center">
                            <div class="text-muted small">Giá vốn thợ khoán (Cost)</div>
                            <div class="fs-6 fw-bold text-secondary font-monospace">@Model.Cost.ToString("N0") đ</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 bg-light rounded text-center">
                            <div class="text-muted small">Tỷ suất lợi nhuận gộp</div>
                            <div class="fs-6 fw-bold @(Model.GrossMargin >= 50 ? "text-success" : "text-primary") font-monospace">@Model.GrossMargin.ToString("0.0")%</div>
                        </div>
                    </div>
                </div>

                <div class="small text-muted border-top pt-2">
                    <div class="d-flex justify-content-between">
                        <span>Lợi nhuận gộp dự kiến / 1 lần thực hiện:</span>
                        <strong class="font-monospace text-success">+@Model.GrossProfit.ToString("N0") đ</strong>
                    </div>
                    <div class="d-flex justify-content-between mt-1">
                        <span>Tổng số lần đã thi công trên RO:</span>
                        <strong class="font-monospace">@lines.Count lần (@totalUsedQty.ToString("0.##") giờ)</strong>
                    </div>
                    <div class="d-flex justify-content-between mt-1">
                        <span>Tổng doanh thu thực tế ghi nhận:</span>
                        <strong class="font-monospace text-primary">@totalRevenue.ToString("N0") đ</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Nạp vào RO -->
        @if (Model.IsActive && editableROs.Any())
        {
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white fw-bold py-2">
                    <i class="bi bi-box-arrow-in-down-right me-1 text-primary"></i>Nạp công việc này vào Lệnh sửa chữa (RO)
                </div>
                <div class="card-body">
                    <form asp-action="AddToRO" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="serviceItemId" value="@Model.Id" />
                        <div class="mb-2">
                            <label class="form-label small fw-semibold">Chọn Lệnh sửa chữa đang mở:</label>
                            <select name="roId" class="form-select form-select-sm" required>
                                <option value="">-- Chọn RO --</option>
                                @foreach (var r in editableROs)
                                {
                                    <option value="@r.Id">[@r.Code] Xe: @(r.Car?.Plate ?? "N/A") - @(r.Car?.Model ?? "") (@Ui.Status(r.Status).text)</option>
                                }
                            </select>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small fw-semibold">Đối tượng:</label>
                                <select name="expenseType" class="form-select form-select-sm">
                                    <option value="0" selected="@(!Model.FlagWarranty)">Khách trả</option>
                                    <option value="1" selected="@(Model.FlagWarranty)">Bảo hành hãng</option>
                                    <option value="2">Bảo hiểm</option>
                                    <option value="3">Nội bộ</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-semibold">Giờ định mức:</label>
                                <input name="customHours" type="number" step="0.1" value="@Model.StdManHour" class="form-control form-control-sm font-monospace" />
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold">Ghi chú bổ sung:</label>
                            <input name="note" class="form-control form-control-sm" placeholder="Ghi chú thi công nếu có" />
                        </div>
                        <button type="submit" class="btn btn-sm btn-primary w-100">
                            <i class="bi bi-plus-lg me-1"></i>Thêm vào Lệnh sửa chữa
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    <!-- Cột phải: Lịch sử thi công trên các Lệnh sửa chữa (RO) -->
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
                <span class="fw-bold"><i class="bi bi-clock-history me-1 text-primary"></i>Lịch sử áp dụng trên Lệnh sửa chữa (@lines.Count lượt)</span>
                <span class="badge bg-light text-dark border">Tổng giờ: @totalUsedQty.ToString("0.##") h</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã RO</th>
                                <th>Biển số xe</th>
                                <th>Dòng xe</th>
                                <th>Chi phí</th>
                                <th class="text-end">Giờ</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!lines.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">
                                        <i class="bi bi-journal-x fs-3 d-block mb-1 text-secondary"></i>
                                        Công việc này chưa được đưa vào Lệnh sửa chữa nào.
                                    </td>
                                </tr>
                            }
                            @foreach (var l in lines)
                            {
                                var expense = Ui.Expense(l.ExpenseType);
                                <tr>
                                    <td>
                                        <a href="/RO/Detail/@l.ROId" class="fw-bold font-monospace text-decoration-none">
                                            @(l.RO?.Code ?? $"RO-{l.ROId}")
                                        </a>
                                    </td>
                                    <td class="fw-semibold">@(l.RO?.Car?.Plate ?? "N/A")</td>
                                    <td class="small text-muted">@(l.RO?.Car?.Model ?? "N/A")</td>
                                    <td>
                                        <span class="badge bg-@expense.css-subtle text-@expense.css">@expense.text</span>
                                    </td>
                                    <td class="text-end font-monospace">@l.Quantity.ToString("0.##")</td>
                                    <td class="text-end font-monospace">@l.UnitPrice.ToString("N0") đ</td>
                                    <td class="text-end fw-bold text-primary font-monospace">@l.Amount.ToString("N0") đ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Sửa thông tin công việc -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="Update" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2 text-primary"></i>Cập nhật Công việc [@Model.Code]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Mã công việc (SerCode)</label>
                            <input class="form-control font-monospace" value="@Model.Code" disabled />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-semibold">Tên công việc dịch vụ <span class="text-danger">*</span></label>
                            <input name="name" value="@Model.Name" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Phân loại nghiệp vụ (ROType)</label>
                            <select name="roType" class="form-select">
                                @foreach (ServiceROType t in Enum.GetValues<ServiceROType>())
                                {
                                    var info = Ui.ServiceROType(t);
                                    <option value="@t" selected="@(Model.ROType == t)">[@info.code] @info.text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Giờ công tiêu chuẩn (StdManHour)</label>
                            <div class="input-group">
                                <input name="stdManHour" type="number" step="0.1" value="@Model.StdManHour" min="0.1" class="form-control font-monospace" required />
                                <span class="input-group-text">giờ</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Thuế suất VAT (%)</label>
                            <div class="input-group">
                                <input name="vatPercent" type="number" step="1" value="@Model.VatPercent" min="0" max="20" class="form-control font-monospace" required />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Đơn giá bán niêm yết (Price)</label>
                            <div class="input-group">
                                <input name="price" type="number" step="1000" value="@Model.Price" min="0" class="form-control font-monospace text-primary fw-bold" required />
                                <span class="input-group-text">VNĐ</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Chi phí giá vốn định mức KTV (Cost)</label>
                            <div class="input-group">
                                <input name="cost" type="number" step="1000" value="@Model.Cost" min="0" class="form-control font-monospace" required />
                                <span class="input-group-text">VNĐ</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Dòng xe áp dụng (Model)</label>
                            <input name="model" value="@Model.Model" class="form-control" placeholder="VD: Accent / Elantra..." />
                        </div>
                        <div class="col-md-6 d-flex align-items-center gap-4 mt-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="flagWarranty" value="true" id="chkEditWarranty" @(Model.FlagWarranty ? "checked" : "") />
                                <label class="form-check-label fw-semibold text-success" for="chkEditWarranty">
                                    Bảo hành HTC
                                </label>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="isActive" value="true" id="chkEditActive" @(Model.IsActive ? "checked" : "") />
                                <label class="form-check-label fw-semibold" for="chkEditActive">
                                    Đang áp dụng
                                </label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Ghi chú quy trình kỹ thuật</label>
                            <textarea name="note" class="form-control" rows="3">@Model.Note</textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>
