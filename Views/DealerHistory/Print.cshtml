@model VehicleHistorySummaryDto
@{
    Layout = null;
    var records = Model.Records.OrderBy(r => r.CheckInDate).ToList();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Sổ Bảo Dưỡng &amp; Lịch Sử Dịch Vụ Xe @Model.PlateNo — Hyundai</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        body { font-family: "Be Vietnam Pro", sans-serif; font-size: 13px; color: #1f2937; background: #fff; margin: 0; padding: 20px; }
        .print-container { max-width: 960px; margin: 0 auto; }
        .brand-title { font-size: 20px; font-weight: 800; color: #002c6c; letter-spacing: 0.5px; }
        .doc-title { font-size: 18px; font-weight: 800; color: #0b1531; text-transform: uppercase; margin-top: 6px; }
        .passport-box { border: 2px solid #002c6c; border-radius: 8px; padding: 14px; background: #f8fafc; }
        .stamp-box { border: 1px dashed #94a3b8; border-radius: 6px; height: 75px; display: flex; align-items: center; justify-content: center; color: #94a3b8; font-size: 11px; }
        table th { background: #002c6c !important; color: #fff !important; font-size: 11.5px; text-transform: uppercase; font-weight: 600; }
        .table-ro td { vertical-align: middle; }
        @@media print {
            body { padding: 0; }
            .no-print { display: none !important; }
            .page-break { page-break-before: always; }
        }
    </style>
</head>
<body>
<div class="print-container">
    <!-- Nút in / điều khiển -->
    <div class="no-print d-flex justify-content-between align-items-center mb-3 p-2 bg-light rounded border">
        <div>
            <button onclick="window.print()" class="btn btn-primary btn-sm px-3">
                <i class="bi bi-printer me-1"></i>In Sổ Bảo Dưỡng
            </button>
            <button onclick="window.close()" class="btn btn-outline-secondary btn-sm ms-2">Đóng</button>
        </div>
        <div class="small text-muted">
            <i class="bi bi-info-circle me-1"></i>Chọn khổ giấy A4, định dạng Dọc (Portrait) để in đạt chất lượng tốt nhất.
        </div>
    </div>

    <!-- Header Chuẩn Đại lý Hyundai -->
    <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
        <div>
            <div class="brand-title"><i class="bi bi-award me-1"></i>HYUNDAI THÀNH CÔNG VIỆT NAM (HTC)</div>
            <div class="small text-muted">HỆ THỐNG QUẢN LÝ DỊCH VỤ &amp; CHĂM SÓC KHÁCH HÀNG TOÀN QUỐC (DMS)</div>
            <div class="small text-muted">Cổng thông tin tra cứu &amp; chia sẻ lịch sử sửa chữa liên đại lý (Dealer History Share)</div>
        </div>
        <div class="text-end">
            <div class="badge bg-primary fs-6 px-3 py-2">SỔ BẢO DƯỠNG ĐIỆN TỬ</div>
            <div class="small text-muted mt-1">Ngày tra cứu: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
        </div>
    </div>

    <div class="text-center mb-4">
        <h4 class="doc-title mb-1">SỔ THEO DÕI LỊCH SỬ DỊCH VỤ &amp; BẢO DƯỠNG XE</h4>
        <div class="text-muted small">Cấp cho xe ô tô: <strong>@Model.PlateNo</strong> — Mẫu xe: <strong>@Model.ModelName</strong></div>
    </div>

    <!-- Phần 1: Hồ sơ Định danh Xe & Chủ xe (Vehicle Passport) -->
    <div class="passport-box mb-4">
        <div class="row g-3">
            <div class="col-8">
                <div class="fw-bold text-primary mb-2 text-uppercase" style="font-size:12px">
                    <i class="bi bi-car-front me-1"></i>1. THÔNG SỐ ĐỊNH DANH XE (VEHICLE SPECIFICATIONS)
                </div>
                <div class="row g-2 small">
                    <div class="col-4 text-muted">Biển số đăng ký:</div>
                    <div class="col-8 fw-bold fs-6 text-dark">@Model.PlateNo</div>

                    <div class="col-4 text-muted">Dòng xe / Mẫu xe:</div>
                    <div class="col-8 fw-semibold">@Model.TradeMarkName @Model.ModelName</div>

                    <div class="col-4 text-muted">Số khung (VIN):</div>
                    <div class="col-8 font-monospace fw-bold">@(string.IsNullOrEmpty(Model.FrameNo) ? "Chưa có" : Model.FrameNo)</div>

                    <div class="col-4 text-muted">Số máy (Engine No):</div>
                    <div class="col-8 font-monospace">@(string.IsNullOrEmpty(Model.EngineNo) ? "Chưa ghi nhận" : Model.EngineNo)</div>

                    <div class="col-4 text-muted">Năm sản xuất / Màu:</div>
                    <div class="col-8">@(Model.ProductYear > 0 ? Model.ProductYear.ToString() : "—") · @(string.IsNullOrEmpty(Model.ColorCode) ? "Tiêu chuẩn" : Model.ColorCode)</div>
                </div>

                <hr class="my-2" />

                <div class="fw-bold text-primary mb-2 text-uppercase" style="font-size:12px">
                    <i class="bi bi-person me-1"></i>2. THÔNG TIN CHỦ SỞ HỮU (OWNER DETAILS)
                </div>
                <div class="row g-2 small">
                    <div class="col-4 text-muted">Họ và tên chủ xe:</div>
                    <div class="col-8 fw-bold text-dark">@(string.IsNullOrEmpty(Model.CusName) ? "Chưa cập nhật" : Model.CusName)</div>

                    <div class="col-4 text-muted">Điện thoại liên hệ:</div>
                    <div class="col-8">@(string.IsNullOrEmpty(Model.CusPhone) ? "Chưa có" : Model.CusPhone)</div>

                    <div class="col-4 text-muted">Địa chỉ đăng ký:</div>
                    <div class="col-8">@(string.IsNullOrEmpty(Model.CusAddress) ? "Chưa cập nhật" : Model.CusAddress)</div>
                </div>
            </div>

            <div class="col-4 border-start ps-3">
                <div class="fw-bold text-primary mb-2 text-uppercase" style="font-size:12px">
                    <i class="bi bi-graph-up me-1"></i>TỔNG KẾT DỊCH VỤ
                </div>
                <div class="p-2 bg-white rounded border mb-2 text-center">
                    <div class="text-muted" style="font-size:11px">LƯỢT VÀO XƯỞNG</div>
                    <div class="fs-4 fw-bold text-primary">@Model.TotalVisits</div>
                    <div class="text-muted" style="font-size:10px">Toàn quốc</div>
                </div>
                <div class="p-2 bg-white rounded border mb-2 text-center">
                    <div class="text-muted" style="font-size:11px">KM GẦN NHẤT</div>
                    <div class="fs-5 fw-bold text-warning">@(Model.CurrentKm > 0 ? Model.CurrentKm.ToString("N0") + " km" : "—")</div>
                </div>
                <div class="p-2 bg-white rounded border mb-2 text-center">
                    <div class="text-muted" style="font-size:11px">TỔNG CHI PHÍ</div>
                    <div class="fs-6 fw-bold text-success">@Model.TotalSpent.ToString("N0") đ</div>
                </div>
                @if (Model.TotalClaims > 0)
                {
                    <div class="p-1 bg-warning bg-opacity-10 text-warning-emphasis rounded text-center small border border-warning-subtle">
                        <i class="bi bi-shield-check me-1"></i>Đã bồi hoàn <strong>@Model.TotalClaims</strong> vụ bảo hành
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Phần 2: Bảng Dòng thời gian Lịch sử Sửa chữa liên đại lý -->
    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="fw-bold text-dark text-uppercase mb-0" style="font-size:12.5px">
                <i class="bi bi-clock-history text-primary me-1"></i>3. NHẬT KÝ BẢO DƯỠNG &amp; SỬA CHỮA ĐỊNH KỲ (SERVICE TIMELINE)
            </h6>
            <span class="small text-muted">Tổng số @records.Count lượt vào xưởng</span>
        </div>

        <table class="table table-bordered table-ro small">
            <thead>
                <tr>
                    <th style="width:35px" class="text-center">#</th>
                    <th style="width:130px">Đại lý thực hiện</th>
                    <th style="width:110px">Số RO / Ngày</th>
                    <th style="width:85px" class="text-center">Km xe</th>
                    <th>Nội dung công việc &amp; Phụ tùng thay thế</th>
                    <th style="width:90px" class="text-center">CVDV</th>
                    <th style="width:100px" class="text-end">Chi phí</th>
                    <th style="width:85px" class="text-center">Xác nhận</th>
                </tr>
            </thead>
            <tbody>
            @{ var idx = 1; }
            @foreach (var r in records)
            {
                <tr>
                    <td class="text-center fw-semibold text-muted">@(idx++)</td>
                    <td>
                        <strong class="text-dark">@r.DealerName</strong>
                        <div class="text-muted" style="font-size:10.5px">Mã: @r.DealerCode</div>
                    </td>
                    <td>
                        <div class="fw-semibold">@r.RONo</div>
                        <div class="text-muted" style="font-size:11px">@r.CheckInDate.ToString("dd/MM/yyyy")</div>
                        @if (r.FlagClaim)
                        {
                            <span class="badge bg-warning text-dark p-1" style="font-size:9.5px"><i class="bi bi-shield-check me-1"></i>Bảo hành</span>
                        }
                    </td>
                    <td class="text-center fw-bold">
                        @(r.Odometer > 0 ? r.Odometer.ToString("N0") : "—")
                    </td>
                    <td>
                        <div class="fw-medium text-dark">@r.CustomerRequest</div>
                        @if (r.Items.Count > 0)
                        {
                            <div class="text-muted mt-1" style="font-size:11px">
                                @string.Join(" · ", r.Items.Select(i => i.Name))
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(r.RepairResult))
                        {
                            <div class="text-success mt-1" style="font-size:10.5px">
                                <i class="bi bi-check-circle me-1"></i>@r.RepairResult
                            </div>
                        }
                    </td>
                    <td class="text-center small">@r.ServiceAdvisor</td>
                    <td class="text-end fw-bold">@r.TotalAmount.ToString("N0") đ</td>
                    <td class="text-center">
                        <div class="stamp-box" style="height:48px; font-size:9.5px">
                            [Dấu trạm]
                        </div>
                    </td>
                </tr>
            }
            @if (records.Count == 0)
            {
                <tr>
                    <td colspan="8" class="text-center py-4 text-muted">Chưa ghi nhận lịch sử dịch vụ.</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <!-- Quy chuẩn & Khuyến nghị bảo dưỡng hãng -->
    <div class="p-3 bg-light rounded border mb-4 small">
        <div class="fw-bold text-primary mb-1"><i class="bi bi-shield-exclamation me-1"></i>QUY CHUẨN BẢO DƯỠNG ĐỊNH KỲ XE HYUNDAI:</div>
        <ul class="mb-0 text-muted ps-3" style="font-size:11.5px">
            <li>Quý khách vui lòng mang xe đến trạm dịch vụ ủy quyền của Hyundai Thành Công định kỳ sau mỗi <strong>5.000 km</strong> hoặc <strong>6 tháng</strong> (tùy điều kiện nào đến trước).</li>
            <li>Sử dụng dầu nhờn động cơ và phụ tùng chính hãng <strong>Hyundai Mobis</strong> để đảm bảo quyền lợi bảo hành 5 năm hoặc 100.000 km của xe.</li>
            <li>Mọi thông tin sửa chữa, phụ tùng thay thế và bảo hành được đồng bộ tự động trên hệ thống dữ liệu toàn quốc.</li>
        </ul>
    </div>

    <!-- Chữ ký xác nhận trạm dịch vụ -->
    <div class="row text-center mt-4">
        <div class="col-4">
            <div class="fw-semibold text-muted small">KHÁCH HÀNG / CHỦ XE</div>
            <div class="text-muted" style="font-size:11px">(Ký và ghi rõ họ tên)</div>
            <div style="height:60px"></div>
            <div class="fw-bold">@(string.IsNullOrEmpty(Model.CusName) ? "Chủ xe" : Model.CusName)</div>
        </div>
        <div class="col-4">
            <div class="fw-semibold text-muted small">CỐ VẤN DỊCH VỤ TRA CỨU</div>
            <div class="text-muted" style="font-size:11px">(Ký và xác nhận dữ liệu)</div>
            <div style="height:60px"></div>
            <div class="fw-bold">CVDV Tiếp nhận</div>
        </div>
        <div class="col-4">
            <div class="fw-semibold text-muted small">ĐẠI LÝ ỦY QUYỀN HYUNDAI</div>
            <div class="text-muted" style="font-size:11px">(Ký tên và đóng dấu trạm dịch vụ)</div>
            <div style="height:60px"></div>
            <div class="fw-bold text-primary">TRẠM DỊCH VỤ ỦY QUYỀN HTC</div>
        </div>
    </div>
</div>
</body>
</html>
