@model MaintenanceSetting
@{
    ViewData["Title"] = $"Chi tiết Mốc Bảo dưỡng {Model.ROMSID} ({Model.Km:N0} km)";
    var openROs = ViewBag.OpenROs as List<RepairOrder> ?? [];
    var checklistItems = (Model.RequiredChecklist ?? "")
        .Split([';', '\n', '\r'], StringSplitOptions.RemoveEmptyEntries)
        .Select(s => s.Trim())
        .Where(s => !string.IsNullOrEmpty(s))
        .ToList();
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h4 class="mb-0 fw-bold font-monospace text-primary">@Model.ROMSID</h4>
            <span class="badge @Model.LevelBadgeClass fs-6">@Model.LevelName</span>
            @if (Model.FlagWarranty)
            {
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                    <i class="bi bi-shield-check me-1"></i>HTC CSBH Bắt buộc
                </span>
            }
            @if (Model.FlagActive)
            {
                <span class="badge bg-success">Đang áp dụng</span>
            }
            else
            {
                <span class="badge bg-secondary">Ngừng áp dụng</span>
            }
        </div>
        <div class="text-muted">@Model.Name · Mốc định mức: <strong class="text-dark">@Model.Km.ToString("N0") km</strong></div>
    </div>
    <div class="btn-group">
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#applyRoModal">
            <i class="bi bi-clipboard2-plus me-1"></i> Áp dụng vào RO
        </button>
        <a href="/MaintenanceSetting/Print?level=@Model.Level" target="_blank" class="btn btn-outline-info">
            <i class="bi bi-printer me-1"></i> In sổ tay
        </a>
        <a href="/MaintenanceSetting/Edit/@Model.Id" class="btn btn-outline-secondary">
            <i class="bi bi-pencil me-1"></i> Sửa
        </a>
        <form method="post" action="/MaintenanceSetting/ToggleActive/@Model.Id" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-warning">
                <i class="bi @(Model.FlagActive ? "bi-pause" : "bi-play") me-1"></i>@(Model.FlagActive ? "Tạm ngưng" : "Kích hoạt")
            </button>
        </form>
        <a href="/MaintenanceSetting" class="btn btn-outline-dark">
            <i class="bi bi-arrow-left me-1"></i> Danh sách
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <!-- Thông số kỹ thuật -->
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header bg-white py-3 border-0">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-info-circle me-2 text-primary"></i>Thông số Định mức Chu kỳ</h6>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr>
                            <td class="text-muted ps-3 py-2" style="width:200px">Mã thiết lập (ROMSID):</td>
                            <td class="fw-bold font-monospace py-2">@Model.ROMSID</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-3 py-2">Mốc Kilomet:</td>
                            <td class="fw-bold fs-5 text-primary py-2">@Model.Km.ToString("N0") km</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-3 py-2">Phân loại cấp độ:</td>
                            <td class="py-2"><span class="badge @Model.LevelBadgeClass">@Model.LevelName</span> (Maintances = @Model.Maintances)</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-3 py-2">Chu kỳ thời hạn:</td>
                            <td class="py-2"><strong>@Model.MonthsInterval tháng</strong> (hoặc đến trước số Km)</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-3 py-2">Định mức giờ công:</td>
                            <td class="py-2"><strong>@Model.TakingTimeHours.ToString("N1") giờ</strong> (Flat Rate chuẩn)</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-3 py-2">Chi phí ước tính tham khảo:</td>
                            <td class="py-2"><strong class="text-success fs-5">@Model.EstimatedCost.ToString("N0") đ</strong> (Công + Phụ tùng)</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-3 py-2">Chính sách bảo hành (CSBH):</td>
                            <td class="py-2">
                                @if (Model.FlagWarranty)
                                {
                                    <span class="text-danger fw-semibold"><i class="bi bi-check-circle-fill me-1"></i>Bắt buộc để duy trì quyền lợi bảo hành hãng HTC</span>
                                }
                                else
                                {
                                    <span class="text-muted">Khuyến nghị bổ sung theo nhu cầu khách hàng</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-3 py-2">Cập nhật cuối (LogLU):</td>
                            <td class="py-2 text-muted small">@(Model.LogLuDateTime?.ToString("dd/MM/yyyy HH:mm") ?? Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")) bởi @(Model.LogLUBy ?? Model.CreatedBy)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Danh mục Hạng mục Bắt buộc (Checklist) -->
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header bg-white py-3 border-0">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-list-check me-2 text-success"></i>Hạng mục Kiểm tra & Thay thế Bắt buộc (Checklist)</h6>
            </div>
            <div class="card-body pt-0">
                @if (checklistItems.Count == 0)
                {
                    <div class="text-muted small">Chưa cấu hình danh mục checklist bắt buộc cho mốc này.</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var c in checklistItems)
                        {
                            <li class="list-group-item px-0 py-2 d-flex align-items-start">
                                <i class="bi bi-check-circle-fill text-success me-2 mt-1"></i>
                                <div>@c</div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <!-- Ghi chú Kỹ thuật -->
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-0">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-journal-text me-2 text-info"></i>Diễn giải Kỹ thuật & Hướng dẫn Tư vấn</h6>
                </div>
                <div class="card-body pt-0 text-secondary">
                    @Model.Description
                </div>
            </div>
        }
    </div>

    <div class="col-lg-6">
        <!-- Gói Dịch vụ Liên kết (Combo) -->
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header bg-white py-3 border-0 d-flex align-items-center justify-content-between">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-collection me-2 text-info"></i>Gói Combo Dịch vụ Liên kết</h6>
                @if (Model.ServicePackage != null)
                {
                    <a href="/ServicePackage" class="btn btn-outline-info btn-sm py-0" style="font-size:11px">Xem gói</a>
                }
            </div>
            <div class="card-body pt-0">
                @if (Model.ServicePackage == null)
                {
                    <div class="alert alert-light border text-muted small mb-0">
                        <i class="bi bi-info-circle me-1"></i> Mốc này chưa được liên kết với Gói combo dịch vụ cụ thể. Khi áp dụng vào RO sẽ chỉ gán mốc bảo dưỡng mà không nạp danh mục phụ tùng tự động.
                    </div>
                }
                else
                {
                    var pkg = Model.ServicePackage;
                    <div class="d-flex align-items-center justify-content-between p-2 bg-light rounded mb-2">
                        <div>
                            <span class="badge bg-primary font-monospace me-1">@pkg.PackageNo</span>
                            <strong class="text-dark">@pkg.Name</strong>
                        </div>
                        <div class="text-end">
                            <span class="fw-bold text-success">@pkg.SubTotal.ToString("N0") đ</span>
                            <div class="text-muted" style="font-size:11px">Định mức: @pkg.TakingTimeHours.ToString("N1")h</div>
                        </div>
                    </div>

                    @if (pkg.Items.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle mb-0" style="font-size:12.5px">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:65px">Loại</th>
                                        <th>Mã & Nội dung</th>
                                        <th style="width:60px" class="text-center">SL</th>
                                        <th style="width:90px" class="text-end">Đơn giá</th>
                                        <th style="width:100px" class="text-end">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var itm in pkg.Items)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge @(itm.Type == LineType.Labor ? "bg-warning text-dark" : "bg-primary")" style="font-size:10px">
                                                    @(itm.Type == LineType.Labor ? "Công" : "Vật tư")
                                                </span>
                                            </td>
                                            <td>
                                                <div class="fw-semibold">@itm.Name</div>
                                                <div class="text-muted" style="font-size:11px">@itm.Code</div>
                                            </td>
                                            <td class="text-center">@itm.Quantity.ToString("N0")</td>
                                            <td class="text-end">@itm.UnitPrice.ToString("N0")</td>
                                            <td class="text-end fw-semibold">@((itm.Quantity * itm.UnitPrice).ToString("N0"))</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Lịch sử áp dụng trên Lệnh sửa chữa RO -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-0 d-flex align-items-center justify-content-between">
                <h6 class="mb-0 fw-bold text-dark">
                    <i class="bi bi-clock-history me-2 text-primary"></i>Lịch sử Lệnh RO áp dụng mốc này
                </h6>
                <span class="badge bg-light text-dark border">@Model.RepairOrders.Count RO</span>
            </div>
            <div class="card-body p-0">
                @if (Model.RepairOrders.Count == 0)
                {
                    <div class="p-4 text-center text-muted small">
                        Chưa có Lệnh sửa chữa nào áp dụng mốc bảo dưỡng này.
                    </div>
                }
                else
                {
                    <div class="table-responsive" style="max-height:360px">
                        <table class="table table-hover table-sm align-middle mb-0" style="font-size:12.5px">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Số RO</th>
                                    <th>Biển số xe</th>
                                    <th>Khách hàng</th>
                                    <th class="text-end">Số Km ODO</th>
                                    <th class="text-center">Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ro in Model.RepairOrders.OrderByDescending(r => r.CreatedAt).Take(20))
                                {
                                    <tr>
                                        <td>
                                            <a href="/RO/Detail/@ro.Id" class="fw-bold font-monospace text-decoration-none">
                                                @ro.Code
                                            </a>
                                        </td>
                                        <td>
                                            <span class="fw-semibold">@ro.Car?.Plate</span>
                                            <span class="text-muted small d-block">@ro.Car?.Model</span>
                                        </td>
                                        <td>@ro.Customer?.Name</td>
                                        <td class="text-end font-monospace">@ro.Odometer.ToString("N0") km</td>
                                        <td class="text-center">
                                            <span class="badge bg-secondary" style="font-size:10.5px">@ro.Status</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal Áp dụng mốc bảo dưỡng vào Lệnh sửa chữa RO -->
<div class="modal fade" id="applyRoModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form method="post" action="/MaintenanceSetting/ApplyToRO">
                @Html.AntiForgeryToken()
                <input type="hidden" name="settingId" value="@Model.Id" />

                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-primary">
                        <i class="bi bi-clipboard2-plus me-2"></i>Áp dụng @Model.ROMSID vào RO
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info py-2 px-3 small mb-3">
                        Gán mốc bảo dưỡng <strong>@Model.Name</strong> (@Model.Km.ToString("N0") km) vào Lệnh sửa chữa đang mở để theo dõi lịch sử dịch vụ.
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Chọn Lệnh sửa chữa (RO đang mở) <span class="text-danger">*</span></label>
                        <select name="roId" class="form-select" required>
                            <option value="">-- Chọn RO đang xử lý --</option>
                            @foreach (var ro in openROs)
                            {
                                <option value="@ro.Id">
                                    [@ro.Code] @ro.Car?.Plate - @ro.Car?.Model (@ro.Customer?.Name) - ODO: @ro.Odometer.ToString("N0") km
                                </option>
                            }
                        </select>
                    </div>

                    @if (Model.ServicePackage != null && Model.ServicePackage.Items.Count > 0)
                    {
                        <div class="form-check form-switch p-3 bg-light rounded">
                            <input class="form-check-input" type="checkbox" name="addPackageCombo" value="true" checked id="addComboSwitch" />
                            <label class="form-check-label fw-semibold" for="addComboSwitch">
                                Tự động nạp phụ tùng & công từ gói combo liên kết
                            </label>
                            <div class="small text-muted mt-1">
                                Sẽ nạp @Model.ServicePackage.Items.Count hạng mục của gói <strong>@Model.ServicePackage.Name</strong> (@Model.ServicePackage.SubTotal.ToString("N0") đ) vào dòng công việc của RO.
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-circle me-1"></i> Xác nhận áp dụng
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
