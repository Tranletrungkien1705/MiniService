@model MaintenanceSetting
@{
    ViewData["Title"] = "Thêm Mốc Thiết lập Chu kỳ Bảo dưỡng (Ser_MST_ROMaintanceSetting)";
    var packages = ViewBag.ServicePackages as List<ServicePackage> ?? [];
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-0">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="mb-0 fw-bold text-primary">
                            <i class="bi bi-speedometer2 me-2"></i>Thêm Mới Mốc Chu kỳ & Định mức Bảo dưỡng
                        </h5>
                        <div class="text-muted small">Cấu hình định mức Km, cấp độ bảo dưỡng và chính sách bảo hành tiêu chuẩn Hyundai HTC</div>
                    </div>
                    <a href="/MaintenanceSetting" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </div>
            <div class="card-body p-4">
                <form method="post" action="/MaintenanceSetting/Create">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Mã thiết lập (ROMSID) <span class="text-danger">*</span></label>
                            <input type="text" name="ROMSID" value="@Model.ROMSID" class="form-control font-monospace" placeholder="VD: ROMS-120K" required />
                            <div class="form-text">Mã định danh duy nhất theo tiêu chuẩn Ser_MST_ROMaintanceSetting.</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Mốc số Kilomet (Km) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number" name="Km" value="@Model.Km" class="form-control" min="1000" step="1000" required />
                                <span class="input-group-text">km</span>
                            </div>
                            <div class="form-text">Số km tiêu chuẩn (VD: 5000, 10000, 20000...).</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Cấp độ bảo dưỡng <span class="text-danger">*</span></label>
                            <select name="Level" class="form-select" required>
                                <option value="@((int)MaintenanceLevel.Initial1K)" selected="@(Model.Level == MaintenanceLevel.Initial1K)">Cấp 0: Bảo dưỡng lần đầu (1.000 km)</option>
                                <option value="@((int)MaintenanceLevel.Level1Minor)" selected="@(Model.Level == MaintenanceLevel.Level1Minor)">Cấp 1: Bảo dưỡng nhỏ (5.000 km, 15k...)</option>
                                <option value="@((int)MaintenanceLevel.Level2Medium)" selected="@(Model.Level == MaintenanceLevel.Level2Medium)">Cấp 2: Bảo dưỡng trung bình (10.000 km, 30k...)</option>
                                <option value="@((int)MaintenanceLevel.Level3Major)" selected="@(Model.Level == MaintenanceLevel.Level3Major)">Cấp 3: Bảo dưỡng trung bình lớn (20.000 km, 60k...)</option>
                                <option value="@((int)MaintenanceLevel.Level4Comprehensive)" selected="@(Model.Level == MaintenanceLevel.Level4Comprehensive)">Cấp 4: Bảo dưỡng lớn toàn diện (40.000 km, 80k...)</option>
                            </select>
                            <div class="form-text">Phân cấp kỹ thuật tiêu chuẩn Hyundai.</div>
                        </div>

                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Tên mốc bảo dưỡng</label>
                            <input type="text" name="Name" value="@Model.Name" class="form-control" placeholder="VD: Bảo dưỡng Cấp 4 - 120.000 km" />
                            <div class="form-text">Để trống hệ thống sẽ tự động đặt tên theo Cấp độ và Mốc Km.</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Số thứ tự cấp (Maintances)</label>
                            <input type="number" name="Maintances" value="@Model.Maintances" class="form-control" min="0" max="4" />
                            <div class="form-text">Giá trị trường Maintances nguồn: 0, 1, 2, 3, 4.</div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Chu kỳ thời hạn (Tháng)</label>
                            <div class="input-group">
                                <input type="number" name="MonthsInterval" value="@Model.MonthsInterval" class="form-control" min="1" max="120" />
                                <span class="input-group-text">tháng</span>
                            </div>
                            <div class="form-text">Thời gian khuyến nghị nếu chưa tới số km.</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Định mức giờ công (TakingTime)</label>
                            <div class="input-group">
                                <input type="number" name="TakingTimeHours" value="@Model.TakingTimeHours" class="form-control" step="0.1" min="0.1" />
                                <span class="input-group-text">giờ</span>
                            </div>
                            <div class="form-text">Thời gian định mức kỹ thuật viên thao tác.</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Chi phí ước tính tham khảo</label>
                            <div class="input-group">
                                <input type="number" name="EstimatedCost" value="@Model.EstimatedCost" class="form-control" step="10000" min="0" />
                                <span class="input-group-text">VNĐ</span>
                            </div>
                            <div class="form-text">Tổng chi phí công & phụ tùng combo dự kiến.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Gói combo dịch vụ liên kết</label>
                            <select name="ServicePackageId" class="form-select">
                                <option value="">-- Không liên kết gói combo --</option>
                                @foreach (var p in packages)
                                {
                                    <option value="@p.Id" selected="@(Model.ServicePackageId == p.Id)">
                                        [@p.PackageNo] @p.Name (@p.TakingTimeHours.ToString("N1")h - @p.SubTotal.ToString("N0")đ)
                                    </option>
                                }
                            </select>
                            <div class="form-text">Tự động nạp phụ tùng & công việc khi chọn mốc bảo dưỡng trên RO.</div>
                        </div>

                        <div class="col-md-3 d-flex align-items-center">
                            <div class="form-check form-switch mt-4">
                                <input class="form-check-input" type="checkbox" name="FlagWarranty" value="true" @(Model.FlagWarranty ? "checked" : "") id="flagWarrantySwitch" />
                                <label class="form-check-label fw-semibold" for="flagWarrantySwitch">
                                    Bắt buộc CSBH HTC
                                </label>
                                <div class="form-text">Yêu cầu để duy trì quyền lợi bảo hành.</div>
                            </div>
                        </div>

                        <div class="col-md-3 d-flex align-items-center">
                            <div class="form-check form-switch mt-4">
                                <input class="form-check-input" type="checkbox" name="FlagActive" value="true" @(Model.FlagActive ? "checked" : "") id="flagActiveSwitch" />
                                <label class="form-check-label fw-semibold" for="flagActiveSwitch">
                                    Đang có hiệu lực
                                </label>
                                <div class="form-text">Áp dụng ngay vào hệ thống dịch vụ.</div>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Hạng mục kiểm tra & thay thế bắt buộc (Checklist)</label>
                            <textarea name="RequiredChecklist" class="form-control" rows="3" placeholder="VD: Thay dầu máy & cốc lọc dầu; Thay lọc gió động cơ & điều hòa; Kiểm tra 4 cụm phanh; Đảo lốp; Cân bằng động...">@Model.RequiredChecklist</textarea>
                            <div class="form-text">Các hạng mục kỹ thuật bắt buộc theo cẩm nang bảo dưỡng của hãng Hyundai (ngăn cách bằng dấu chấm phẩy ;).</div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Diễn giải kỹ thuật & Ghi chú tư vấn</label>
                            <textarea name="Description" class="form-control" rows="2" placeholder="Ghi chú thêm về điều kiện vận hành khắc nghiệt, loại động cơ hoặc phụ tùng khuyến cáo...">@Model.Description</textarea>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-between">
                        <a href="/MaintenanceSetting" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i> Hủy bỏ
                        </a>
                        <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-check-circle me-1"></i> Lưu mốc bảo dưỡng
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
