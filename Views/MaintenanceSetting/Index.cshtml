@model List<MaintenanceSetting>
@{
    ViewData["Title"] = "Thiết lập Chu kỳ & Định mức Bảo dưỡng Định kỳ xe (Ser_MST_ROMaintanceSetting)";
    var summary = ViewBag.Summary as MaintenanceSettingSummaryDto ?? new MaintenanceSettingSummaryDto();
    var openROs = ViewBag.OpenROs as List<RepairOrder> ?? [];
    int? curMinKm = ViewBag.MinKm;
    int? curMaxKm = ViewBag.MaxKm;
    MaintenanceLevel? curLevel = ViewBag.Level;
    bool? curWarranty = ViewBag.FlagWarranty;
    bool? curActive = ViewBag.FlagActive;
    string? curQ = ViewBag.Q;
}

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Tổng mốc chu kỳ bảo dưỡng</div>
                <div class="stat-num text-primary">@summary.TotalSettings <span class="fs-6 fw-normal text-muted">mốc</span></div>
                <div class="text-muted" style="font-size:11.5px">Đang áp dụng: <strong class="text-success">@summary.ActiveSettings</strong> · Ngưng: <strong class="text-secondary">@summary.InactiveSettings</strong></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Mốc bắt buộc CSBH Hãng</div>
                <div class="stat-num text-danger">@summary.WarrantyRequiredCount <span class="fs-6 fw-normal text-muted">mốc bảo hành</span></div>
                <div class="text-muted" style="font-size:11.5px">Thỏa mãn CSBH tiêu chuẩn HTC</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Gói combo bảo dưỡng liên kết</div>
                <div class="stat-num text-info">@summary.LinkedPackageCount <span class="fs-6 fw-normal text-muted">gói liên kết</span></div>
                <div class="text-muted" style="font-size:11.5px">Tự động nạp công & phụ tùng combo</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Chi phí ước tính trung bình</div>
                <div class="stat-num text-success">@summary.AvgEstimatedCost.ToString("N0") <span class="fs-6 fw-normal text-muted">đ</span></div>
                <div class="text-muted" style="font-size:11.5px">Giờ công TB: <strong>@summary.AvgLaborHours.ToString("N1") h</strong> · Mốc cao nhất: <strong>@summary.MaxKm.ToString("N0") km</strong></div>
            </div>
        </div>
    </div>
</div>

<!-- Khối Tra cứu & Gợi ý bảo dưỡng theo số ODO xe -->
<div class="card shadow-sm border-0 mb-3 bg-light">
    <div class="card-body p-3">
        <div class="row align-items-center g-2">
            <div class="col-md-3">
                <div class="d-flex align-items-center text-primary">
                    <i class="bi bi-speedometer2 fs-3 me-2"></i>
                    <div>
                        <div class="fw-bold">Tư vấn Bảo dưỡng Nhanh</div>
                        <div class="small text-muted">Nhập số Km xe để tra cứu cấp độ & gói dịch vụ</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white">Km ODO:</span>
                    <input type="number" id="quickKmInput" class="form-control" placeholder="VD: 19800" min="0" step="500" />
                    <button class="btn btn-primary" type="button" onclick="runKmConsultation()">
                        <i class="bi bi-magic me-1"></i> Tra cứu
                    </button>
                </div>
            </div>
            <div class="col-md-6">
                <div id="quickConsultResult" class="d-none alert alert-light border mb-0 py-1 px-3 small d-flex align-items-center justify-content-between">
                    <div>
                        <span id="consultBadge" class="badge me-2">Cấp 1</span>
                        <strong id="consultTitle">Mốc 20,000 km</strong>
                        <span id="consultStatus" class="ms-2 text-danger fw-semibold"></span>
                        <div id="consultAdvice" class="text-muted" style="font-size:11px"></div>
                    </div>
                    <a id="consultDetailBtn" href="#" class="btn btn-outline-primary btn-sm ms-2 py-0" style="font-size:11px">Chi tiết</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-3">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="q" value="@curQ" class="form-control" placeholder="Mã ROMSID, tên mốc, nội dung..." />
                </div>
            </div>
            <div class="col-md-2">
                <select name="level" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Tất cả cấp độ --</option>
                    <option value="@((int)MaintenanceLevel.Initial1K)" selected="@(curLevel == MaintenanceLevel.Initial1K)">Lần đầu (1.000 km)</option>
                    <option value="@((int)MaintenanceLevel.Level1Minor)" selected="@(curLevel == MaintenanceLevel.Level1Minor)">Cấp 1 - Nhỏ (5.000 km)</option>
                    <option value="@((int)MaintenanceLevel.Level2Medium)" selected="@(curLevel == MaintenanceLevel.Level2Medium)">Cấp 2 - Trung bình (10.000 km)</option>
                    <option value="@((int)MaintenanceLevel.Level3Major)" selected="@(curLevel == MaintenanceLevel.Level3Major)">Cấp 3 - TB lớn (20.000 km)</option>
                    <option value="@((int)MaintenanceLevel.Level4Comprehensive)" selected="@(curLevel == MaintenanceLevel.Level4Comprehensive)">Cấp 4 - Lớn (40.000 km)</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="flagWarranty" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Tiêu chuẩn CSBH --</option>
                    <option value="true" selected="@(curWarranty == true)">Bắt buộc duy trì BH</option>
                    <option value="false" selected="@(curWarranty == false)">Khuyến nghị thêm</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="flagActive" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Trạng thái hiệu lực --</option>
                    <option value="true" selected="@(curActive == true)">Đang áp dụng</option>
                    <option value="false" selected="@(curActive == false)">Ngừng áp dụng</option>
                </select>
            </div>
            <div class="col-md-3 text-end">
                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i> Lọc</button>
                <a href="/MaintenanceSetting" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
                <a href="/MaintenanceSetting/Print@(curLevel.HasValue ? $"?level={curLevel}" : "")" target="_blank" class="btn btn-sm btn-outline-info"><i class="bi bi-printer me-1"></i> In sổ tay</a>
                <a href="/MaintenanceSetting/Create" class="btn btn-sm btn-success"><i class="bi bi-plus-lg me-1"></i> Thêm mốc</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:110px">Mã ROMSID</th>
                    <th style="width:140px">Mốc Kilomet</th>
                    <th style="width:160px">Cấp độ bảo dưỡng</th>
                    <th>Tên mốc & Hạng mục tiêu chuẩn</th>
                    <th style="width:110px" class="text-center">Chu kỳ</th>
                    <th style="width:100px" class="text-end">Giờ công</th>
                    <th style="width:130px" class="text-end">Chi phí ước tính</th>
                    <th style="width:110px" class="text-center">CSBH Hãng</th>
                    <th style="width:120px" class="text-center">Gói combo</th>
                    <th style="width:90px" class="text-center">Hiệu lực</th>
                    <th style="width:110px" class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="11" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-1"></i>
                            Không có mốc thiết lập chu kỳ bảo dưỡng nào phù hợp bộ lọc.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr class="@(!item.FlagActive ? "text-muted bg-light" : "")">
                        <td>
                            <a href="/MaintenanceSetting/Detail/@item.Id" class="fw-bold text-decoration-none">
                                @item.ROMSID
                            </a>
                        </td>
                        <td>
                            <span class="badge bg-dark fs-6 font-monospace">@item.Km.ToString("N0") km</span>
                        </td>
                        <td>
                            <span class="badge @item.LevelBadgeClass">
                                @item.LevelName
                            </span>
                        </td>
                        <td>
                            <div class="fw-semibold">@item.Name</div>
                            @if (!string.IsNullOrWhiteSpace(item.RequiredChecklist))
                            {
                                <div class="text-muted small text-truncate" style="max-width:380px" title="@item.RequiredChecklist">
                                    <i class="bi bi-check2-circle text-success me-1"></i>@item.RequiredChecklist
                                </div>
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge bg-light text-dark border">@item.MonthsInterval tháng</span>
                        </td>
                        <td class="text-end">
                            <strong>@item.TakingTimeHours.ToString("N1") h</strong>
                        </td>
                        <td class="text-end">
                            <strong class="text-success">@item.EstimatedCost.ToString("N0") đ</strong>
                        </td>
                        <td class="text-center">
                            @if (item.FlagWarranty)
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle" title="Bắt buộc duy trì bảo hành">
                                    <i class="bi bi-shield-check me-1"></i>HTC CSBH
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border">Tùy chọn</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (item.ServicePackage != null)
                            {
                                <a href="/ServicePackage" class="badge bg-info-subtle text-info border border-info-subtle text-decoration-none" title="@item.ServicePackage.Name">
                                    @item.ServicePackage.PackageNo
                                </a>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (item.FlagActive)
                            {
                                <span class="badge bg-success">Áp dụng</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Tạm ngưng</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a href="/MaintenanceSetting/Detail/@item.Id" class="btn btn-outline-primary" title="Chi tiết"><i class="bi bi-eye"></i></a>
                                <a href="/MaintenanceSetting/Edit/@item.Id" class="btn btn-outline-secondary" title="Sửa"><i class="bi bi-pencil"></i></a>
                                <form method="post" action="/MaintenanceSetting/ToggleActive/@item.Id" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-warning" title="@(item.FlagActive ? "Tạm ngưng" : "Kích hoạt")">
                                        <i class="bi @(item.FlagActive ? "bi-pause" : "bi-play")"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
function runKmConsultation() {
    var km = parseInt(document.getElementById('quickKmInput').value);
    if (isNaN(km) || km < 0) {
        alert('Vui lòng nhập số Kilomet hợp lệ.');
        return;
    }
    fetch('/MaintenanceSetting/Suggest?km=' + km)
        .then(response => response.json())
        .then(data => {
            var box = document.getElementById('quickConsultResult');
            box.classList.remove('d-none');
            
            var badge = document.getElementById('consultBadge');
            var title = document.getElementById('consultTitle');
            var status = document.getElementById('consultStatus');
            var advice = document.getElementById('consultAdvice');
            var detailBtn = document.getElementById('consultDetailBtn');

            if (data.matchedSetting) {
                badge.className = 'badge ' + data.matchedSetting.levelBadgeClass;
                badge.innerText = data.matchedSetting.levelName;
                title.innerText = data.matchedSetting.romsid + ' (' + data.matchedSetting.name + ')';
                status.innerText = data.statusAdvice;
                status.className = 'ms-2 fw-semibold ' + (data.isWarrantyCompliant ? 'text-success' : 'text-danger');
                advice.innerText = data.adviceNote;
                detailBtn.href = '/MaintenanceSetting/Detail/' + data.matchedSetting.id;
                detailBtn.classList.remove('d-none');
            } else {
                badge.className = 'badge bg-secondary';
                badge.innerText = 'Không có';
                title.innerText = 'Chưa tìm thấy mốc bảo dưỡng';
                status.innerText = '';
                advice.innerText = data.adviceNote || '';
                detailBtn.classList.add('d-none');
            }
        })
        .catch(err => {
            console.error(err);
            alert('Có lỗi khi tra cứu mốc bảo dưỡng.');
        });
}
</script>
}