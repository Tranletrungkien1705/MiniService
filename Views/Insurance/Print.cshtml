@model InsuranceClaim
@{
    Layout = null;
    var (stTxt, stCode, _) = Ui.InsuranceClaimStatus(Model.Status);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Biên bản giám định bồi thường — @Model.ClaimNo</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        body { font-family: "Be Vietnam Pro", sans-serif; font-size: 13px; color: #111; background: #fff; padding: 25px; }
        .print-btn-bar { margin-bottom: 20px; }
        .form-title { text-transform: uppercase; font-weight: 800; font-size: 19px; }
        .table-items th { background: #f1f5f9; font-weight: 700; font-size: 12px; }
        .box-info { border: 1px solid #cbd5e1; border-radius: 6px; padding: 12px; }
        @@media print {
            .no-print { display: none !important; }
            body { padding: 0; }
        }
    </style>
</head>
<body>
    <div class="no-print print-btn-bar d-flex justify-content-between align-items-center">
        <a href="/Insurance/Detail/@Model.Id" class="btn btn-sm btn-outline-secondary">← Quay lại hồ sơ</a>
        <button onclick="window.print()" class="btn btn-sm btn-primary"><i class="bi bi-printer me-1"></i>In biên bản</button>
    </div>

    <!-- Header -->
    <div class="row align-items-center border-bottom pb-3 mb-3">
        <div class="col-7">
            <h5 class="fw-bold mb-1">XƯỞNG DỊCH VỤ Ô TÔ TIÊU CHUẨN CHÍNH HÃNG</h5>
            <div class="text-muted small">Trung tâm Dịch vụ, Sửa chữa &amp; Bảo hành Thân vỏ Xe</div>
            <div class="text-muted small">Điện thoại Hotline: 1900 8899 · Cứu hộ 24/7</div>
        </div>
        <div class="col-5 text-end">
            <div class="fw-bold font-monospace fs-5">@Model.ClaimNo</div>
            <div class="small">Lệnh SC (RO): <b>@Model.RO.Code</b></div>
            <div class="small text-muted">Ngày lập: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
        </div>
    </div>

    <!-- Tiêu đề -->
    <div class="text-center my-3">
        <div class="form-title">BIÊN BẢN GIÁM ĐỊNH TỔN THẤT &amp; THÔNG BÁO BẢO LÃNH BỒI THƯỜNG</div>
        <div class="small text-muted fst-italic">(Hồ sơ liên kết giải quyết bồi thường bảo hiểm thân vỏ xe cơ giới)</div>
    </div>

    <!-- Thông tin xe & Bảo hiểm -->
    <div class="row g-3 mb-3">
        <div class="col-6">
            <div class="box-info h-100">
                <div class="fw-bold text-uppercase border-bottom pb-1 mb-2 text-primary" style="font-size:12px">I. THÔNG TIN PHƯƠNG TIỆN &amp; KHÁCH HÀNG</div>
                <div class="row g-1 small">
                    <div class="col-5 text-muted">Biển kiểm soát:</div>
                    <div class="col-7 fw-bold fs-6">@Model.RO.Car.Plate</div>
                    <div class="col-5 text-muted">Nhãn hiệu / Dòng xe:</div>
                    <div class="col-7 fw-semibold">@Model.RO.Car.Model (@Model.RO.Car.Year)</div>
                    <div class="col-5 text-muted">Số khung (VIN):</div>
                    <div class="col-7 font-monospace">@(Model.RO.Car.Vin ?? "—")</div>
                    <div class="col-5 text-muted">Số Km vào xưởng:</div>
                    <div class="col-7 font-monospace">@Model.RO.Odometer.ToString("N0") km</div>
                    <div class="col-5 text-muted">Chủ xe / Người lái:</div>
                    <div class="col-7 fw-semibold">@Model.RO.Customer.Name</div>
                    <div class="col-5 text-muted">Điện thoại liên hệ:</div>
                    <div class="col-7">@(Model.RO.Customer.Phone ?? "—")</div>
                </div>
            </div>
        </div>

        <div class="col-6">
            <div class="box-info h-100">
                <div class="fw-bold text-uppercase border-bottom pb-1 mb-2 text-primary" style="font-size:12px">II. THÔNG TIN BẢO HIỂM &amp; VỤ TỔN THẤT</div>
                <div class="row g-1 small">
                    <div class="col-5 text-muted">Công ty bảo hiểm:</div>
                    <div class="col-7 fw-bold">@Model.InsuranceCompany.InsName</div>
                    <div class="col-5 text-muted">Số GCN / Đơn BH:</div>
                    <div class="col-7 font-monospace fw-bold">@Model.PolicyNo</div>
                    <div class="col-5 text-muted">Số hồ sơ bồi thường:</div>
                    <div class="col-7 font-monospace">@(Model.ClaimFileNo ?? "Chưa cấp")</div>
                    <div class="col-5 text-muted">Giám định viên:</div>
                    <div class="col-7">@(Model.SurveyorName ?? "—") (@(Model.SurveyorPhone ?? "—"))</div>
                    <div class="col-5 text-muted">Thời điểm xảy ra:</div>
                    <div class="col-7">@Model.AccidentDate.ToString("dd/MM/yyyy")</div>
                    <div class="col-5 text-muted">Địa điểm sự vụ:</div>
                    <div class="col-7">@(Model.AccidentLocation ?? "—")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hiện trường tổn thất -->
    <div class="box-info mb-3">
        <div class="fw-bold text-uppercase border-bottom pb-1 mb-2 text-primary" style="font-size:12px">III. HIỆN TRƯỜNG &amp; MÔ TẢ TỔN THẤT VA CHẠM</div>
        <div class="small">@Model.AccidentDescription</div>
    </div>

    <!-- Chi tiết hạng mục tổn thất -->
    <div class="mb-3">
        <div class="fw-bold text-uppercase mb-2 text-primary" style="font-size:12px">IV. HẠNG MỤC SỬA CHỮA, PHỤ TÙNG THAY THẾ &amp; DỰ TOÁN DUYỆT</div>
        <table class="table table-bordered align-middle small table-items mb-2">
            <thead>
                <tr>
                    <th style="width:35px" class="text-center">STT</th>
                    <th style="width:90px">Phân loại</th>
                    <th style="width:110px">Mã hiệu</th>
                    <th>Tên hạng mục phục hồi / Phụ tùng thay thế</th>
                    <th style="width:50px" class="text-center">SL</th>
                    <th style="width:100px" class="text-end">Đơn giá</th>
                    <th style="width:110px" class="text-end">Dự toán</th>
                    <th style="width:110px" class="text-end">BH duyệt</th>
                    <th>Kết luận giám định</th>
                </tr>
            </thead>
            <tbody>
                @{ int stt = 1; }
                @foreach (var itm in Model.Items)
                {
                    <tr>
                        <td class="text-center">@(stt++)</td>
                        <td>@Ui.Line(itm.Type)</td>
                        <td class="font-monospace">@itm.Code</td>
                        <td>@itm.Name</td>
                        <td class="text-center">@itm.Quantity.ToString("G29")</td>
                        <td class="text-end font-monospace">@itm.UnitPrice.ToString("N0")</td>
                        <td class="text-end font-monospace">@itm.EstimatedAmount.ToString("N0")</td>
                        <td class="text-end font-monospace fw-bold text-success">@itm.ApprovedAmount.ToString("N0")</td>
                        <td class="small">@(itm.Note ?? (itm.IsApproved ? "Duyệt bồi thường" : "Loại trừ"))</td>
                    </tr>
                }
            </tbody>
            <tfoot class="fw-bold font-monospace table-light">
                <tr>
                    <td colspan="6" class="text-end">TỔNG CỘNG CHI PHÍ:</td>
                    <td class="text-end">@Model.EstimatedAmount.ToString("N0")</td>
                    <td class="text-end text-success">@Model.ApprovedAmount.ToString("N0")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Phân bổ thanh toán -->
    <div class="box-info mb-4">
        <div class="fw-bold text-uppercase border-bottom pb-1 mb-2 text-primary" style="font-size:12px">V. PHÂN BỔ NGHĨA VỤ THANH TOÁN BỒI THƯỜNG</div>
        <div class="row g-2 small">
            <div class="col-8">1. Tổng số tiền được Hãng bảo hiểm duyệt bồi thường:</div>
            <div class="col-4 text-end font-monospace fw-bold">@Model.ApprovedAmount.ToString("N0") VNĐ</div>

            <div class="col-8 text-muted">2. Mức khấu trừ / Miễn thường theo hợp đồng:</div>
            <div class="col-4 text-end font-monospace text-danger">-@Model.DeductibleAmount.ToString("N0") VNĐ</div>

            @if (Model.PenaltyAmount > 0)
            {
                <div class="col-8 text-muted">3. Số tiền chế tài giảm trừ bồi thường:</div>
                <div class="col-4 text-end font-monospace text-danger">-@Model.PenaltyAmount.ToString("N0") VNĐ</div>
            }

            <div class="col-8 fw-bold text-success pt-1 border-top">4. Số tiền Công ty Bảo hiểm bảo lãnh thanh toán cho Xưởng:</div>
            <div class="col-4 text-end font-monospace fw-bold text-success fs-6 pt-1 border-top">@Model.InsuranceAmount.ToString("N0") VNĐ</div>
            <div class="col-12 text-muted fst-italic" style="font-size:12px">Bằng chữ: @Ui.MoneyToWords(Model.InsuranceAmount)</div>

            <div class="col-8 fw-bold text-danger pt-1 border-top">5. Số tiền Khách hàng / Chủ xe có trách nhiệm thanh toán:</div>
            <div class="col-4 text-end font-monospace fw-bold text-danger fs-6 pt-1 border-top">@Model.CustomerAmount.ToString("N0") VNĐ</div>
            <div class="col-12 text-muted fst-italic" style="font-size:12px">Bằng chữ: @Ui.MoneyToWords(Model.CustomerAmount)</div>
        </div>
    </div>

    <!-- Chữ ký xác nhận -->
    <div class="row text-center mt-4 pt-3 small">
        <div class="col-3">
            <div class="fw-bold text-uppercase">ĐẠI DIỆN CHỦ XE</div>
            <div class="text-muted fst-italic">(Ký, ghi rõ họ tên)</div>
            <div style="height:70px"></div>
            <div class="fw-bold">@Model.RO.Customer.Name</div>
        </div>
        <div class="col-3">
            <div class="fw-bold text-uppercase">GIÁM ĐỊNH VIÊN BH</div>
            <div class="text-muted fst-italic">(Ký, ghi rõ họ tên)</div>
            <div style="height:70px"></div>
            <div class="fw-bold">@(Model.SurveyorName ?? "................................")</div>
        </div>
        <div class="col-3">
            <div class="fw-bold text-uppercase">CỐ VẤN DỊCH VỤ</div>
            <div class="text-muted fst-italic">(Ký, ghi rõ họ tên)</div>
            <div style="height:70px"></div>
            <div class="fw-bold">@Model.CreatedBy</div>
        </div>
        <div class="col-3">
            <div class="fw-bold text-uppercase">KẾ TOÁN TRƯỞNG</div>
            <div class="text-muted fst-italic">(Ký, ghi rõ họ tên)</div>
            <div style="height:70px"></div>
            <div class="fw-bold">................................</div>
        </div>
    </div>
</body>
</html>
