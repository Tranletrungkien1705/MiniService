@model WarrantyWork
@{
    ViewData["Title"] = $"Chi tiết Định mức Bảo hành: {Model.Code}";
    var openROs = ViewBag.OpenROs as List<RepairOrder> ?? [];
    var groupInfo = Ui.WarrantyLaborGroup(Model.LaborGroup);
    var covInfo = Ui.WarrantyCoverageType(Model.CoverageType);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-primary font-monospace fs-6">@Model.Code</span>
            <span class="badge bg-secondary-subtle text-secondary-emphasis border fs-6">@Model.Model</span>
            <span class="badge bg-@groupInfo.css-subtle text-@groupInfo.css-emphasis border">
                <i class="bi @groupInfo.icon me-1"></i>@groupInfo.text
            </span>
            <span class="badge bg-@covInfo.css-subtle text-@covInfo.css-emphasis border">
                [@covInfo.code] @covInfo.text
            </span>
            @if (Model.FlagActive)
            {
                <span class="badge bg-success">Đang áp dụng</span>
            }
            else
            {
                <span class="badge bg-secondary">Tạm ngừng áp dụng</span>
            }
        </div>
        <h4 class="mb-0 fw-bold">@Model.Name</h4>
    </div>
    <div class="btn-group">
        @if (Model.FlagActive)
        {
            <button type="button" class="btn btn-sm btn-success" onclick="openApplyModal(@Model.Id, '@Model.Code', '@Model.Name', @Model.RateHour, '@Model.Model')">
                <i class="bi bi-wrench me-1"></i> Gán vào RO
            </button>
        }
        <a href="/WarrantyWork/Edit/@Model.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil me-1"></i> Chỉnh sửa</a>
        <a href="/WarrantyWork/Print?model=@Model.Model" target="_blank" class="btn btn-sm btn-outline-dark"><i class="bi bi-printer me-1"></i> In tài liệu</a>
        <a href="/WarrantyWork" class="btn btn-sm btn-outline-primary"><i class="bi bi-arrow-left me-1"></i> Danh sách</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-primary-subtle border-primary">
            <div class="card-body">
                <div class="text-primary small fw-semibold">Giờ công Flat Rate (Std Rate)</div>
                <div class="stat-num text-primary">@Model.RateHour.ToString("N1") <span class="fs-6 fw-normal text-muted">giờ</span></div>
                <div class="text-muted" style="font-size:11.5px">Định mức công kỹ thuật hãng quy định</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Đơn giá giờ công hãng duyệt</div>
                <div class="stat-num text-dark font-monospace">@Model.RatePrice.ToString("N0") <span class="fs-6 fw-normal text-muted">đ/h</span></div>
                <div class="text-muted" style="font-size:11.5px">HTC bồi hoàn chi phí đại lý</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Thành tiền công bảo hành</div>
                <div class="stat-num text-success font-monospace">@Model.Price.ToString("N0") <span class="fs-6 fw-normal text-muted">đ</span></div>
                <div class="text-muted" style="font-size:11.5px">Tổng thanh toán: <strong>@Model.TotalWithVat.ToString("N0") đ</strong> (VAT @Model.VatPercent%)</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Lượt đã áp dụng trên RO</div>
                <div class="stat-num text-info">@Model.UsageCount <span class="fs-6 fw-normal text-muted">lượt</span></div>
                <div class="text-muted" style="font-size:11.5px">Đã nghiệm thu trên hồ sơ bảo hành</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-info-circle me-1 text-primary"></i> Thông số Kỹ thuật &amp; Phê duyệt</h6>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-borderless mb-0" style="font-size:13px">
                    <tbody>
                        <tr class="border-bottom">
                            <td class="text-muted ps-3 py-2" style="width:180px">Mã công việc (Code):</td>
                            <td class="fw-bold font-monospace text-primary py-2">@Model.Code</td>
                        </tr>
                        <tr class="border-bottom">
                            <td class="text-muted ps-3 py-2">Dòng xe áp dụng:</td>
                            <td class="fw-semibold py-2">@Model.Model</td>
                        </tr>
                        <tr class="border-bottom">
                            <td class="text-muted ps-3 py-2">Hệ thống kỹ thuật:</td>
                            <td class="py-2">
                                <span class="badge bg-@groupInfo.css-subtle text-@groupInfo.css-emphasis border">
                                    <i class="bi @groupInfo.icon me-1"></i>@groupInfo.text
                                </span>
                            </td>
                        </tr>
                        <tr class="border-bottom">
                            <td class="text-muted ps-3 py-2">Chính sách bảo hành:</td>
                            <td class="py-2">
                                <span class="badge bg-@covInfo.css-subtle text-@covInfo.css-emphasis border">
                                    [@covInfo.code] @covInfo.text
                                </span>
                            </td>
                        </tr>
                        <tr class="border-bottom">
                            <td class="text-muted ps-3 py-2">Kiểu động cơ / Phiên bản:</td>
                            <td class="py-2">@(string.IsNullOrWhiteSpace(Model.EngineType) ? "Tất cả phiên bản" : Model.EngineType)</td>
                        </tr>
                        <tr class="border-bottom">
                            <td class="text-muted ps-3 py-2">Mã phê duyệt HTC/HTV:</td>
                            <td class="py-2 font-monospace">@(string.IsNullOrWhiteSpace(Model.AppTypeCode) ? "—" : Model.AppTypeCode)</td>
                        </tr>
                        <tr class="border-bottom">
                            <td class="text-muted ps-3 py-2">Thuế GTGT (VAT):</td>
                            <td class="py-2">@Model.VatPercent%</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-3 py-2">Người tạo / Cập nhật:</td>
                            <td class="py-2 text-muted" style="font-size:12px">@Model.CreatedBy ngày @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") @(Model.UpdatedAt.HasValue ? $"· Sửa lúc {Model.UpdatedAt:dd/MM/yyyy HH:mm} bởi {Model.UpdatedBy}" : "")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-camera me-1 text-primary"></i> Quy chuẩn Hồ sơ Ảnh &amp; Hướng dẫn Thao tác</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary text-uppercase" style="font-size:11px">Hồ sơ ảnh nghiệm thu bắt buộc (Required Photos)</label>
                    @if (!string.IsNullOrWhiteSpace(Model.RequiredPhotos))
                    {
                        <div class="alert alert-light border small text-dark py-2 px-3 mb-0">
                            @foreach (var line in Model.RequiredPhotos.Split(';'))
                            {
                                if (!string.IsNullOrWhiteSpace(line))
                                {
                                    <div class="py-1"><i class="bi bi-check2-circle text-success me-2"></i>@line.Trim()</div>
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small fst-italic">Chưa có danh mục ảnh bắt buộc. Yêu cầu tối thiểu: Ảnh ODO, ảnh VIN và ảnh chi tiết phụ tùng lỗi.</div>
                    }
                </div>
                <div>
                    <label class="form-label small fw-bold text-secondary text-uppercase" style="font-size:11px">Ghi chú kỹ thuật &amp; điều kiện bảo hành</label>
                    @if (!string.IsNullOrWhiteSpace(Model.Remark))
                    {
                        <div class="p-2 bg-light rounded small text-dark border">
                            <i class="bi bi-wrench-adjustable text-primary me-1"></i>@Model.Remark
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small fst-italic">Tuân thủ quy trình chuẩn Workshop Manual của Hyundai.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <div>
            <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-clock-history me-1 text-primary"></i> Lịch sử Áp dụng vào Lệnh Sửa chữa (RO)</h6>
            <span class="text-muted small">Danh sách các Lệnh sửa chữa đã sử dụng công việc bảo hành định mức này (@Model.UsageCount lượt)</span>
        </div>
        @if (Model.FlagActive)
        {
            <button type="button" class="btn btn-sm btn-outline-success" onclick="openApplyModal(@Model.Id, '@Model.Code', '@Model.Name', @Model.RateHour, '@Model.Model')">
                <i class="bi bi-plus-lg me-1"></i> Gán vào RO khác
            </button>
        }
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size:13px">
                <thead class="table-light text-secondary">
                    <tr>
                        <th style="width:130px">Số RO</th>
                        <th style="width:120px">Biển số xe</th>
                        <th style="width:130px">Dòng xe</th>
                        <th>Khách hàng</th>
                        <th>Nội dung dòng sửa chữa</th>
                        <th class="text-end" style="width:100px">Giờ công</th>
                        <th class="text-end" style="width:120px">Đơn giá / h</th>
                        <th class="text-end" style="width:120px">Thành tiền</th>
                        <th class="text-center" style="width:110px">Trạng thái RO</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RepairLines.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                Chưa có Lệnh sửa chữa nào áp dụng công việc định mức này.
                            </td>
                        </tr>
                    }
                    @foreach (var line in Model.RepairLines)
                    {
                        <tr>
                            <td>
                                @if (line.RO != null)
                                {
                                    <a href="/Ro/Detail/@line.RO.Id" class="fw-bold font-monospace text-decoration-none text-primary">
                                        @line.RO.Code
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted font-monospace">RO#@line.ROId</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace">@(line.RO?.Car?.Plate ?? "—")</span>
                            </td>
                            <td>@(line.RO?.Car?.Model ?? "—")</td>
                            <td>@(line.RO?.Customer?.Name ?? "—")</td>
                            <td>
                                <div class="fw-semibold">@line.Name</div>
                                <span class="badge bg-primary-subtle text-primary border" style="font-size:10.5px">Bảo hành hãng</span>
                            </td>
                            <td class="text-end fw-bold text-dark">
                                @line.Quantity.ToString("N1") h
                            </td>
                            <td class="text-end font-monospace text-muted">
                                @line.UnitPrice.ToString("N0") đ
                            </td>
                            <td class="text-end font-monospace fw-bold text-success">
                                @line.Amount.ToString("N0") đ
                            </td>
                            <td class="text-center">
                                @if (line.RO != null)
                                {
                                    var st = Ui.Status(line.RO.Status);
                                    <span class="badge bg-@st.css">@st.text</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center">
    <form method="post" action="/WarrantyWork/Delete/@Model.Id" onsubmit="return confirm('Bạn có chắc muốn xóa hoặc ngưng áp dụng định mức @Model.Code?')">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash me-1"></i> Xóa / Ngừng áp dụng</button>
    </form>
    <div class="d-flex gap-2">
        <a href="/WarrantyWork/Edit/@Model.Id" class="btn btn-primary btn-sm"><i class="bi bi-pencil me-1"></i> Chỉnh sửa thông số</a>
        <a href="/WarrantyWork" class="btn btn-secondary btn-sm">Quay lại danh sách</a>
    </div>
</div>

<!-- Modal Áp dụng công việc bảo hành vào Lệnh sửa chữa RO -->
<div class="modal fade" id="applyModal" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" action="/WarrantyWork/ApplyToRO" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="warrantyWorkId" id="modalWorkId" />
            <div class="modal-header">
                <h6 class="modal-title fw-bold"><i class="bi bi-wrench-adjustable me-1 text-primary"></i> Áp dụng công việc bảo hành vào RO</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info py-2 small mb-3">
                    <strong id="modalWorkCode"></strong>: <span id="modalWorkName"></span> (<span id="modalWorkModel"></span>)
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Chọn Lệnh sửa chữa đang mở (RO) <span class="text-danger">*</span></label>
                    <select name="roId" class="form-select form-select-sm" required>
                        <option value="">-- Chọn RO đang tiếp nhận / sửa chữa --</option>
                        @foreach (var ro in openROs)
                        {
                            <option value="@ro.Id">@ro.Code — Xe: @(ro.Car?.Plate ?? "N/A") (@(ro.Car?.Model ?? "N/A")) — KH: @(ro.Customer?.Name ?? "N/A") [@Ui.Status(ro.Status).text]</option>
                        }
                    </select>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Giờ công thực hiện (h)</label>
                        <input type="number" step="0.1" name="customHours" id="modalWorkHours" class="form-control form-control-sm" />
                        <div class="form-text" style="font-size:11px">Mặc định theo định mức Flat Rate</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Phân loại chi phí</label>
                        <input type="text" class="form-control form-control-sm" value="Bảo hành hãng (Warranty)" readonly />
                        <div class="form-text" style="font-size:11px">Tự động gắn ExpenseType = Warranty</div>
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold">Ghi chú bổ sung dòng sửa chữa</label>
                    <input type="text" name="note" class="form-control form-control-sm" placeholder="VD: Thay thế theo kết luận kỹ thuật viên..." />
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check-lg me-1"></i> Xác nhận gắn vào RO</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
function openApplyModal(id, code, name, hours, model) {
    document.getElementById('modalWorkId').value = id;
    document.getElementById('modalWorkCode').innerText = code;
    document.getElementById('modalWorkName').innerText = name;
    document.getElementById('modalWorkModel').innerText = model;
    document.getElementById('modalWorkHours').value = hours;
    new bootstrap.Modal(document.getElementById('applyModal')).show();
}
</script>
}
