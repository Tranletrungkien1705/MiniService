@model List<StockOut>
@{
    ViewData["Title"] = "Quản lý Xuất kho phụ tùng (Stock Out)";
    var curStatus = (StockOutStatus?)ViewBag.Status;
    var totalCount = Model.Count;
    var pendingCount = Model.Count(s => s.Status is StockOutStatus.Pending or StockOutStatus.Executing);
    var finishedCount = Model.Count(s => s.Status == StockOutStatus.Finished);
    var totalExportValue = Model.Where(s => s.Status == StockOutStatus.Finished).Sum(s => s.Total);
}

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="card"><div class="card-body">
            <div class="text-muted small">Tổng số phiếu xuất</div>
            <div class="stat-num text-primary">@totalCount</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card"><div class="card-body">
            <div class="text-muted small">Chờ xuất / Đang soạn hàng</div>
            <div class="stat-num text-warning">@pendingCount</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card"><div class="card-body">
            <div class="text-muted small">Đã xuất kho thành công</div>
            <div class="stat-num text-success">@finishedCount</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card"><div class="card-body">
            <div class="text-muted small">Tổng giá trị đã xuất</div>
            <div class="stat-num" style="color:#2563eb;font-size:20px">@totalExportValue.ToString("N0") <span class="fs-6 fw-normal text-muted">đ</span></div>
        </div></div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <form method="get" class="d-flex gap-2 flex-wrap">
                <input name="q" value="@ViewBag.Q" class="form-control form-control-sm" placeholder="Mã phiếu / RO / Xe / Khách / Người nhận..." style="max-width:260px" />
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control form-control-sm" title="Từ ngày" style="max-width:145px" />
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control form-control-sm" title="Đến ngày" style="max-width:145px" />
                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()" style="max-width:180px">
                    <option value="">— Tất cả trạng thái —</option>
                    @foreach (StockOutStatus s in Enum.GetValues(typeof(StockOutStatus)))
                    {
                        var (stName, stCode, _) = Ui.StockOutStatus(s);
                        <option value="@((int)s)" selected="@(curStatus == s)">[@stCode] @stName</option>
                    }
                </select>
                <button class="btn btn-sm btn-primary">Lọc</button>
                @if (curStatus.HasValue || !string.IsNullOrEmpty(ViewBag.Q) || !string.IsNullOrEmpty(ViewBag.FromDate) || !string.IsNullOrEmpty(ViewBag.ToDate) || ViewBag.ROId != null)
                {
                    <a href="/StockOut" class="btn btn-sm btn-outline-secondary">Xóa lọc</a>
                }
            </form>
            <div class="d-flex gap-2">
                <a href="/Part" class="btn btn-sm btn-outline-secondary"><i class="bi bi-box-seam me-1"></i>Kho phụ tùng</a>
                <a href="/StockOut/Create" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1"></i>Lập phiếu xuất kho</a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Mã phiếu xuất</th>
                        <th>Ngày xuất</th>
                        <th>Loại xuất</th>
                        <th>Lệnh sửa chữa (RO) / Xe</th>
                        <th>Người nhận hàng</th>
                        <th>Số mặt hàng</th>
                        <th>Tổng tiền (VAT)</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        var (stText, stCode, stCss) = Ui.StockOutStatus(s.Status);
                        var typeText = Ui.StockOutType(s.Type);
                        <tr>
                            <td>
                                <a href="/StockOut/Detail/@s.Id" class="fw-bold text-decoration-none">@s.StockOutNo</a>
                                <div class="text-muted" style="font-size:11px">Lập bởi: @s.CreatedBy</div>
                            </td>
                            <td>
                                <div>@s.StockOutDate.ToString("dd/MM/yyyy")</div>
                                <div class="text-muted" style="font-size:11px">@s.CreatedAt.ToString("HH:mm")</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@typeText</span>
                            </td>
                            <td>
                                @if (s.RO != null)
                                {
                                    <div><a href="/RO/Detail/@s.RO.Id" class="badge bg-info text-dark text-decoration-none"><i class="bi bi-clipboard2-pulse me-1"></i>@s.RO.Code</a></div>
                                    @if (s.Car != null)
                                    {
                                        <div class="small text-muted"><i class="bi bi-car-front me-1"></i>@s.Car.Plate · @s.Car.Model</div>
                                    }
                                }
                                else if (s.Customer != null)
                                {
                                    <div class="fw-semibold">@s.Customer.Name</div>
                                    @if (s.Car != null)
                                    {
                                        <div class="small text-muted">@s.Car.Plate</div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Khách lẻ / Xuất nội bộ</span>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold">@(s.RecipientName ?? "—")</div>
                                @if (!string.IsNullOrWhiteSpace(s.Description))
                                {
                                    <div class="text-muted text-truncate" style="font-size:11px;max-width:200px" title="@s.Description">@s.Description</div>
                                }
                            </td>
                            <td>
                                <span class="badge bg-secondary-subtle text-secondary-emphasis">@s.ItemCount mặt hàng</span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@s.Total.ToString("N0") <span class="text-muted fw-normal" style="font-size:11px">đ</span></div>
                                <div class="text-muted" style="font-size:11px">Trước VAT: @s.SubTotal.ToString("N0")đ</div>
                            </td>
                            <td>
                                <span class="badge bg-@stCss">@stCode — @stText</span>
                            </td>
                            <td>
                                <a href="/StockOut/Detail/@s.Id" class="btn btn-sm btn-outline-primary" title="Xem chi tiết"><i class="bi bi-eye"></i></a>
                            </td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-2 d-block mb-1"></i>
                                Không tìm thấy phiếu xuất kho phụ tùng nào phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
