@model CustomerGroup
@{
    Layout = null;
    var summary = (CustomerGroupSummaryDto?)ViewBag.Summary;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Thỏa thuận bảo dưỡng đội xe - @Model.GroupName (@Model.GroupNo)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body { font-family: 'Times New Roman', Times, serif; font-size: 14px; color: #000; background: #fff; line-height: 1.4; }
        .print-container { max-width: 900px; margin: 20px auto; padding: 25px 35px; border: 1px solid #ccc; background: #fff; }
        .doc-title { font-size: 19px; font-weight: bold; text-transform: uppercase; }
        .section-title { font-size: 14px; font-weight: bold; text-transform: uppercase; margin-top: 15px; margin-bottom: 8px; border-bottom: 1px solid #333; padding-bottom: 3px; }
        table.tbl-print { width: 100%; border-collapse: collapse; margin-top: 8px; }
        table.tbl-print th, table.tbl-print td { border: 1px solid #333; padding: 6px 8px; font-size: 13px; }
        table.tbl-print th { background-color: #f2f2f2; text-align: center; }
        .sign-box { height: 80px; }
        @@media print {
            .no-print { display: none !important; }
            .print-container { border: none !important; margin: 0 !important; padding: 0 !important; max-width: 100% !important; }
            body { font-size: 13px; }
        }
    </style>
</head>
<body>
    <div class="no-print bg-light py-2 border-bottom text-center mb-3">
        <button onclick="window.print()" class="btn btn-primary btn-sm px-3 me-2"><i class="bi bi-printer me-1"></i>In bản thỏa thuận</button>
        <button onclick="window.close()" class="btn btn-secondary btn-sm px-3">Đóng cửa sổ</button>
    </div>

    <div class="print-container">
        <!-- Header -->
        <div class="row align-items-center border-bottom pb-2 mb-3">
            <div class="col-7">
                <div class="fw-bold" style="font-size:15px">HYUNDAI 3S DEALER NETWORK</div>
                <div style="font-size:12px">XƯỞNG DỊCH VỤ &amp; TRUNG TÂM BẢO HÀNH CHÍNH HÃNG</div>
                <div style="font-size:12px">Địa chỉ: Lô 12-14 Cụm Công nghiệp Phụ trợ Ô tô, Q. Cầu Giấy, Hà Nội</div>
                <div style="font-size:12px">Hotline Dịch vụ: 1900-633633 | Cứu hộ 24/7: 0912-888-999</div>
            </div>
            <div class="col-5 text-end">
                <div style="font-size:12px">Mã khách đoàn: <strong class="font-monospace">@Model.GroupNo</strong></div>
                <div style="font-size:12px">Số HĐ: <strong>@(Model.ContractNo ?? "HD-FLEET/2026")</strong></div>
                <div style="font-size:12px">Ngày đăng ký: <strong>@Model.CreatedAt.ToString("dd/MM/yyyy")</strong></div>
            </div>
        </div>

        <div class="text-center my-3">
            <div class="doc-title">BIÊN BẢN XÁC NHẬN ĐĂNG KÝ &amp; THỎA THUẬN BẢO DƯỠNG ĐỘI XE KHÁCH ĐOÀN</div>
            <div class="fst-italic" style="font-size:13px">(Ban hành theo Quy chuẩn Chăm sóc Khách hàng Doanh nghiệp Hyundai Thành Công HTC)</div>
        </div>

        <!-- 1. Thông tin khách đoàn -->
        <div class="section-title">I. THÔNG TIN BÊN ĐỐI TÁC KHÁCH ĐOÀN (BÊN A)</div>
        <div class="row g-2">
            <div class="col-8"><strong>Tên doanh nghiệp / Đội xe:</strong> @Model.GroupName</div>
            <div class="col-4"><strong>Mã số thuế:</strong> @(Model.TaxCode ?? "Chưa cung cấp")</div>
            <div class="col-12"><strong>Địa chỉ trụ sở:</strong> @(Model.Address ?? "Chưa cung cấp")</div>
            <div class="col-6"><strong>Điện thoại:</strong> @(Model.Telephone ?? "—")</div>
            <div class="col-6"><strong>Hòm thư điện tử:</strong> @(Model.Email ?? "—")</div>
            <div class="col-6"><strong>Đại diện phụ trách phương tiện:</strong> @(Model.ContactPerson ?? "—")</div>
            <div class="col-6"><strong>SĐT di động đại diện:</strong> @(Model.ContactPhone ?? "—")</div>
        </div>

        <!-- 2. Thỏa thuận chính sách -->
        <div class="section-title">II. CHÍNH SÁCH ƯU ĐÃI DỊCH VỤ &amp; HẠN MỨC CÔNG NỢ ĐỘI XE</div>
        <div class="row g-2 mb-2">
            <div class="col-6">
                • <strong>Mức giảm giá Tiền công sửa chữa (Labor):</strong> <span class="fw-bold fs-6 text-primary">-@Model.DiscountPercentLabor%</span>
            </div>
            <div class="col-6">
                • <strong>Mức giảm giá Phụ tùng chính hãng (Parts):</strong> <span class="fw-bold fs-6 text-primary">-@Model.DiscountPercentPart%</span>
            </div>
            <div class="col-6">
                • <strong>Hạn mức công nợ tín dụng tối đa:</strong> <strong>@Model.CreditLimit.ToString("N0") VNĐ</strong>
            </div>
            <div class="col-6">
                • <strong>Kỳ hạn thanh toán công nợ:</strong> <strong>@Model.PaymentTermDays ngày</strong> kể từ ngày xuất hóa đơn
            </div>
            <div class="col-12">
                • <strong>Thời hạn hợp đồng dịch vụ:</strong>
                @(Model.ContractStartDate?.ToString("dd/MM/yyyy") ?? "Từ ngày ký") đến @(Model.ContractEndDate?.ToString("dd/MM/yyyy") ?? "Gia hạn hàng năm")
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="col-12">
                    • <strong>Điều khoản ưu tiên dịch vụ:</strong> <em>@Model.Description</em>
                </div>
            }
        </div>

        <!-- 3. Danh sách xe trong đoàn -->
        <div class="section-title">III. DANH BẠ XE ĐĂNG KÝ BẢO DƯỠNG THUỘC ĐOÀN (@Model.Members.Count(m => m.IsActive) XE)</div>
        <table class="tbl-print">
            <thead>
                <tr>
                    <th style="width:40px">STT</th>
                    <th style="width:110px">Biển số xe</th>
                    <th>Dòng xe / Model</th>
                    <th style="width:160px">Số khung (VIN)</th>
                    <th style="width:140px">Tài xế phụ trách</th>
                    <th style="width:110px">SĐT tài xế</th>
                    <th>Ghi chú xe</th>
                </tr>
            </thead>
            <tbody>
                @{ int idx = 1; }
                @foreach (var m in Model.Members.Where(m => m.IsActive).OrderBy(m => m.PlateNo))
                {
                    <tr>
                        <td class="text-center">@(idx++)</td>
                        <td class="text-center fw-bold">@m.PlateNo</td>
                        <td>@(m.Car?.Model ?? "—")</td>
                        <td class="font-monospace small">@(m.Car?.Vin ?? "—")</td>
                        <td>@(m.DriverName ?? m.Customer?.Name ?? "—")</td>
                        <td class="text-center">@(m.DriverPhone ?? m.Customer?.Phone ?? "—")</td>
                        <td class="small">@(m.Note ?? "—")</td>
                    </tr>
                }
                @if (Model.Members.Count(m => m.IsActive) == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center fst-italic py-3">Chưa đăng ký danh sách xe vào biên chế đoàn</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Cam kết -->
        <div class="mt-3" style="font-size:12.5px">
            <strong>Cam kết chung:</strong> Bên A cam kết toàn bộ xe trong danh sách trên sử dụng dịch vụ bảo dưỡng, sửa chữa chính hãng tại xưởng của Bên B theo đúng quy chuẩn nhà máy Hyundai. Bên B cam kết ưu tiên tiếp nhận khoang sửa chữa, cung cấp 100% phụ tùng chính phẩm và bảo hành chất lượng dịch vụ theo chính sách hiện hành.
        </div>

        <!-- Signatures -->
        <div class="row text-center mt-4">
            <div class="col-6">
                <strong>ĐẠI DIỆN KHÁCH ĐOÀN (BÊN A)</strong>
                <div class="fst-italic small text-muted">(Ký, ghi rõ họ tên và đóng dấu)</div>
                <div class="sign-box"></div>
                <div class="fw-bold">@(Model.ContactPerson ?? "........................................")</div>
            </div>
            <div class="col-6">
                <strong>ĐẠI DIỆN XƯỞNG DỊCH VỤ HYUNDAI (BÊN B)</strong>
                <div class="fst-italic small text-muted">(Ký, ghi rõ họ tên và đóng dấu)</div>
                <div class="sign-box"></div>
                <div class="fw-bold">GIÁM ĐỐC DỊCH VỤ</div>
            </div>
        </div>
    </div>
</body>
</html>
