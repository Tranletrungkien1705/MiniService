@model List<Bom>
@{
    ViewData["Title"] = "Định mức vật tư tối thiểu (BOM)";
    var summary = ViewBag.Summary as BomSummaryDto ?? new BomSummaryDto();
}

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Tổng số BOM</div>
                <div class="stat-num text-primary">@summary.TotalBoms</div>
                <div class="text-muted" style="font-size:11.5px">Bộ định mức vật tư tối thiểu</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Đang áp dụng</div>
                <div class="stat-num text-success">@summary.ActiveBoms</div>
                <div class="text-muted" style="font-size:11.5px">BOM có hiệu lực hoạt động</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Tổng dòng phụ tùng</div>
                <div class="stat-num text-info">@summary.TotalLines</div>
                <div class="text-muted" style="font-size:11.5px">Số dòng chi tiết trên mọi BOM</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Phụ tùng khác nhau</div>
                <div class="stat-num" style="color:#0f766e">@summary.DistinctParts</div>
                <div class="text-muted" style="font-size:11.5px">Mã phụ tùng xuất hiện trong BOM</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <form method="get" class="d-flex align-items-center gap-2 flex-wrap">
                <div class="input-group input-group-sm" style="max-width:300px">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Mã BOM, diễn giải, ghi chú..." />
                </div>
                <select name="isActive" class="form-select form-select-sm" style="width:150px" onchange="this.form.submit()">
                    <option value="">-- Trạng thái --</option>
                    <option value="true" selected="@(ViewBag.IsActive == true)">Đang áp dụng</option>
                    <option value="false" selected="@(ViewBag.IsActive == false)">Tạm dừng</option>
                </select>
                <button type="submit" class="btn btn-sm btn-outline-secondary">Lọc</button>
                @if (!string.IsNullOrEmpty(ViewBag.Q as string) || ViewBag.IsActive != null)
                {
                    <a href="/Bom" class="btn btn-sm btn-link text-decoration-none">Xóa lọc</a>
                }
            </form>
            <div class="d-flex align-items-center gap-2">
                <a href="/Part" class="btn btn-sm btn-outline-secondary"><i class="bi bi-box-seam me-1"></i>Danh mục phụ tùng</a>
                <a href="/Bom/Create" class="btn btn-sm btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>Thêm định mức BOM
                </a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:160px">Mã BOM</th>
                        <th>Diễn giải</th>
                        <th class="text-center" style="width:110px">Số dòng</th>
                        <th class="text-center" style="width:120px">Tổng SL tối thiểu</th>
                        <th class="text-center" style="width:110px">Trạng thái</th>
                        <th class="text-end" style="width:120px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block mb-1 text-secondary"></i>
                                Không tìm thấy định mức BOM nào phù hợp điều kiện lọc.
                            </td>
                        </tr>
                    }
                    @foreach (var b in Model)
                    {
                        var activeInfo = Ui.BomActive(b.IsActive);
                        <tr>
                            <td>
                                <a asp-action="Detail" asp-route-id="@b.Id" class="fw-bold font-monospace text-decoration-none">
                                    @b.BomCode
                                </a>
                            </td>
                            <td>
                                <div class="fw-semibold">
                                    <a asp-action="Detail" asp-route-id="@b.Id" class="text-dark text-decoration-none">
                                        @b.BomDesc
                                    </a>
                                </div>
                                @if (!string.IsNullOrEmpty(b.Remark))
                                {
                                    <div class="text-muted small">@b.Remark</div>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">@b.Lines.Count</span>
                            </td>
                            <td class="text-center font-monospace">@b.Lines.Sum(l => l.QtyMin).ToString("N0")</td>
                            <td class="text-center">
                                <span class="badge bg-@activeInfo.css">@activeInfo.text</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Detail" asp-route-id="@b.Id" class="btn btn-outline-secondary" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
