@model Bom
@{
    ViewData["Title"] = $"Chi tiết định mức BOM [{Model.BomCode}]";
    var activeInfo = Ui.BomActive(Model.IsActive);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a href="/Bom" class="text-decoration-none small text-muted"><i class="bi bi-arrow-left me-1"></i>Danh mục BOM</a>
        <h5 class="mb-0 fw-bold mt-1">
            <span class="font-monospace text-primary">@Model.BomCode</span> - @Model.BomDesc
            <span class="badge bg-@activeInfo.css ms-2">@activeInfo.text</span>
        </h5>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editBomModal">
            <i class="bi bi-pencil me-1"></i>Chỉnh sửa
        </button>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa định mức BOM này?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>Xóa</button>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-info-circle me-1 text-primary"></i>Thông tin BOM</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted small">Mã BOM (BOMCode)</dt>
                    <dd class="col-sm-7 font-monospace fw-bold">@Model.BomCode</dd>

                    <dt class="col-sm-5 text-muted small">Diễn giải (BOMDesc)</dt>
                    <dd class="col-sm-7">@Model.BomDesc</dd>

                    <dt class="col-sm-5 text-muted small">Ghi chú (Remark)</dt>
                    <dd class="col-sm-7">@(string.IsNullOrEmpty(Model.Remark) ? "-" : Model.Remark)</dd>

                    <dt class="col-sm-5 text-muted small">Số dòng phụ tùng</dt>
                    <dd class="col-sm-7"><span class="badge bg-light text-dark border">@Model.Lines.Count</span></dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-clock-history me-1 text-secondary"></i>Lịch sử &amp; Trạng thái</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted small">Trạng thái</dt>
                    <dd class="col-sm-7"><span class="badge bg-@activeInfo.css">@activeInfo.text</span></dd>

                    <dt class="col-sm-5 text-muted small">Người tạo (LogLUBy)</dt>
                    <dd class="col-sm-7">@Model.CreatedBy</dd>

                    <dt class="col-sm-5 text-muted small">Ngày tạo</dt>
                    <dd class="col-sm-7">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-5 text-muted small">Người cập nhật cuối (LogLUBy)</dt>
                    <dd class="col-sm-7">@(string.IsNullOrEmpty(Model.LogLUBy) ? "-" : Model.LogLUBy)</dd>

                    <dt class="col-sm-5 text-muted small">Cập nhật cuối (LogLUDateTime)</dt>
                    <dd class="col-sm-7">@(Model.LogLUDateTime?.ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white fw-semibold"><i class="bi bi-box-seam me-1 text-primary"></i>Danh sách phụ tùng trong định mức</div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:60px">#</th>
                        <th style="width:180px">Mã phụ tùng</th>
                        <th>Tên phụ tùng</th>
                        <th style="width:120px">Đơn vị</th>
                        <th class="text-end" style="width:140px">SL tối thiểu</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Lines.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Chưa có dòng phụ tùng nào.</td>
                        </tr>
                    }
                    @{ var idx = 0; }
                    @foreach (var l in Model.Lines)
                    {
                        idx++;
                        <tr>
                            <td class="text-muted">@idx</td>
                            <td class="font-monospace fw-semibold">@l.PartCode</td>
                            <td>@l.PartName</td>
                            <td>@l.Unit</td>
                            <td class="text-end font-monospace">@l.QtyMin.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Chỉnh sửa BOM -->
<div class="modal fade" id="editBomModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="Update" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2 text-primary"></i>Chỉnh sửa định mức BOM @Model.BomCode</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Mã BOM (BOMCode)</label>
                            <input class="form-control font-monospace" value="@Model.BomCode" disabled />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-semibold">Diễn giải (BOMDesc) <span class="text-danger">*</span></label>
                            <input name="bomDesc" class="form-control" value="@Model.BomDesc" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Ghi chú (Remark)</label>
                            <textarea name="remark" class="form-control" rows="2">@Model.Remark</textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="isActive" value="true" id="chkActive" @(Model.IsActive ? "checked" : "") />
                                <label class="form-check-label fw-semibold" for="chkActive">Đang áp dụng (FlagActive)</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-semibold small"><i class="bi bi-box-seam me-1 text-primary"></i>Danh sách phụ tùng</span>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="addRow()"><i class="bi bi-plus-lg me-1"></i>Thêm dòng</button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="width:180px">Mã phụ tùng <span class="text-danger">*</span></th>
                                    <th>Tên phụ tùng</th>
                                    <th style="width:110px">Đơn vị</th>
                                    <th style="width:120px">SL tối thiểu</th>
                                    <th style="width:50px"></th>
                                </tr>
                            </thead>
                            <tbody id="lineBody">
                                @foreach (var l in Model.Lines)
                                {
                                    <tr>
                                        <td><input name="partCode" class="form-control form-control-sm font-monospace" value="@l.PartCode" /></td>
                                        <td><input name="partName" class="form-control form-control-sm" value="@l.PartName" /></td>
                                        <td><input name="unit" class="form-control form-control-sm" value="@l.Unit" /></td>
                                        <td><input name="qtyMin" type="number" min="0" step="0.01" class="form-control form-control-sm font-monospace" value="@l.QtyMin" /></td>
                                        <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()"><i class="bi bi-x-lg"></i></button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function addRow() {
        const tbody = document.getElementById('lineBody');
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td><input name="partCode" class="form-control form-control-sm font-monospace" placeholder="VD: 26300-35505" /></td>
            <td><input name="partName" class="form-control form-control-sm" placeholder="Tên phụ tùng" /></td>
            <td><input name="unit" class="form-control form-control-sm" value="Cái" /></td>
            <td><input name="qtyMin" type="number" min="0" step="0.01" class="form-control form-control-sm font-monospace" value="1" /></td>
            <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()"><i class="bi bi-x-lg"></i></button></td>`;
        tbody.appendChild(tr);
    }
</script>
}
