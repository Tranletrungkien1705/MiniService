@model VinModelOrigin
@{
    ViewData["Title"] = $"Chi tiết nguồn gốc model xe [{Model.Id}] {Model.VINCode}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a href="/VinModelOrigin" class="text-decoration-none small text-muted"><i class="bi bi-arrow-left me-1"></i>Danh mục nguồn gốc model xe</a>
        <h5 class="mb-0 fw-bold mt-1">
            <span class="font-monospace text-primary">#@Model.Id</span> - @Model.VINCode
        </h5>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editModal">
            <i class="bi bi-pencil me-1"></i>Chỉnh sửa
        </button>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa dòng nguồn gốc này?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>Xóa</button>
        </form>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-info-circle me-1 text-primary"></i>Thông tin nguồn gốc model xe</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted small">ID</dt>
                    <dd class="col-sm-7 font-monospace fw-bold">@Model.Id</dd>

                    <dt class="col-sm-5 text-muted small">Mã số khung (VINCode)</dt>
                    <dd class="col-sm-7 font-monospace fw-semibold">@Model.VINCode</dd>

                    <dt class="col-sm-5 text-muted small">Mã dòng xe (ModelCode)</dt>
                    <dd class="col-sm-7 font-monospace">@Model.ModelCode</dd>

                    <dt class="col-sm-5 text-muted small">Mã nguồn gốc (OrginalCode)</dt>
                    <dd class="col-sm-7 font-monospace">@Model.OrginalCode</dd>

                    <dt class="col-sm-5 text-muted small">Ghi chú (Remark)</dt>
                    <dd class="col-sm-7">@(string.IsNullOrEmpty(Model.Remark) ? "—" : Model.Remark)</dd>

                    <dt class="col-sm-5 text-muted small">Trạng thái (FlagActive)</dt>
                    <dd class="col-sm-7">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle">Hoạt động</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary border">Tạm dừng</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-clock-history me-1 text-secondary"></i>Lịch sử cập nhật</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted small">Người tạo (CreatedBy)</dt>
                    <dd class="col-sm-7">@Model.CreatedBy</dd>

                    <dt class="col-sm-5 text-muted small">Ngày tạo (CreatedDate)</dt>
                    <dd class="col-sm-7">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-5 text-muted small">Người cập nhật cuối (LogLUBy)</dt>
                    <dd class="col-sm-7">@(string.IsNullOrEmpty(Model.LogLUBy) ? "-" : Model.LogLUBy)</dd>

                    <dt class="col-sm-5 text-muted small">Cập nhật cuối (LogLUDateTime)</dt>
                    <dd class="col-sm-7">@(Model.LogLUDateTime?.ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chỉnh sửa -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Update" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2 text-primary"></i>Chỉnh sửa nguồn gốc model xe #@Model.Id</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Mã số khung (VINCode) <span class="text-danger">*</span></label>
                            <input name="vinCode" class="form-control font-monospace" value="@Model.VINCode" required maxlength="5" style="text-transform:uppercase" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Mã dòng xe (ModelCode) <span class="text-danger">*</span></label>
                            <input name="modelCode" class="form-control font-monospace" value="@Model.ModelCode" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Mã nguồn gốc (OrginalCode) <span class="text-danger">*</span></label>
                            <input name="orginalCode" class="form-control font-monospace" value="@Model.OrginalCode" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Ghi chú (Remark)</label>
                            <input name="remark" class="form-control" value="@Model.Remark" />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="isActive" value="true" id="isActiveSwitch" checked="@Model.IsActive" />
                                <label class="form-check-label small" for="isActiveSwitch">Đang hoạt động (FlagActive)</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>