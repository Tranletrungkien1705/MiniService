@model List<OrderComplain>
@{
    ViewData["Title"] = "Quản lý Khiếu nại Phụ tùng NCC TST / HTC (Order Complain)";
    var curDmsStatus = (DMSOrderComplainStatus?)ViewBag.DMSStatus;
    var curTstStatus = (TSTOrderComplainStatus?)ViewBag.TSTStatus;
    var curType = (OrderComplainType?)ViewBag.Type;
    var totalCount = Model.Count;
    var pendingCount = Model.Count(c => c.DMSStatus == DMSOrderComplainStatus.Pending);
    var sentCount = Model.Count(c => c.DMSStatus == DMSOrderComplainStatus.Sent);
    var approvedCount = Model.Count(c => c.TSTStatus == TSTOrderComplainStatus.Approved);
    var rejectedCount = Model.Count(c => c.TSTStatus == TSTOrderComplainStatus.Rejected);
}

<div class="row g-3 mb-3">
    <div class="col-6 col-lg">
        <div class="card"><div class="card-body">
            <div class="text-muted small">Tổng số khiếu nại</div>
            <div class="stat-num text-primary">@totalCount</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card"><div class="card-body">
            <div class="text-muted small">Mới tạo (Chờ gửi)</div>
            <div class="stat-num text-warning">@pendingCount</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card"><div class="card-body">
            <div class="text-muted small">Đã gửi TST thẩm định</div>
            <div class="stat-num text-info">@sentCount</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card"><div class="card-body">
            <div class="text-muted small">Chấp thuận bồi thường</div>
            <div class="stat-num text-success">@approvedCount</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card"><div class="card-body">
            <div class="text-muted small">Từ chối bồi thường</div>
            <div class="stat-num text-danger">@rejectedCount</div>
        </div></div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <form method="get" class="d-flex gap-2 flex-wrap">
                <input name="q" value="@ViewBag.Q" class="form-control form-control-sm" placeholder="Mã khiếu nại / Phụ tùng / PO / VIN..." style="max-width:240px" />
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control form-control-sm" title="Từ ngày" style="max-width:140px" />
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control form-control-sm" title="Đến ngày" style="max-width:140px" />
                <select name="type" class="form-select form-select-sm" onchange="this.form.submit()" style="max-width:180px">
                    <option value="">— Tất cả loại khiếu nại —</option>
                    @foreach (OrderComplainType t in Enum.GetValues(typeof(OrderComplainType)))
                    {
                        var (tName, _, _) = Ui.OrderComplainType(t);
                        <option value="@((int)t)" selected="@(curType == t)">@tName</option>
                    }
                </select>
                <select name="dmsStatus" class="form-select form-select-sm" onchange="this.form.submit()" style="max-width:170px">
                    <option value="">— Trạng thái DMS —</option>
                    @foreach (DMSOrderComplainStatus s in Enum.GetValues(typeof(DMSOrderComplainStatus)))
                    {
                        var (stName, stCode, _) = Ui.DMSOrderComplainStatus(s);
                        <option value="@((int)s)" selected="@(curDmsStatus == s)">[@stCode] @stName</option>
                    }
                </select>
                <select name="tstStatus" class="form-select form-select-sm" onchange="this.form.submit()" style="max-width:170px">
                    <option value="">— Thẩm định TST —</option>
                    @foreach (TSTOrderComplainStatus s in Enum.GetValues(typeof(TSTOrderComplainStatus)))
                    {
                        var (stName, stCode, _) = Ui.TSTOrderComplainStatus(s);
                        <option value="@((int)s)" selected="@(curTstStatus == s)">[@stCode] @stName</option>
                    }
                </select>
                <button class="btn btn-sm btn-primary">Lọc</button>
                @if (curDmsStatus.HasValue || curTstStatus.HasValue || curType.HasValue || !string.IsNullOrEmpty(ViewBag.Q) || !string.IsNullOrEmpty(ViewBag.FromDate) || !string.IsNullOrEmpty(ViewBag.ToDate))
                {
                    <a href="/OrderComplain" class="btn btn-sm btn-outline-secondary">Xóa lọc</a>
                }
            </form>
            <div class="d-flex gap-2">
                <a href="/OrderPart" class="btn btn-sm btn-outline-secondary"><i class="bi bi-cart-check me-1"></i>Đơn đặt hàng phụ tùng</a>
                <a href="/OrderComplain/Create" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1"></i>Lập khiếu nại mới</a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Số khiếu nại</th>
                        <th>Ngày lập</th>
                        <th>Đơn hàng (PO)</th>
                        <th>Phụ tùng khiếu nại</th>
                        <th class="text-center">Số lượng</th>
                        <th>Phân loại &amp; Tình trạng hư hỏng</th>
                        <th>Trạng thái DMS</th>
                        <th>Thẩm định TST</th>
                        <th>Phương án giải quyết</th>
                        <th class="text-center">Ảnh</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>Chưa có hồ sơ khiếu nại phụ tùng nào phù hợp.
                            </td>
                        </tr>
                    }
                    @foreach (var c in Model)
                    {
                        var (typeName, typeIcon, typeCss) = Ui.OrderComplainType(c.ComplainType);
                        var (dmsName, dmsCode, dmsCss) = Ui.DMSOrderComplainStatus(c.DMSStatus);
                        var (tstName, tstCode, tstCss) = Ui.TSTOrderComplainStatus(c.TSTStatus);
                        <tr>
                            <td>
                                <a href="/OrderComplain/Detail/@c.Id" class="fw-bold text-decoration-none">@c.OrderComplainNo</a>
                                @if (!string.IsNullOrWhiteSpace(c.VIN))
                                {
                                    <div class="small text-muted" title="Số khung xe liên quan"><i class="bi bi-car-front me-1"></i>@c.VIN</div>
                                }
                            </td>
                            <td>
                                <div>@c.CreatedAt.ToString("dd/MM/yyyy")</div>
                                <div class="small text-muted">@c.CreatedAt.ToString("HH:mm")</div>
                            </td>
                            <td>
                                @if (c.OrderPartId.HasValue && !string.IsNullOrWhiteSpace(c.OrderPartNo))
                                {
                                    <a href="/OrderPart/Detail/@c.OrderPartId" class="text-decoration-none badge bg-light text-dark border">
                                        <i class="bi bi-receipt me-1"></i>@c.OrderPartNo
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(c.RequestOrderNo))
                                {
                                    <div class="small text-muted" title="Phiếu giao hàng DO">DO: @c.RequestOrderNo</div>
                                }
                            </td>
                            <td>
                                <div class="fw-bold">@c.PartName</div>
                                <div class="small text-muted"><code>@c.PartCode</code></div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-secondary">@c.Quantity.ToString("G29") @c.Unit</span>
                                <div class="small text-muted">@c.Amount.ToString("N0") đ</div>
                            </td>
                            <td>
                                <div><span class="badge bg-@typeCss"><i class="bi @typeIcon me-1"></i>@typeName</span></div>
                                <div class="small text-secondary text-truncate" style="max-width:220px;" title="@c.Description">@c.Description</div>
                            </td>
                            <td>
                                <span class="badge bg-@dmsCss">@dmsCode · @dmsName</span>
                            </td>
                            <td>
                                <span class="badge bg-@tstCss">@tstCode · @tstName</span>
                            </td>
                            <td>
                                @if (c.TSTSolution.HasValue)
                                {
                                    var (solText, solCss) = Ui.ComplainSolution(c.TSTSolution.Value);
                                    <span class="badge bg-@solCss">@solText</span>
                                    @if (!string.IsNullOrWhiteSpace(c.SolutionNote))
                                    {
                                        <div class="small text-muted text-truncate" style="max-width:180px;" title="@c.SolutionNote">@c.SolutionNote</div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Chờ phương án</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (c.AttachCount > 0)
                                {
                                    <span class="badge rounded-pill bg-light text-dark border" title="@c.AttachCount ảnh/chứng từ đính kèm">
                                        <i class="bi bi-paperclip me-1 text-primary"></i>@c.AttachCount
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a href="/OrderComplain/Detail/@c.Id" class="btn btn-sm btn-outline-primary" title="Xem chi tiết hồ sơ"><i class="bi bi-eye"></i></a>
                                <a href="/OrderComplain/Print/@c.Id" target="_blank" class="btn btn-sm btn-outline-secondary" title="In biên bản khiếu nại"><i class="bi bi-printer"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
