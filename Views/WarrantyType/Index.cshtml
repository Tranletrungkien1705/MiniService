@model List<WarrantyType>
@{
    ViewData["Title"] = "Danh mục Loại bảo hành RO (Ser_MST_ROWarrantyType)";
    var summary = ViewBag.Summary as WarrantyTypeSummaryDto ?? new WarrantyTypeSummaryDto();
    WarrantyTypeCode? curTypeCode = ViewBag.TypeCode;
    bool? curActive = ViewBag.FlagActive;
    string? curQ = ViewBag.Q;
}

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Tổng loại bảo hành</div>
                <div class="stat-num text-primary">@summary.TotalTypes <span class="fs-6 fw-normal text-muted">loại</span></div>
                <div class="text-muted" style="font-size:11.5px">Đang áp dụng: <strong class="text-success">@summary.ActiveTypes</strong> · Ngưng: <strong class="text-secondary">@summary.InactiveTypes</strong></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Loại ảnh chứng minh bắt buộc</div>
                <div class="stat-num text-info">@summary.TotalPhotoTypes <span class="fs-6 fw-normal text-muted">loại ảnh</span></div>
                <div class="text-muted" style="font-size:11.5px">@summary.TypesWithPhotos loại BH có yêu cầu ảnh</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Loại chính (ROWTypeCode)</div>
                <div class="stat-num text-danger">@summary.DistinctMainCodes <span class="fs-6 fw-normal text-muted">nhóm</span></div>
                <div class="text-muted" style="font-size:11.5px">XM · SB · PT · TC · BT</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Loại chi tiết (ROWTypeDtlCode)</div>
                <div class="stat-num text-success">@summary.DistinctDetailCodes <span class="fs-6 fw-normal text-muted">mã</span></div>
                <div class="text-muted" style="font-size:11.5px">A · B · P · W · S · R · C</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-3">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="q" value="@curQ" class="form-control" placeholder="Tên loại bảo hành, loại ảnh..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="typeCode" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Tất cả loại chính --</option>
                    <option value="@((int)WarrantyTypeCode.XM)" selected="@(curTypeCode == WarrantyTypeCode.XM)">XM — Xe mới</option>
                    <option value="@((int)WarrantyTypeCode.SB)" selected="@(curTypeCode == WarrantyTypeCode.SB)">SB — Sửa chữa BH</option>
                    <option value="@((int)WarrantyTypeCode.PT)" selected="@(curTypeCode == WarrantyTypeCode.PT)">PT — Phụ tùng BH</option>
                    <option value="@((int)WarrantyTypeCode.TC)" selected="@(curTypeCode == WarrantyTypeCode.TC)">TC — Thiện chí</option>
                    <option value="@((int)WarrantyTypeCode.BT)" selected="@(curTypeCode == WarrantyTypeCode.BT)">BT — Bổ sung</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="flagActive" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Trạng thái --</option>
                    <option value="true" selected="@(curActive == true)">Đang áp dụng</option>
                    <option value="false" selected="@(curActive == false)">Ngừng áp dụng</option>
                </select>
            </div>
            <div class="col-md-3 text-end">
                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i> Lọc</button>
                <a href="/WarrantyType" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
                <a href="/WarrantyType/Print@(curTypeCode.HasValue ? $"?typeCode={curTypeCode}" : "")" target="_blank" class="btn btn-sm btn-outline-info"><i class="bi bi-printer me-1"></i> In</a>
                <a href="/WarrantyType/Create" class="btn btn-sm btn-success"><i class="bi bi-plus-lg me-1"></i> Thêm loại</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:90px">Loại chính</th>
                    <th style="width:180px">Tên loại chính</th>
                    <th style="width:90px" class="text-center">Chi tiết</th>
                    <th>Tên loại chi tiết</th>
                    <th>Loại ảnh chứng minh bắt buộc</th>
                    <th style="width:90px" class="text-center">Số ảnh</th>
                    <th style="width:100px" class="text-center">Hiệu lực</th>
                    <th style="width:110px" class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-1"></i>
                            Không có loại bảo hành nào phù hợp bộ lọc.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr class="@(!item.FlagActive ? "text-muted bg-light" : "")">
                        <td><span class="badge bg-dark font-monospace">@item.TypeCode</span></td>
                        <td class="fw-semibold">@item.TypeName</td>
                        <td class="text-center"><span class="badge bg-secondary font-monospace">@item.DetailCode</span></td>
                        <td>@item.DetailName</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.PhotoTypeDisplay))
                            {
                                <span class="text-muted small"><i class="bi bi-images text-info me-1"></i>@item.PhotoTypeDisplay</span>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td class="text-center"><span class="badge bg-light text-dark border">@item.PhotoCount</span></td>
                        <td class="text-center">
                            @if (item.FlagActive)
                            {
                                <span class="badge bg-success">Áp dụng</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Tạm ngưng</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a href="/WarrantyType/Detail/@item.Id" class="btn btn-outline-primary" title="Chi tiết"><i class="bi bi-eye"></i></a>
                                <a href="/WarrantyType/Edit/@item.Id" class="btn btn-outline-secondary" title="Sửa"><i class="bi bi-pencil"></i></a>
                                <form method="post" action="/WarrantyType/ToggleActive/@item.Id" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-warning" title="@(item.FlagActive ? "Tạm ngưng" : "Kích hoạt")">
                                        <i class="bi @(item.FlagActive ? "bi-pause" : "bi-play")"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
